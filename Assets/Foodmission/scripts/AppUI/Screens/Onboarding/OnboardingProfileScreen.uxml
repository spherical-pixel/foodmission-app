<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:fm="eu.foodmission.platform.Components" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <ui:VisualElement name="root" data-source-type="eu.foodmission.platform.OnboardingProfileViewModel, Foodmission" class="fm-root">
        <ui:VisualElement name="form-container" class="box-background" style="flex-shrink: 0;">
            <appui:Heading text="Completa tu perfil" size="M" style="-unity-text-align: middle-center; -unity-font-style: bold;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(40270509588340736)"/>
                </Bindings>
            </appui:Heading>
            <appui:Text text="Esta información nos ayuda a personalizar tu experiencia" style="-unity-text-align: middle-center; margin-bottom: 16px; color: rgba(0, 0, 0, 0.6); white-space: normal;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(40270634402439168)"/>
                </Bindings>
            </appui:Text>
            <fm:FormFieldItemDropDownField name="gender-dropdown" dropdown-defaultmessage="Selecciona">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(40270284408741888)"/>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000042)"/>
                </Bindings>
            </fm:FormFieldItemDropDownField>
            <fm:FormFieldItemDropDownField name="activity-level-dropdown" dropdown-defaultmessage="Selecciona" Heading-Text="Nivel de actividad">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000041)"/>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000042)"/>
                </Bindings>
            </fm:FormFieldItemDropDownField>
            <fm:FormFieldItemDropDownField name="dietary-preferences-dropdown" dropdown-defaultmessage="Selecciona" Heading-Text="Preferencias dieteticas" dropdown-selectiontype="Multiple" dropdown-closeonselect="false">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000043)"/>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000042)"/>
                </Bindings>
            </fm:FormFieldItemDropDownField>
            <fm:FormFieldItemDropDownField name="shopping-responsibility-dropdown" dropdown-defaultmessage="Selecciona" Heading-Text="Responsabilidades compra">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000044)"/>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000042)"/>
                </Bindings>
            </fm:FormFieldItemDropDownField>
            <fm:FormFieldItemDropDownField name="education-level-dropdown" dropdown-defaultmessage="Selecciona" Heading-Text="Nivel de educacion">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000045)"/>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000042)"/>
                </Bindings>
            </fm:FormFieldItemDropDownField>
            <fm:FormFieldItemDropDownField name="annual-income-dropdown" dropdown-defaultmessage="Selecciona" Heading-Text="Ingresos anuales">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000046)"/>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000042)"/>
                </Bindings>
            </fm:FormFieldItemDropDownField>
            <appui:Spacer spacing="XL"/>
            <ui:VisualElement class="auth-actions">
                <appui:Button name="submit-button" text="Continuar" variant="Accent" trailing-icon="fm-arrow-right" title="Aceptar" class="auth-button fm-button fm-button-align-left">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25395779614007296)"/>
                    </Bindings>
                </appui:Button>
                <appui:Spacer spacing="XL"/>
                <appui:Button name="skip-button" text="Continuar" variant="Default" trailing-icon="fm-arrow-right" title="Skip" class="auth-button fm-button fm-button-align-left">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000047)"/>
                    </Bindings>
                </appui:Button>
            </ui:VisualElement>
            <appui:Spacer spacing="XL"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
