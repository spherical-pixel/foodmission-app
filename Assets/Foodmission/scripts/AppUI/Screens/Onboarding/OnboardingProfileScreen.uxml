<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:fm="eu.foodmission.platform.Components" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <ui:VisualElement name="root" data-source-type="eu.foodmission.platform.OnboardingProfileViewModel, Foodmission" class="login-root appui appui--en appui--medium appui--light appui--ltr" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0);">
        <ui:ScrollView name="scroll-view" style="flex-grow: 1;">
            <ui:VisualElement name="form-container" style="background-color: rgba(255, 255, 255, 0.26); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-left-radius: 15px; border-bottom-right-radius: 15px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; margin-left: 24px; margin-right: 24px; padding-top: 24px; padding-left: 24px; padding-right: 24px; padding-bottom: 24px; margin-top: 40px; margin-bottom: 40px; flex-shrink: 0;">
                <appui:Heading text="Completa tu perfil" size="M" style="-unity-text-align: middle-center; -unity-font-style: bold;"/>
                <appui:Text text="Esta informaci&#243;n nos ayuda a personalizar tu experiencia" style="-unity-text-align: middle-center; margin-bottom: 16px; color: rgba(0, 0, 0, 0.6); white-space: normal;"/>

                <fm:FormFieldItemDropDownField name="gender-dropdown" dropdown-defaultmessage="Selecciona">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(18417602513592320)"/>
                    </Bindings>
                </fm:FormFieldItemDropDownField>

                <fm:FormFieldItemDropDownField name="activity-level-dropdown" dropdown-defaultmessage="Selecciona">
                </fm:FormFieldItemDropDownField>

                <ui:VisualElement name="dietary-preferences-container" style="margin-top: 8px; margin-bottom: 8px;">
                    <appui:Heading text="Preferencias diet&#233;ticas" size="XS" style="margin-bottom: 4px;"/>
                </ui:VisualElement>

                <fm:FormFieldItemDropDownField name="shopping-responsibility-dropdown" dropdown-defaultmessage="Selecciona">
                </fm:FormFieldItemDropDownField>

                <fm:FormFieldItemDropDownField name="education-level-dropdown" dropdown-defaultmessage="Selecciona">
                </fm:FormFieldItemDropDownField>

                <fm:FormFieldItemDropDownField name="annual-income-dropdown" dropdown-defaultmessage="Selecciona">
                </fm:FormFieldItemDropDownField>

                <appui:Spacer spacing="XL"/>

                <ui:VisualElement class="auth-actions">
                    <appui:Button name="submit-button" text="Continuar" variant="Accent" trailing-icon="fm-arrow-right" class="auth-button fm-button fm-button-align-left"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>