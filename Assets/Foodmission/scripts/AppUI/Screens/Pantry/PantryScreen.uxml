<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform.Components" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Pantry/PantryScreen.uss?fileID=7433441132597879392&amp;guid=abaccea1e09c4989b8f5630ef0501136&amp;type=3#PantryScreen"/>
    <ui:VisualElement name="back" data-source-type="eu.foodmission.platform.ShoppingListViewModel, Foodmission" class="fm-back-screen-transparent" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0;"/>
    <ui:VisualElement name="root" class="fm-root">
        <ui:VisualElement name="header" class="fm-p-header">
            <appui:Heading name="screen-title" size="L" text="Pantry">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(39910325154209792)"/>
                </Bindings>
            </appui:Heading>
        </ui:VisualElement>
        <appui:Text name="error-message" class="fm-p-error"/>
        <eu:FMSearchOrCategoryField name="search-category-field">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Placeholder" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(26308484147437568)"/>
            </Bindings>
        </eu:FMSearchOrCategoryField>
        <ui:VisualElement name="expired-banner" class="fm-p-expired-banner">
            <appui:Text name="expired-banner-text" class="fm-p-expired-banner-text"/>
            <appui:Button name="btn-move-to-waste" title="Move to waste" variant="Destructive" class="fm-p-expired-btn">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000022)"/>
                </Bindings>
            </appui:Button>
        </ui:VisualElement>
        <appui:Text name="empty-state" text="Your pantry is empty. Tap + to add items." class="fm-p-empty">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000023)"/>
            </Bindings>
        </appui:Text>
        <ui:VisualElement name="main-content" style="flex-grow: 1; margin-top: 24px;">
            <ui:ScrollView name="scroll-view" class="fm-p-scroll">
                <ui:VisualElement name="items-container" class="fm-p-container"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
