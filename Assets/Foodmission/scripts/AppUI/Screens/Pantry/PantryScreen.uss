.fm-p-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px;
}

.fm-p-header {
    margin-bottom: 16px;
}

.fm-p-spinner {
    align-self: center;
    margin-top: 32px;
    display: none;
}

.fm-p-spinner.visible {
    display: flex;
}

.fm-p-error {
    color: var(--appui-color-danger-500);
    align-self: center;
    margin-top: 16px;
    display: none;
}

.fm-p-error.visible {
    display: flex;
}

.fm-p-scroll {
    flex-grow: 1;
    margin-bottom: 8px;
}

.fm-p-container {
    flex-direction: column;
}

.fm-p-item-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.2);
}

.fm-p-item-info {
    flex-grow: 1;
    flex-direction: column;
    margin-left: 8px;
}

.fm-p-item-name {
    font-size: var(--appui-font-sizes-body-md);
}

.fm-p-item-detail {
    font-size: var(--appui-font-sizes-body-sm);
    opacity: 0.7;
    margin-top: 2px;
}

.fm-p-item-expiry {
    font-size: var(--appui-font-sizes-body-sm);
    -unity-font-definition: var(--appui-font-weights-200);
    padding: 4px 10px;
    border-radius: 12px;
    border-width: 1px;
    margin-right: 8px;
    white-space: nowrap;
    align-self: center;
}

/* Light Mode Defaults */
.fm-p-item-expiry--expired {
    background-color: #fee2e2;
    color: #991b1b;
    border-color: #fca5a5;
}

.fm-p-item-expiry--soon {
    background-color: #fef3c7;
    color: #92400e;
    border-color: #fcd34d;
}

.fm-p-item-expiry--ok {
    background-color: #dcfce7;
    color: #166534;
    border-color: #86efac;
}

/* Dark Mode Overrides */
.appui--dark .fm-p-item-expiry--expired {
    background-color: rgba(239, 68, 68, 0.25);
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.4);
}

.appui--dark .fm-p-item-expiry--soon {
    background-color: rgba(245, 158, 11, 0.25);
    color: #fcd34d;
    border-color: rgba(245, 158, 11, 0.4);
}

.appui--dark .fm-p-item-expiry--ok {
    background-color: rgba(34, 197, 94, 0.25);
    color: #86efac;
    border-color: rgba(34, 197, 94, 0.4);
}

.fm-p-section-header {
    font-size: var(--appui-font-sizes-body-sm);
    -unity-font-definition: var(--appui-font-weights-200);
    text-transform: uppercase;
    opacity: 0.6;
    padding: 8px 12px 4px;
    margin-top: 12px;
    margin-bottom: 4px;
}

.fm-p-expired-banner {
    flex-direction: row;
    align-items: center;
    background-color: var(--appui-color-danger-100);
    border-radius: 8px;
    padding: 12px;
    margin: 8px 0;
    display: none;
}

.fm-p-expired-banner.visible {
    display: flex;
}

.fm-p-expired-banner-text {
    flex-grow: 1;
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-color-danger-700);
}

.fm-p-expired-btn {
    flex-shrink: 0;
}

.fm-p-empty {
    align-self: center;
    margin-top: 48px;
    opacity: 0.5;
    display: none;
}

.fm-p-empty.visible {
    display: flex;
}

