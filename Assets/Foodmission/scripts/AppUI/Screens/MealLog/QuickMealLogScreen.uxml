<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform.Components" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/MealLog/QuickMealLogScreen.uss?fileID=7433441132597879392&amp;guid=e4c1ce566894b4ca0a79d42deeffd5ff&amp;type=3#QuickMealLogScreen"/>
    <ui:VisualElement name="root" class="fm-root fm-quick-meal-root">
        <ui:VisualElement name="card" class="fm-quick-meal-card">
            <ui:VisualElement class="fm-quick-meal-header">
                <appui:Text text="⚡ RÁPIDO" size="S" class="fm-quick-meal-badge"/>
                <appui:Text text="Registro Rápido de Comida" size="XXL" class="fm-quick-meal-title"/>
                <appui:Text name="active-quest-hint" text="Completa tu misión activa respondiendo a estas preguntas clave." size="M" class="fm-quick-meal-subtitle"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-quick-meal-section">
                <appui:Text text="Tipo de comida" size="M" class="fm-quick-meal-section-title"/>
                <ui:VisualElement class="fm-quick-meal-types-row">
                    <ui:Button name="btn-type-breakfast" text="🌅 Desayuno" class="fm-quick-meal-type-btn"/>
                    <ui:Button name="btn-type-lunch" text="☀️ Almuerzo" class="fm-quick-meal-type-btn fm-quick-meal-type-btn--active"/>
                    <ui:Button name="btn-type-dinner" text="🌙 Cena" class="fm-quick-meal-type-btn"/>
                    <ui:Button name="btn-type-snack" text="🍿 Snack" class="fm-quick-meal-type-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="fm-quick-meal-section">
                <appui:Text text="¿Qué características tuvo tu plato?" size="M" class="fm-quick-meal-section-title"/>
                <ui:VisualElement name="questions-container" class="fm-quick-meal-questions-list"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-quick-meal-section">
                <appui:Text text="Nombre o descripción (opcional)" size="M" class="fm-quick-meal-section-title"/>
                <appui:TextField name="input-meal-name" placeholder="Ej: Ensalada de lentejas y verduras" class="fm-quick-meal-input"/>
            </ui:VisualElement>
            <appui:Text name="feedback-label" text="" size="M" class="fm-quick-meal-feedback" style="display: none;"/>
            <eu:FMButton name="btn-submit-quick-meal" title="Guardar Comida Rápida" variant="Accent" size="L" class="fm-quick-meal-submit-btn"/>
        </ui:VisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
