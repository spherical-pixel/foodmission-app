.fm-ml-root {
    flex-grow: 1;
    padding: 16px;
}
.fm-ml-header {
    margin-bottom: 12px;
}
.fm-ml-spinner {
    align-self: center;
    display: none;
}
.fm-ml-spinner.visible {
    display: flex;
}
.fm-ml-error {
    color: rgb(var(--fm-color-error));
    display: none;
    margin-bottom: 8px;
}
.fm-ml-error.visible {
    display: flex;
}
.fm-ml-empty {
    color: rgb(var(--fm-color-text-secondary));
    display: none;
    margin-top: 24px;
    text-align: center;
}
.fm-ml-empty.visible {
    display: flex;
}
.fm-ml-scroll {
    flex-grow: 1;
}
.fm-ml-container {
    flex-grow: 1;
}
.fm-ml-fab {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 48px;
    height: 48px;
    font-size: 24px;
}
.fm-ml-section-header {
    font-size: 14px;
    font-weight: bold;
    color: rgb(var(--fm-color-text-secondary));
    margin-top: 16px;
    margin-bottom: 4px;
    text-transform: uppercase;
}
.fm-ml-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgb(var(--fm-color-border));
}
.fm-ml-row:active {
    background-color: rgb(var(--fm-color-surface-pressed));
}
.fm-ml-row-info {
    flex-grow: 1;
}
.fm-ml-row-name {
    font-size: 16px;
}
.fm-ml-row-time {
    font-size: 12px;
    color: rgb(var(--fm-color-text-secondary));
}
.fm-ml-row-badge {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 8px;
}
.fm-ml-row-badge--pantry {
    background-color: rgb(var(--fm-color-info));
    color: white;
}
.fm-ml-row-badge--out {
    background-color: rgb(var(--fm-color-warning));
    color: white;
}
