/* Step visibility */
.fm-ml-step {
    display: none;
    flex-direction: column;
}

.fm-ml-step.visible {
    display: flex;
}

/* Step heading */
.fm-ml-step-heading {
    margin-bottom: 12px;
}

/* Step buttons container */
.fm-ml-step-buttons {
    flex-direction: column;
}

/* Back inline */
.fm-ml-back-inline {
    display: none;
    cursor: link;
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-color-primary-500);
    margin-bottom: 8px;
    padding: 4px 0;
}

.fm-ml-back-inline.visible {
    display: flex;
}

.fm-ml-back-inline:hover {
    opacity: 0.8;
}

/* Logged meals zone */
.fm-ml-logged-zone {
    display: none;
    flex-direction: column;
    margin-top: 24px;
}

.fm-ml-logged-zone.visible {
    display: flex;
}

.fm-ml-meals-list {
    flex-direction: column;
    margin-top: 12px;
}

/* Preset results */
.fm-ml-preset-results {
    flex-direction: column;
    margin-bottom: 8px;
}

.fm-ml-search-result-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 8px;
    border-radius: 4px;
    cursor: link;
}

.fm-ml-search-result-row:active {
    background-color: var(--appui-color-primary-100);
}

.fm-ml-search-result-name {
    font-size: var(--appui-font-sizes-body-md);
    flex: 1;
}

.fm-ml-search-result-badge {
    font-size: var(--appui-font-sizes-body-sm);
    padding: 2px 8px;
    border-radius: 4px;
    background-color: var(--appui-color-secondary-100);
    color: var(--appui-color-secondary-700);
    margin-left: 8px;
}

/* Selected items */
.fm-ml-selected-chips {
    flex-direction: column;
    margin: 8px 0;
    gap: 4px;
}

.fm-ml-selected-chips > * {
    margin: 2px 0;
}

/* Preset card accent border */
.fm-ml-chip-preset {
    border-color: var(--appui-color-accent);
    border-width: 1px;
}

/* Log button */
.fm-ml-log-btn {
    margin-top: 8px;
    align-self: flex-end;
}

/* Meal card badge */
.fm-ml-card-badge {
    font-size: var(--appui-font-sizes-body-sm);
    padding: 2px 8px;
    border-radius: 4px;
    margin-top: 8px;
    align-self: flex-start;
}

.fm-ml-card-badge--pantry {
    background-color: var(--appui-color-danger-100);
    color: var(--appui-color-danger-700);
}

.fm-ml-card-badge--out {
    background-color: var(--appui-color-warning-100);
    color: var(--appui-color-warning-700);
}


