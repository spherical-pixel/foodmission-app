/* Step visibility */
.fm-ml-step {
    display: none;
    flex-direction: column;
}

.fm-ml-step.visible {
    display: flex;
}

/* Step heading */
.fm-ml-step-heading {
    margin-bottom: 12px;
}

/* Step buttons container */
.fm-ml-step-buttons {
    flex-direction: column;
}

/* Back inline */
.fm-ml-back-inline {
    display: none;
    /*font-size: var(--appui-font-sizes-body-md);*/
    color: var(--appui-foregrounds-100);
    margin-bottom: 8px;
    padding: 0;
    min-height: auto;
    background-color: transparent;
    
}

.fm-ml-back-inline .appui-icon {
    --unity-image-tint-color: var(--appui-foregrounds-100);
}

.fm-ml-back-inline.visible {
    display: flex;
}

.fm-ml-back-inline:hover {
    opacity: 0.8;
}

/* Logged meals zone */
.fm-ml-logged-zone {
    display: none;
    flex-direction: column;
    margin-top: 24px;
}

.fm-ml-logged-zone.visible {
    display: flex;
}

.fm-ml-meals-list {
    flex-direction: column;
    margin-top: 12px;
}

/* Preset results */
.fm-ml-preset-results {
    flex-direction: column;
    margin-bottom: 8px;
}

/* Selected items */
.fm-ml-selected-chips {
    flex-direction: column;
    justify-content: flex-start;
    margin: 8px 0;
    min-height: 700px;
}

.fm-ml-selected-chips > * {
    margin: 2px 0;
    flex-grow: 0;
    flex-shrink: 0;
}

/* Preset card accent border */
.fm-ml-chip-preset {
    border-color: var(--appui-color-accent);
    border-width: 1px;
}

/* Log actions row */
.fm-ml-log-actions-row {
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    margin-top: 12px;
}

.fm-ml-save-preset-chk {
    align-self: flex-start;
}

/* Log button */
.fm-ml-log-btn {
    align-self: flex-start;
    margin-top: 12px;
    width: 100%;
}


/* Meal card badge */
.fm-ml-card-badge {
    /*color: var(--appui-base-100);*/
    font-size: var(--appui-font-sizes-body-md);
    padding: 2px 8px;
    border-radius: 4px;
    margin-top: 8px;
    align-self: flex-start;
}

.fm-ml-card-badge--pantry {
    background-color: var(--appui-destructive-25);
    color: var(--appui-destructive-300);
}

.fm-ml-card-badge--out {
    background-color: var(--appui-warning-25);
    color: var(--appui-warning-300);
}

/* Preset recipe badge */
.fm-ml-preset-badge {
    font-size: var(--appui-font-sizes-body-sm);
    -unity-font-style: bold;
    color: var(--appui-accent-800);
    background-color: var(--appui-accent-100);
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: center;
}



