.fm-ml-edit-banner {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--appui-primary-25);
    border-color: var(--appui-primary-100);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 12px;
}

.fm-ml-edit-banner.visible {
    display: flex;
}

.fm-ml-edit-banner-title {
    color: var(--appui-primary-800);
    font-size: var(--appui-font-sizes-body-md);
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 1;
}

.fm-ml-cancel-edit-btn {
    flex-shrink: 0;
    margin-left: 8px;
}

.fm-ml-step {
    display: none;
    flex-direction: column;
}

.fm-ml-step.visible {
    display: flex;
}

.fm-ml-step-heading {
    margin-bottom: 12px;
    white-space: wrap;
}

.fm-ml-step-buttons {
    flex-direction: column;
}

.fm-ml-back-inline {
    display: none;
    color: var(--appui-foregrounds-100);
    margin-bottom: 8px;
    padding: 0;
    min-height: auto;
    background-color: transparent;
}

.fm-ml-back-inline .appui-icon {
    --unity-image-tint-color: var(--appui-foregrounds-100);
}

.fm-ml-back-inline.visible {
    display: flex;
}

.fm-ml-back-inline:hover {
    opacity: 0.8;
}

.fm-ml-logged-zone {
    display: none;
    flex-direction: column;
    margin-top: 24px;
}

.fm-ml-logged-zone.visible {
    display: flex;
}

.fm-ml-meals-list {
    flex-direction: column;
    margin-top: 12px;
}

.fm-ml-day-stepper {
    margin-top: 8px;
    margin-bottom: 4px;
    align-self: center;
    width: 100%;
    justify-content: flex-end;
}

.fm-ml-preset-results {
    flex-direction: column;
    margin-bottom: 8px;
}

.fm-ml-selected-chips {
    flex-direction: column;
    justify-content: flex-start;
    margin: 8px 0;
    min-height: 700px;
}

.fm-ml-selected-chips > * {
    margin: 2px 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.fm-ml-chip-preset {
    border-color: var(--appui-color-accent);
    border-width: 1px;
}

.fm-ml-log-actions-row {
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    margin-top: 12px;
}

.fm-ml-save-preset-chk {
    align-self: flex-start;
}

.fm-ml-log-btn {
    align-self: flex-start;
    margin-top: 12px;
    width: 100%;
}

.fm-ml-card-badge {
    font-size: var(--appui-font-sizes-body-md);
    padding: 2px 8px;
    border-radius: 4px;
    margin-top: 8px;
    align-self: flex-start;
}

.fm-ml-card-badge--pantry {
    background-color: var(--appui-destructive-25);
    color: var(--appui-destructive-300);
}

.fm-ml-card-badge--out {
    background-color: var(--appui-warning-25);
    color: var(--appui-warning-300);
}

.fm-ml-preset-badge {
    font-size: var(--appui-font-sizes-body-sm);
    -unity-font-style: bold;
    color: var(--appui-accent-800);
    background-color: var(--appui-accent-100);
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: center;
}

.fm-quick-meal-banner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-radius: 16px;
    padding: 16px;
}

.fm-quick-meal-banner-btn {
    flex-shrink: 0;
    width: 100%;
    white-space: normal;
    text-overflow: ellipsis;
    overflow: hidden;
}
