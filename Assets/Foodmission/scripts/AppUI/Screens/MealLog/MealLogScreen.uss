.fm-ml-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px;
}

.fm-ml-header {
    margin-bottom: 16px;
}

.fm-ml-error {
    color: var(--appui-color-danger-500);
    align-self: center;
    margin-top: 16px;
    display: none;
}

.fm-ml-error.visible {
    display: flex;
}

.fm-ml-empty {
    align-self: center;
    margin-top: 48px;
    opacity: 0.5;
    display: none;
}

.fm-ml-empty.visible {
    display: flex;
}

.fm-ml-scroll {
    flex-grow: 1;
    margin-bottom: 8px;
}

.fm-ml-container {
    flex-grow: 1;
    flex-direction: column;
}

.fm-ml-fab {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 48px;
    height: 48px;
    font-size: 24px;
}

.fm-ml-section-header {
    font-size: var(--appui-font-sizes-body-sm);
    font-weight: var(--appui-font-weight-bold);
    text-transform: uppercase;
    opacity: 0.6;
    padding: 8px 8px 4px;
    margin-top: 8px;
}

.fm-ml-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.2);
}

.fm-ml-row:active {
    background-color: rgb(var(--fm-color-surface-pressed));
}

.fm-ml-row-info {
    flex-grow: 1;
    flex-direction: column;
    margin-left: 8px;
}

.fm-ml-row-name {
    font-size: var(--appui-font-sizes-body-md);
}

.fm-ml-row-time {
    font-size: var(--appui-font-sizes-body-sm);
    opacity: 0.7;
}

.fm-ml-row-badge {
    font-size: var(--appui-font-sizes-body-sm);
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 8px;
}

.fm-ml-row-badge--pantry {
    background-color: var(--appui-color-danger-100);
    color: var(--appui-color-danger-700);
}

.fm-ml-row-badge--out {
    background-color: var(--appui-color-warning-100);
    color: var(--appui-color-warning-700);
}
