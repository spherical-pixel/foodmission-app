.fm-mla-root {
    flex-grow: 1;
    padding: 16px;
}
.fm-mla-header {
    margin-bottom: 16px;
}
.fm-mla-spinner {
    align-self: center;
    display: none;
}
.fm-mla-spinner.visible {
    display: flex;
}
.fm-mla-error {
    color: rgb(var(--fm-color-error));
    display: none;
    margin-bottom: 8px;
}
.fm-mla-error.visible {
    display: flex;
}
.fm-mla-section {
    margin-bottom: 16px;
}
.fm-mla-dropdown {
    margin-top: 4px;
}
.fm-mla-toggles {
    flex-direction: row;
    gap: 16px;
}
.fm-mla-search-row {
    flex-direction: row;
    align-items: center;
}
.fm-mla-search-field {
    flex-grow: 1;
}
.fm-mla-search-spinner {
    display: none;
    margin-left: 8px;
}
.fm-mla-search-spinner.visible {
    display: flex;
}
.fm-mla-search-results-scroll {
    max-height: 200px;
    margin-top: 4px;
}
.fm-mla-search-result-row {
    padding: 8px;
    border-bottom: 1px solid rgb(var(--fm-color-border));
}
.fm-mla-search-result-row:active {
    background-color: rgb(var(--fm-color-surface-pressed));
}
.fm-mla-search-result-name {
    font-size: 14px;
}
.fm-mla-deduction {
    display: none;
}
.fm-mla-deduction.visible {
    display: flex;
}
.fm-mla-deduction-item {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgb(var(--fm-color-border));
}
.fm-mla-deduction-item-info {
    flex-grow: 1;
}
.fm-mla-deduction-item-name {
    font-size: 14px;
}
.fm-mla-deduction-item-detail {
    font-size: 12px;
    color: rgb(var(--fm-color-text-secondary));
}
.fm-mla-deduction-item-qty {
    width: 60px;
    margin-left: 8px;
}
.fm-mla-create-btn {
    display: none;
    margin-top: 8px;
}
.fm-mla-create-btn.visible {
    display: flex;
}
.fm-mla-save-btn {
    margin-top: 16px;
}
