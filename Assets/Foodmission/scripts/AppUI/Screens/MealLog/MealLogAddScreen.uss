.fm-mla-root {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px;
}

.fm-mla-header {
    margin-bottom: 16px;
}

.fm-mla-error {
    color: var(--appui-color-danger-500);
    align-self: center;
    margin-top: 16px;
    display: none;
}

.fm-mla-error.visible {
    display: flex;
}

.fm-mla-section {
    margin-bottom: 16px;
}

.fm-mla-dropdown {
    margin-top: 4px;
}

.fm-mla-toggles {
    flex-direction: row;
    gap: 16px;
}

.fm-mla-search-row {
    flex-direction: row;
    align-items: center;
}

.fm-mla-search-field {
    flex-grow: 1;
}

.fm-mla-search-spinner {
    display: none;
    margin-left: 8px;
}

.fm-mla-search-spinner.visible {
    display: flex;
}

.fm-mla-search-results-scroll {
    max-height: 200px;
    margin-top: 4px;
}

.fm-mla-search-result-row {
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.2);
}

.fm-mla-search-result-row:active {
    background-color: rgb(var(--fm-color-surface-pressed));
}

.fm-mla-search-result-name {
    font-size: var(--appui-font-sizes-body-sm);
}

.fm-mla-deduction {
    display: none;
}

.fm-mla-deduction.visible {
    display: flex;
}

.fm-mla-deduction-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.2);
}

.fm-mla-deduction-item-info {
    flex-grow: 1;
}

.fm-mla-deduction-item-name {
    font-size: var(--appui-font-sizes-body-sm);
}

.fm-mla-deduction-item-detail {
    font-size: var(--appui-font-sizes-body-sm);
    opacity: 0.7;
}

.fm-mla-deduction-item-qty {
    width: 60px;
    margin-left: 8px;
}

.fm-mla-create-btn {
    display: none;
    margin-top: 8px;
}

.fm-mla-create-btn.visible {
    display: flex;
}

.fm-mla-save-btn {
    margin-top: 16px;
}
