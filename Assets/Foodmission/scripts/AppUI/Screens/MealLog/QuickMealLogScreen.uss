.fm-quick-meal-root {
    flex-grow: 0;
    flex-shrink: 0;
    height: auto;
    display: flex;
    flex-direction: column;
}

.fm-quick-meal-card {
    background-color: var(--fm-bg-screen-trans);
    border-radius: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    height: auto;
    flex-grow: 0;
    flex-shrink: 0;
}

.fm-quick-meal-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 24px;
}



.fm-quick-meal-title {
    -unity-font-style: bold;
    /* color: var(--appui-foregrounds-50); */
    margin-bottom: 8px;
    white-space: normal;
}



.fm-quick-meal-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 24px;
}

.fm-quick-meal-section-title {
    -unity-font-style: bold;
    color: var(--appui-foregrounds-100);
    margin-bottom: 12px;
}

/* =========================================================================
   MEAL TYPE SELECTION
   ========================================================================= */

.fm-quick-meal-types-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.fm-quick-meal-type-btn {
    width: 48%;
    margin-bottom: 8px;
    overflow: hidden;
}

.fm-quick-meal-type-btn .appui-button__titlecontainer {
    overflow: hidden;
    min-width: 0;
    flex-shrink: 1;
    width: 100%;
}

.fm-quick-meal-type-btn .appui-button__title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    width: 100%;
    max-width: 100%;
    -unity-text-align: middle-center;
}

/* =========================================================================
   QUESTIONS CHECKLIST & SWAP SELECTOR
   ========================================================================= */

.fm-quick-meal-questions-list {
    display: flex;
    flex-direction: column;
}

.fm-quick-meal-question-card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    border-radius: 16px;
    background-color: var(--appui-backgrounds-100);
    border-width: 2px;
    border-color: transparent;
    margin-bottom: 12px;
}

.fm-quick-meal-question-card--checked {
    border-color: #649E82;
    background-color: var(--appui-backgrounds-200);
}

.fm-quick-meal-question-header {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.fm-quick-meal-checkbox {
    margin-right: 14px;
    color: var(--appui-foregrounds-50);
}

.fm-quick-meal-checkbox .appui-checkbox__box {
    border-color: var(--appui-foregrounds-50);
}

.fm-quick-meal-checkbox .appui-checkbox__box > .appui-icon {
	--unity-image-tint-color: var(--appui-foregrounds-50)	
}

.fm-quick-meal-question-icon {
    font-size: 48px;
    margin-right: 8px;
    align-self: center;
}

.fm-quick-meal-question-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--appui-foregrounds-50);
    -unity-font-style: bold;
}

/* Swaps inline container in quick meal log */
.fm-quick-meal-swaps-container {
    display: flex;
    flex-direction: column;
    margin-top: 14px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--appui-backgrounds-300);
}

.fm-quick-meal-swaps-title {
    color: var(--appui-foregrounds-200);
    -unity-font-style: bold;
    
    margin-bottom: 8px;
}

.fm-quick-meal-swaps-list {
    display: flex;
    flex-direction: column;
}

.fm-quick-meal-swap-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: var(--appui-backgrounds-100);
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-width: 1.5px;
    border-color: transparent;
}

.fm-quick-meal-swap-chip--active {
    border-color: var(--appui-primary-800);
    background-color: var(--appui-primary-100);
}

.fm-quick-meal-swap-radio {
    margin-right: 10px;
}

.fm-quick-meal-swap-chip-text {
    flex-grow: 1;
    color: var(--appui-foregrounds-50);
    -unity-font-style: bold;
    white-space: normal;
}

/* =========================================================================
   INPUTS & BUTTONS
   ========================================================================= */

.fm-quick-meal-input {
    width: 100%;
}

.fm-quick-meal-feedback {
    color: #649E82;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.fm-quick-meal-submit-btn {
    width: 100%;
    margin-top: 8px;
}

/* =========================================================================
   ACCORDION SECTIONS
   ========================================================================= */

.fm-quick-meal-accordion-section {
    background-color: var(--appui-backgrounds-100);
    border-radius: 16px;
    margin-bottom: 12px;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--appui-backgrounds-300);
}

.fm-quick-meal-accordion-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background-color: var(--appui-backgrounds-100);
    border-radius: 16px;
}

.fm-quick-meal-accordion-header--expanded {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--appui-backgrounds-300);
}

.fm-quick-meal-accordion-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
}

.fm-quick-meal-accordion-icon {
    font-size: 48px;
    margin-right: 10px;
}

.fm-quick-meal-accordion-title {
    -unity-font-style: bold;
    color: var(--appui-foregrounds-100);
    white-space: normal;
    flex-grow: 1;
}

.fm-quick-meal-accordion-header-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.fm-quick-meal-accordion-badge {
    background-color: var(--appui-primary-800);
    color: var(--appui-primary-100);
    -unity-font-style: bold;
    /*font-size: 13px;*/
    -unity-text-align: middle-center;
    padding: 10px;
    border-radius: 20px;
    margin-right: 10px;
    flex-shrink: 0;
    white-space: nowrap;
}

.fm-quick-meal-accordion-chevron {
    color: var(--appui-foregrounds-200);
    --unity-image-tint-color: var(--appui-foregrounds-200);
    transition-property: rotate;
    transition-duration: 0.2s;
}

.fm-quick-meal-accordion-chevron--collapsed {
    rotate: -90deg;
}

.fm-quick-meal-accordion-content {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
}

.fm-quick-meal-accordion-content--hidden {
    display: none;
}

.fm-quick-meal-accordion-content .fm-quick-meal-question-card {
    background-color: var(--appui-backgrounds-200);
    margin-bottom: 8px;
}

.fm-quick-meal-accordion-content .fm-quick-meal-question-card--checked {
    background-color: var(--appui-primary-700);
    border-color: #649E82;
}

