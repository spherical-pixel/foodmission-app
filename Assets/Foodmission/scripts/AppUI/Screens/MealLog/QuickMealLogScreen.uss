.fm-quick-meal-root {
    flex-grow: 0;
    flex-shrink: 0;
    height: auto;
    display: flex;
    flex-direction: column;
}

.fm-quick-meal-card {
    background-color: var(--fm-bg-screen-trans);
    border-radius: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    height: auto;
    flex-grow: 0;
    flex-shrink: 0;
}

.fm-quick-meal-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 24px;
}



.fm-quick-meal-title {
    -unity-font-style: bold;
    /* color: var(--appui-foregrounds-50); */
    margin-bottom: 8px;
    white-space: normal;
}



.fm-quick-meal-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 24px;
}

.fm-quick-meal-section-title {
    -unity-font-style: bold;
    color: var(--appui-foregrounds-100);
    margin-bottom: 12px;
}

/* =========================================================================
   MEAL TYPE SELECTION
   ========================================================================= */

.fm-quick-meal-types-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.fm-quick-meal-type-btn {
    width: 48%;
    margin-bottom: 8px;
    overflow: hidden;
}

.fm-quick-meal-type-btn .appui-button__titlecontainer {
    overflow: hidden;
    min-width: 0;
    flex-shrink: 1;
    width: 100%;
}

.fm-quick-meal-type-btn .appui-button__title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    width: 100%;
    max-width: 100%;
    -unity-text-align: middle-center;
}

/* =========================================================================
   INPUTS & BUTTONS
   ========================================================================= */

.fm-quick-meal-input {
    width: 100%;
}

.fm-quick-meal-feedback {
    color: #649E82;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.fm-quick-meal-submit-btn {
    width: 100%;
    margin-top: 8px;
}

/* =========================================================================
   EDIT MODE BANNER
   ========================================================================= */

.fm-quick-meal-edit-banner {
    flex-direction: row;
    align-items: center;
    background-color: var(--appui-primary-100);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 12px;
}

.fm-quick-meal-edit-banner-icon {
    width: 64px;
    height: 64px;
    margin-right: 8px;
    --unity-image-tint-color: var(--appui-primary-800);
}

.fm-quick-meal-edit-banner-text {
    color: var(--appui-primary-600);
    -unity-font-style: bold;
    white-space: nowrap;
}
