.fm-recipes-root {
    flex-grow: 1;
}

/* Header with Title and Create Button */
.fm-r-top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.fm-r-heading {
    font-size: var(--appui-font-sizes-title-lg);
    -unity-font-style: bold;
    color: var(--appui-foregrounds-50);
}

.fm-r-create-btn {
    border-radius: 20px;
    padding-left: 16px;
    padding-right: 16px;
    width: 100%;
}

/* Tabs */
.fm-r-tabs-container {
    margin-bottom: 12px;
    flex-shrink: 0;
}

.fm-r-tabs {
    width: 100%;
}

/* Search and Filters */
.fm-r-filter-section {
    margin-bottom: 12px;
    flex-shrink: 0;
}

.fm-r-search {
    margin-bottom: 8px;
    width: 100%;
}

.fm-r-cuisine-row {
    margin-bottom: 8px;
    width: 100%;
}

.fm-r-cuisine-dropdown {
    width: 100%;
}

.fm-r-filter-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.fm-r-difficulty-group {
    flex-grow: 1;
}

.fm-r-categories-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 4px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.fm-r-cat-chip {
    width: 31.8%;
    height: 64px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 12px;
    background-color: var(--appui-backgrounds-200);
    color: var(--appui-foregrounds-50);
    font-size: var(--appui-font-sizes-body-xs);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.fm-r-cat-chip:hover {
    background-color: var(--appui-backgrounds-300);
}

.fm-r-cat-chip:active {
    scale: 0.95 0.95;
}

.fm-r-cat-chip--active {
    background-color: var(--appui-color-primary-500);
    color: white;
}

/* Main scroll */
.fm-r-scroll {
    flex-grow: 1;
}

.fm-r-view {
    flex-direction: column;
}

/* Nutri Empty Pantry Banner */
.fm-r-empty-pantry-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--appui-backgrounds-200);
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: var(--appui-color-primary-500);
}

.fm-r-nutri-avatar-slot {
    width: 80px;
    height: 80px;
    margin-right: 16px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.fm-r-nutri-view {
    width: 80px;
    height: 80px;
}

.fm-r-empty-pantry-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.fm-r-empty-pantry-title {
    font-size: var(--appui-font-sizes-title-sm);
    -unity-font-style: bold;
    color: var(--appui-foregrounds-50);
    margin-bottom: 4px;
    width: 100%;
}

.fm-r-empty-pantry-desc {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-200);
    margin-bottom: 12px;
    white-space: normal;
}

.fm-r-pantry-btn {
    align-self: flex-start;
    border-radius: 16px;
}

.fm-r-section-subtitle {
    font-size: var(--appui-font-sizes-body-md);
    -unity-font-style: bold;
    color: var(--appui-foregrounds-100);
    margin-top: 25px;
    margin-bottom: 25px;
}

/* General Empty Cards */
.fm-r-empty-card {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    border-radius: 20px;
    background-color: var(--appui-backgrounds-200);
    margin-top: 20px;
    margin-bottom: 20px;
}

.fm-r-empty-emoji {
    font-size: 48px;
    margin-bottom: 12px;
}

.fm-r-empty-title {
    font-size: var(--appui-font-sizes-title-sm);
    -unity-font-style: bold;
    color: var(--appui-foregrounds-50);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.fm-r-empty-desc {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-200);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.fm-r-create-first-btn {
    border-radius: 16px;
    padding-left: 20px;
    padding-right: 20px;
}

.fm-r-empty-my-recipes {
    flex-direction: column;
    align-items: flex-start;
    background-color: var(--appui-backgrounds-200);
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: var(--appui-color-primary-500);
}

.fm-r-results-header {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 12px;
}

.fm-r-counter {
    flex-grow: 1;
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-200);
    -unity-font-style: bold;
}

.fm-r-empty {
    align-self: center;
    margin-top: 32px;
    font-size: var(--appui-font-sizes-body-lg);
    color: var(--appui-foregrounds-200);
    -unity-text-align: middle-center;
    display: none;
}

.fm-r-empty.visible {
    display: flex;
}

.fm-r-container {
    flex-direction: column;
}

.fm-r-sentinel {
    height: 1px;
}

/* Recipe Card Styling */
.fm-r-card {
    flex-direction: column;
    border-radius: 20px;
    background-color: var(--appui-backgrounds-200);
    padding: 20px;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
}

.fm-r-card-header {
    flex-direction: column;
    margin-bottom: 10px;
}

.fm-r-card-title {
    font-size: var(--appui-font-sizes-title-sm);
    -unity-font-style: bold;
    color: var(--appui-foregrounds-50);
    white-space: normal;
}

.fm-r-card-author {
    font-size: var(--appui-font-sizes-body-xs);
    color: var(--appui-foregrounds-200);
    margin-top: 2px;
}

.fm-r-card-hero {
    height: 400px;
    border-radius: 14px;
    background-color: var(--appui-backgrounds-100);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center;
    align-items: center;
    margin-bottom: 25px;
    position: relative;
    overflow: hidden;
}

.fm-r-card-hero-emoji {
    font-size: 175px;
}

.fm-r-pantry-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background-color: rgba(220, 38, 38, 0.9);
    color: white;
    font-size: var(--appui-font-sizes-body-xs);
    -unity-font-style: bold;
    padding: 15px 15px;
    border-radius: 12px;
    white-space: nowrap;
}

.fm-r-card-pills {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

.fm-r-pill {
    font-size: var(--appui-font-sizes-body-xs);
    -unity-font-style: bold;
    padding: 15px 15px;
    border-radius: 10px;
    margin-right: 6px;
    margin-bottom: 4px;
    background-color: var(--appui-backgrounds-300);
    color: var(--appui-foregrounds-100);
}

.fm-r-pill--time {
    background-color: rgba(59, 130, 246, 0.15);
    color: rgb(59, 130, 246);
    white-space: nowrap;
}

.fm-r-pill--difficulty {
    background-color: rgba(16, 185, 129, 0.15);
    color: rgb(16, 185, 129);
    white-space: nowrap;
}

.fm-r-pill--category {
    background-color: rgba(245, 158, 11, 0.15);
    color: rgb(245, 158, 11);
    white-space: nowrap;
}

.fm-r-card-meta-container {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.fm-r-card-rating {
    font-size: var(--appui-font-sizes-body-xs);
    color: var(--appui-foregrounds-200);
}
