<UXML xmlns="UnityEngine.UIElements"
      xmlns:ui="UnityEngine.UIElements"
      xmlns:appui="Unity.AppUI.UI"
      xmlns:fm="eu.foodmission.platform.Components"
      xmlns:eu="eu.foodmission.platform">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss"/>
    <Style src="project://database/Assets/Foodmission/AppUI/Styles/Components/FMStepProgressBar.uss"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Recipes/RecipeEditorScreen.uss"/>
    <ui:VisualElement name="back" class="fm-back-screen-transparent"/>
    <ui:VisualElement name="root" class="fm-root fm-re-root">
        <appui:Heading name="screen-title" size="L" text="Crear Receta" class="fm-re-title"/>
        <fm:FMStepProgressBar name="step-progress-bar" step-count="3" current-step="0" class="fm-re-progress"/>
        <ui:VisualElement name="step-container" class="fm-re-step-container">
            <!-- Step 1: Meta -->
            <ui:VisualElement name="step-1" class="fm-re-step">
                <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" class="fm-re-step-scroll">
                    <appui:TextField name="title-field" label="Título de la receta *" placeholder="Ej. Pasta con verduras"/>
                    <appui:TextArea name="description-field" label="Descripción" placeholder="Breve introducción de la receta..."/>
                    <ui:VisualElement class="fm-re-row-2col">
                        <appui:TextField name="prep-time-field" label="Prep (min)" placeholder="15" class="fm-re-col"/>
                        <appui:TextField name="cook-time-field" label="Cocción (min)" placeholder="20" class="fm-re-col"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="fm-re-row-2col">
                        <appui:TextField name="servings-field" label="Raciones" placeholder="4" class="fm-re-col"/>
                        <appui:TextField name="difficulty-field" label="Dificultad" placeholder="Fácil / Media / Difícil" class="fm-re-col"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="fm-re-row-2col">
                        <appui:TextField name="category-field" label="Categoría" placeholder="Pasta, Ensalada, etc." class="fm-re-col"/>
                        <appui:TextField name="cuisine-field" label="Tipo de cocina" placeholder="Mediterránea, Italiana..." class="fm-re-col"/>
                    </ui:VisualElement>
                    <appui:Checkbox name="is-public-checkbox" label="Hacer receta pública para la comunidad"/>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Step 2: Ingredients -->
            <ui:VisualElement name="step-2" class="fm-re-step">
                <fm:FMSearchOrCategoryField name="search-ingredients-field" skip-quantity-confirmation="true"/>
                <ui:VisualElement name="free-text-row" class="fm-re-free-text-row">
                    <appui:TextField name="free-text-name" placeholder="Nombre del ingrediente" class="fm-re-free-name"/>
                    <appui:TextField name="free-text-measure" placeholder="Cantidad / Medida" class="fm-re-free-measure"/>
                    <fm:FMButton name="btn-add-free-text" title="Añadir" variant="Accent" size="M" class="fm-re-add-btn"/>
                </ui:VisualElement>
                <appui:Text name="no-ingredients-warning" class="fm-re-warning" text="No has añadido ingredientes todavía."/>
                <ui:ScrollView name="ingredients-scroll" class="fm-re-ingredients-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="ingredients-container" class="fm-re-ingredients-container"/>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Step 3: Review -->
            <ui:VisualElement name="step-3" class="fm-re-step">
                <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" class="fm-re-step-scroll">
                    <appui:TextArea name="instructions-field" label="Instrucciones de preparación" placeholder="Pasos detallados para cocinar el plato..."/>
                    <appui:TextField name="image-url-field" label="URL de imagen (opcional)" placeholder="https://..."/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Step Navigation Controls -->
        <ui:VisualElement name="step-nav-bar" class="fm-re-nav-bar">
            <fm:FMButton name="btn-step-prev" title="Anterior" variant="Default" size="M" class="fm-re-nav-btn"/>
            <fm:FMButton name="btn-step-next" title="Siguiente" variant="Accent" size="M" class="fm-re-nav-btn"/>
        </ui:VisualElement>

        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</UXML>
