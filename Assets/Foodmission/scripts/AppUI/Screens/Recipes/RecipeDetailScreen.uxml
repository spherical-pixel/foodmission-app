<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Recipes/RecipeDetailScreen.uss?fileID=7433441132597879392&amp;guid=3015b3c6890854fa7a44b3c0127f1683&amp;type=3#RecipeDetailScreen"/>
    <ui:VisualElement name="back" class="fm-back-screen-transparent"/>
    <ui:VisualElement name="root" class="fm-root">
        <ui:ScrollView name="scroll-view" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="fm-rd-scroll">
            <ui:VisualElement name="hero-section" class="fm-rd-hero">
                <appui:Heading name="recipe-title" size="L"/>
                <ui:VisualElement name="hero-image-container" class="fm-rd-hero-image">
                    <ui:Image name="hero-image" class="fm-rd-hero-img"/>
                    <appui:Text name="hero-emoji" text="📚" class="fm-rd-hero-emoji"/>
                    <appui:Button name="btn-watch-video" label="Watch video guide" quiet="true" title="" leading-icon="play" class="fm-rd-video-button fm-rd-action--hidden" style="font-size: 64px;"/>
                </ui:VisualElement>
                <appui:Text name="rating-text" class="fm-rd-rating"/>
                <ui:VisualElement name="badges-strip" class="fm-rd-badges"/>
            </ui:VisualElement>
            <appui:Text name="description" class="fm-rd-section fm-rd-description"/>
            <appui:Accordion name="sections-accordion" class="fm-rd-accordion">
                <appui:AccordionItem name="meta-section" label="Information" title="Information" expanded="true" value="true" class="fm-rd-section">
                    <ui:VisualElement name="meta-card" class="fm-rd-detail-card"/>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(28870311913971712)"/>
                    </Bindings>
                </appui:AccordionItem>
                <appui:AccordionItem name="ingredients-section" label="Ingredients" title="Ingredients" expanded="true" value="true" class="fm-rd-section">
                    <ui:VisualElement name="ingredients-card" class="fm-rd-detail-card"/>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(21294142473625603)"/>
                    </Bindings>
                </appui:AccordionItem>
                <appui:AccordionItem name="instructions-section" label="Instructions" title="Instructions" expanded="true" value="true" class="fm-rd-section">
                    <ui:VisualElement name="instructions-container" class="fm-rd-instructions"/>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(28870675795009536)"/>
                    </Bindings>
                </appui:AccordionItem>
                <appui:AccordionItem name="nutrition-section" label="Nutrition" title="Nutrition" expanded="true" value="true" class="fm-rd-section">
                    <ui:VisualElement name="nutrition-card" class="fm-rd-detail-card"/>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(28870860768010240)"/>
                    </Bindings>
                </appui:AccordionItem>
                <appui:AccordionItem name="dietary-section" label="Diet &amp; Lifestyle" title="Diet &amp; Lifestyle" expanded="true" value="true" class="fm-rd-section">
                    <ui:VisualElement name="dietary-container" class="fm-rd-badges-container"/>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(28872804286849024)"/>
                    </Bindings>
                </appui:AccordionItem>
                <appui:AccordionItem name="allergens-section" label="Allergens" title="Allergens" expanded="true" value="true" class="fm-rd-section">
                    <ui:VisualElement name="allergens-container" class="fm-rd-badges-container"/>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(21294142473625604)"/>
                    </Bindings>
                </appui:AccordionItem>
                <appui:AccordionItem name="tags-section" label="Tags" title="Tags" expanded="true" value="true" class="fm-rd-section">
                    <ui:VisualElement name="tags-container" class="fm-rd-badges-container"/>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(28873180532695040)"/>
                    </Bindings>
                </appui:AccordionItem>
            </appui:Accordion>
        </ui:ScrollView>
        <ui:VisualElement name="actions-bar" class="fm-rd-actions">
            <appui:Button name="btn-log" variant="Accent" label="Log recipe" title="LOG" class="fm-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(21294142473625602)"/>
                </Bindings>
            </appui:Button>
            <appui:Spacer/>
            <appui:Button name="btn-add-to-shopping-list" label="Add to shopping list" title="SHOPPING" variant="Accent" class="fm-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(21294142473625601)"/>
                </Bindings>
            </appui:Button>
            <appui:Spacer/>
            <appui:Button name="btn-edit" label="Edit" title="EDIT" class="fm-rd-action--hidden"/>
            <appui:Spacer/>
            <appui:Button name="btn-delete" variant="Destructive" label="Delete" title="DELETE" class="fm-rd-action--hidden"/>
            <appui:Spacer spacing="XL"/>
        </ui:VisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
