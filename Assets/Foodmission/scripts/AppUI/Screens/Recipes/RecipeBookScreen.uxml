<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:fm="eu.foodmission.platform.Components" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Recipes/RecipeBookScreen.uss?fileID=7433441132597879392&amp;guid=864198e7016484a97b167e7e437f9fd1&amp;type=3#RecipeBookScreen"/>
    <ui:VisualElement name="back" class="fm-back-screen-transparent"/>
    <ui:VisualElement name="root" class="fm-root fm-recipes-root">
        <ui:VisualElement name="top-header" class="fm-r-top-header"/>
        <ui:VisualElement name="tabs-container" class="fm-r-tabs-container">
            <appui:ActionGroup name="recipes-tabs" selection-type="Single" allow-no-selection="false" compact="true" size="M" direction="Horizontal" justified="true" class="fm-r-tabs">
                <appui:ActionButton name="btn-tab-for-you" label="Para ti" selected="true" size="M">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747305201664)"/>
                    </Bindings>
                </appui:ActionButton>
                <appui:ActionButton name="btn-tab-explore" label="Explorar" size="M">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395968)"/>
                    </Bindings>
                </appui:ActionButton>
            </appui:ActionGroup>
        </ui:VisualElement>
        <ui:VisualElement name="filter-section" class="fm-r-filter-section">
            <appui:SearchBar name="search-bar" size="M" placeholder="Buscar recetas..." class="fm-r-search">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="placeholder" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(28540443628134400)"/>
                </Bindings>
            </appui:SearchBar>
            <ui:VisualElement name="difficulty-filter-row" class="fm-r-filter-row">
                <appui:ActionGroup name="group-difficulty-filters" selection-type="Single" allow-no-selection="false" compact="true" size="S" direction="Horizontal" class="fm-r-difficulty-group">
                    <appui:ActionButton name="btn-diff-all" label="Todas" selected="true" size="S">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395976)"/>
                        </Bindings>
                    </appui:ActionButton>
                    <appui:ActionButton name="btn-diff-easy" label="Fácil" size="S">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395977)"/>
                        </Bindings>
                    </appui:ActionButton>
                    <appui:ActionButton name="btn-diff-medium" label="Media" size="S">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395978)"/>
                        </Bindings>
                    </appui:ActionButton>
                    <appui:ActionButton name="btn-diff-hard" label="Difícil" size="S">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395979)"/>
                        </Bindings>
                    </appui:ActionButton>
                </appui:ActionGroup>
            </ui:VisualElement>
            <ui:ScrollView name="categories-scroll" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="fm-r-categories-scroll">
                <ui:VisualElement name="categories-chips-container" class="fm-r-categories-container"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:ScrollView name="scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden" class="fm-r-scroll">
            <ui:VisualElement name="view-for-you" class="fm-r-view">
                <ui:VisualElement name="foryou-empty-pantry" class="fm-r-empty-pantry-card">
                    <ui:VisualElement class="fm-r-nutri-avatar-slot">
                        <fm:FMNutriView name="nutri-avatar" class="fm-r-nutri-view"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="fm-r-empty-pantry-info">
                        <appui:Heading name="empty-pantry-title" size="M" text="Tu despensa está vacía" class="fm-r-empty-pantry-title">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395971)"/>
                            </Bindings>
                        </appui:Heading>
                        <appui:Text name="empty-pantry-desc" text="¡Añade alimentos a tu despensa para recibir sugerencias de recetas y evitar el desperdicio!" class="fm-r-empty-pantry-desc">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395972)"/>
                            </Bindings>
                        </appui:Text>
                        <fm:FMButton name="btn-go-to-pantry" title="Ir a la Despensa" variant="Accent" size="M" class="fm-r-pantry-btn">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(47367747309395973)"/>
                            </Bindings>
                        </fm:FMButton>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="foryou-content" class="fm-r-foryou-content">
                    <appui:Text name="foryou-header-text" text="Aprovecha lo que tienes en casa" class="fm-r-section-subtitle">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(48511689140723712)"/>
                        </Bindings>
                    </appui:Text>
                    <ui:VisualElement name="recommendations-container" class="fm-r-container"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="view-explore" class="fm-r-view">
                <ui:VisualElement name="results-header" class="fm-r-results-header">
                    <appui:Text name="counter-text" text="Recetas encontradas" class="fm-r-counter"/>
                </ui:VisualElement>
                <appui:Text name="empty-state" text="No se han encontrado recetas" class="fm-r-empty">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(28541196946104320)"/>
                    </Bindings>
                </appui:Text>
                <ui:VisualElement name="items-container" class="fm-r-container"/>
                <ui:VisualElement name="scroll-sentinel" class="fm-r-sentinel"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-bottom-nav-padding"/>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
