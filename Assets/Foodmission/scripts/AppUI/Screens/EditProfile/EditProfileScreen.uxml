                </Bindings>
            </eu.foodmission.platform.Components.FormFieldItemIntField>
            <eu.foodmission.platform.Components.FormFieldItemDropDownField name="country">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(22819860558897152)"/>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(22819676332482560)"/>
                    <ui:DataBinding property="HelpTextText" data-source-path="CountryHelpTextValue" binding-mode="TwoWay"/>
                    <ui:DataBinding property="HelpTextVariant" data-source-path="CountryHelpTextVariant" binding-mode="TwoWay"/>
                </Bindings>
            </eu.foodmission.platform.Components.FormFieldItemDropDownField>
            <eu.foodmission.platform.Components.FormFieldItemDropDownField name="region">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="DropdownDefaultMessage" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(22820425670057984)"/>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(22820314747494400)"/>
                    <ui:DataBinding property="HelpTextVariant" data-source-path="RegionHelpTextVariant" binding-mode="TwoWay"/>
                    <ui:DataBinding property="HelpTextText" data-source-path="RegionHelpTextValue" binding-mode="TwoWay"/>
                </Bindings>
            </eu.foodmission.platform.Components.FormFieldItemDropDownField>
            <eu.foodmission.platform.Components.FormFieldItemTextField name="postalcode">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(22820717341958144)"/>
