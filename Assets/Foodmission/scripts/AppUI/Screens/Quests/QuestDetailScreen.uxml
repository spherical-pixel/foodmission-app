<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform.Components" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Quizzes/QuizzesScreen.uss?fileID=7433441132597879392&amp;guid=109516a41d4334001b40e7c8a262dbc4&amp;type=3#QuizzesScreen"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Quests/QuestsScreen.uss?fileID=7433441132597879392&amp;guid=2821b2fde381647d297af73b5ef1cbf6&amp;type=3#QuestsScreen"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Quests/QuestDetailScreen.uss?fileID=7433441132597879392&amp;guid=5821b2fde381647d297af73b5ef1cbff&amp;type=3#QuestDetailScreen"/>
    <ui:VisualElement name="root" class="fm-root fm-quest-detail-root">
        <ui:VisualElement name="card" class="fm-quest-detail-card">
            <appui:Text name="quest-title" text="" size="XXL" class="fm-quest-detail-title"/>
            <ui:VisualElement name="banner-container" class="fm-quest-detail-banner-container">
                <ui:Image name="image-dimension-banner" class="fm-quizzes-dim-icon fm-quest-detail-banner-image"/>
            </ui:VisualElement>
            <appui:Text name="quest-description" text="" size="M" class="fm-quest-detail-desc"/>
            <ui:VisualElement name="activities-container" class="fm-quest-detail-timeline-container"/>
        </ui:VisualElement>
        <eu:FMButton name="btn-start-quest" title="Empezar quest" variant="Accent" size="L" class="fm-quest-start-btn" style="margin-top: 24px; margin-bottom: 12px;"/>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
