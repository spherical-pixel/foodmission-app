<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/AppUI/Styles/Login.uss?fileID=7433441132597879392&amp;guid=73aaed7c57cf2482e9d3413302ada616&amp;type=3#Login"/>
    <ui:VisualElement name="root" data-source-type="eu.foodmission.platform.LoginViewModel, Foodmission" class="fm-root">
        <ui:Image name="logofoodmission" source="project://database/Assets/Foodmission/graphics/png/logo-foodmission-white.png?fileID=21300000&amp;guid=bab1e9be189fa4421b7615dfe330b1f6&amp;type=3#logo-foodmission-white" class="login-logo-foodmission" style="margin-top: 180px;"/>
        <ui:VisualElement name="group" class="box-background" style="flex-grow: 0;">
            <appui:Heading size="M" primary="true" name="Heading" selectable="true" focusable="true" class="heading-wrap-pre">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(18417184911908864)"/>
                </Bindings>
            </appui:Heading>
            <eu.foodmission.platform.Components.FormFieldItemTextField name="username">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(18417602513592320)"/>
                    <UnityEngine.Localization.LocalizedString property="TextFieldPlaceholder" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(18417848396275712)"/>
                    <ui:DataBinding property="TextFieldValue" data-source-path="Username" binding-mode="ToSource"/>
                    <ui:DataBinding property="HelpTextText" data-source-path="UsernameHelpTextValue" binding-mode="TwoWay"/>
                    <ui:DataBinding property="HelpTextVariant" data-source-path="UsernameHelpTextVariant" binding-mode="TwoWay"/>
                </Bindings>
            </eu.foodmission.platform.Components.FormFieldItemTextField>
            <eu.foodmission.platform.Components.FormFieldItemPassword name="password">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(18418052671463424)"/>
                    <UnityEngine.Localization.LocalizedString property="TextFieldPlaceholder" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(18418114709413888)"/>
                    <ui:DataBinding property="TextFieldValue" data-source-path="Password" binding-mode="TwoWay"/>
                    <ui:DataBinding property="HelpTextText" data-source-path="PasswordHelpTextValue" binding-mode="TwoWay"/>
                    <ui:DataBinding property="HelpTextVariant" data-source-path="PasswordHelpTextVariant" binding-mode="TwoWay"/>
                </Bindings>
            </eu.foodmission.platform.Components.FormFieldItemPassword>
            <appui:Spacer spacing="XL"/>
            <appui:Button name="login-button" text="Entrar" title="Sign in" trailing-icon="fm-arrow-right" size="M" variant="Accent" class="auth-button fm-button-align-left fm-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25367919163596800)"/>
                </Bindings>
            </appui:Button>
            <ui:VisualElement name="fm-login-footer" style="flex-direction: column; justify-content: center; gap: 24px; margin-top: 16px;">
                <appui:Button name="btForgotPassword" quiet="true" variant="Default">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25368981371084800)"/>
                    </Bindings>
                </appui:Button>
                <appui:Button name="btRegister" quiet="true">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25369431499595776)"/>
                    </Bindings>
                </appui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <appui:Spacer spacing="XL"/>
    </ui:VisualElement>
</ui:UXML>
