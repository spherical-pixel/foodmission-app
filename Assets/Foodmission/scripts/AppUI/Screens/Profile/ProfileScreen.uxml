<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <ui:ScrollView name="root" data-source-type="eu.foodmission.platform.ProfileViewModel, Foodmission" style="flex-grow: 1; padding-left: 16px; padding-right: 16px; padding-top: 24px; padding-bottom: 24px;">
        <!-- Profile Header -->
        <ui:VisualElement name="profile-header" style="flex-direction: row; align-items: center; margin-bottom: 24px;">
            <ui:VisualElement name="avatar" class="fm-profile-avatar"/>
            <appui:Heading name="username-label" size="M" style="flex-grow: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="UserName" binding-mode="ToTarget"/>
                </Bindings>
            </appui:Heading>
            <ui:VisualElement name="xp-badge" class="fm-profile-xp-badge">
                <ui:Label text="20 XP" class="fm-profile-xp-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <appui:LinearProgress name="xp-progress" style="margin-bottom: 24px;"/>

        <!-- Divider -->
        <ui:VisualElement style="height: 1px; background-color: rgba(128, 128, 128, 0.3); margin-bottom: 16px;"/>

        <!-- Menu Items -->
        <ui:VisualElement name="menu-item-profile" style="flex-direction: row; align-items: center; justify-content: space-between; padding-top: 12px; padding-bottom: 12px; margin-bottom: 8px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; flex-grow: 1;">
                <ui:Label text="✏️" style="margin-right: 12px; font-size: 20px;"/>
                <appui:Text name="label-profile" text="Edit Profile"/>
            </ui:VisualElement>
            <appui:Icon name="icon-caret-profile" icon="caret-right"/>
        </ui:VisualElement>

        <ui:VisualElement name="menu-item-avatar" style="flex-direction: row; align-items: center; justify-content: space-between; padding-top: 12px; padding-bottom: 12px; margin-bottom: 8px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; flex-grow: 1;">
                <ui:Label text="🎨" style="margin-right: 12px; font-size: 20px;"/>
                <appui:Text name="label-avatar" text="Edit Avatar"/>
            </ui:VisualElement>
            <appui:Icon name="icon-caret-avatar" icon="caret-right"/>
        </ui:VisualElement>

        <ui:VisualElement name="menu-item-groups" style="flex-direction: row; align-items: center; justify-content: space-between; padding-top: 12px; padding-bottom: 12px; margin-bottom: 8px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; flex-grow: 1;">
                <ui:Label text="👥" style="margin-right: 12px; font-size: 20px;"/>
                <appui:Text name="label-groups" text="Manage Groups"/>
            </ui:VisualElement>
            <appui:Icon name="icon-caret-groups" icon="caret-right"/>
        </ui:VisualElement>

        <ui:VisualElement name="menu-item-badges" style="flex-direction: row; align-items: center; justify-content: space-between; padding-top: 12px; padding-bottom: 12px; margin-bottom: 8px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; flex-grow: 1;">
                <ui:Label text="🏅" style="margin-right: 12px; font-size: 20px;"/>
                <appui:Text name="label-badges" text="View Badges"/>
            </ui:VisualElement>
            <appui:Icon name="icon-caret-badges" icon="caret-right"/>
        </ui:VisualElement>

        <ui:VisualElement name="menu-item-settings" style="flex-direction: row; align-items: center; justify-content: space-between; padding-top: 12px; padding-bottom: 12px; margin-bottom: 8px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; flex-grow: 1;">
                <ui:Label text="⚙️" style="margin-right: 12px; font-size: 20px;"/>
                <appui:Text name="label-settings" text="Settings"/>
            </ui:VisualElement>
            <appui:Icon name="icon-caret-settings" icon="caret-right"/>
        </ui:VisualElement>

        <!-- Divider -->
        <ui:VisualElement style="height: 1px; background-color: rgba(128, 128, 128, 0.3); margin-top: 8px; margin-bottom: 16px;"/>

        <ui:VisualElement name="menu-item-logout" style="flex-direction: row; align-items: center; justify-content: space-between; padding-top: 12px; padding-bottom: 12px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; flex-grow: 1;">
                <ui:Label text="🚪" style="margin-right: 12px; font-size: 20px;"/>
                <appui:Text name="label-logout" text="Log out"/>
            </ui:VisualElement>
            <appui:Icon name="icon-caret-logout" icon="caret-right"/>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
