<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/AppUI/Styles/Login.uss?fileID=7433441132597879392&amp;guid=73aaed7c57cf2482e9d3413302ada616&amp;type=3#Login"/>
    <ui:VisualElement name="root" data-source-type="eu.foodmission.platform.ForgotPasswordViewModel, Foodmission" class="appui appui--en appui--medium appui--light appui--ltr" style="width: 100%; height: 100%; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%;">
        <ui:VisualElement name="group" style="flex-grow: 0; background-color: rgba(255, 255, 255, 0.26); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; margin-left: 50px; margin-right: 50px; padding-top: 25px; padding-left: 25px; padding-right: 25px; padding-bottom: 25px; margin-top: 50px; margin-bottom: 50px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.2);">
            <appui:Heading size="XXL" primary="true" name="Heading" selectable="true" focusable="true" class="heading-wrap" style="flex-shrink: 1; flex-grow: 1;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25394900353671168)"/>
                </Bindings>
            </appui:Heading>
            <appui:Text name="descriptionText" class="centered-text" style="margin-top: 10px; margin-bottom: 20px;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25395075277119488)"/>
                </Bindings>
            </appui:Text>
            <eu.foodmission.platform.Components.FormFieldItemTextField name="email-field">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="HeadingText" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(22812687661522944)"/>
                    <UnityEngine.Localization.LocalizedString property="TextFieldPlaceholder" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(22812856394178560)"/>
                    <ui:DataBinding property="TextFieldValue" data-source-path="Email" binding-mode="TwoWay"/>
                    <ui:DataBinding property="HelpTextText" data-source-path="EmailHelpTextValue" binding-mode="TwoWay"/>
                    <ui:DataBinding property="HelpTextVariant" data-source-path="EmailHelpTextVariant" binding-mode="TwoWay"/>
                </Bindings>
            </eu.foodmission.platform.Components.FormFieldItemTextField>
            <appui:Button name="btContinue" text="Continuar" title="Continue" trailing-icon="caret-right" size="M" variant="Accent" class="auth-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25395779614007296)"/>
                </Bindings>
            </appui:Button>
            <appui:Button name="btBack" variant="Default">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(25395959562231808)"/>
                </Bindings>
            </appui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="loading-overlay" binding-path="IsLoading" class="auth-loading-overlay" style="position: absolute; top: 0; bottom: 0; right: 0; left: 0; justify-content: center; align-self: center; align-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.47); display: none;">
            <appui:CircularProgress class="auth-loading-spinner"/>
            <Bindings>
                <ui:DataBinding property="style.display" data-source-path="IsLoading" binding-mode="TwoWay"/>
            </Bindings>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
