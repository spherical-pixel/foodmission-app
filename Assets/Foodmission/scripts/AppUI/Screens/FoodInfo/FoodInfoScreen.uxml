<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/FoodInfo/FoodInfoScreen.uss?fileID=7433441132597879392&amp;guid=ddde968e06ff64ee380c411fa1be127f&amp;type=3#FoodInfoScreen"/>
    <ui:VisualElement name="root" class="fm-fi-root">
        <ui:VisualElement name="hero" class="fm-fi-hero">
            <ui:VisualElement name="hero-bg" class="fm-fi-hero-bg"/>
            <ui:VisualElement name="hero-content" class="fm-fi-hero-content">
                <ui:VisualElement name="food-image-container" class="fm-fi-image-container">
                    <ui:Image name="food-image" class="fm-fi-image"/>
                </ui:VisualElement>
                <appui:Text name="food-emoji" size="L" class="fm-fi-emoji"/>
                <appui:Heading name="food-name" size="L" class="fm-fi-food-name"/>
                <appui:Text name="food-subtitle" size="M" class="fm-fi-food-subtitle"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="badges-row" class="fm-fi-scores-strip">
            <ui:VisualElement name="nutriscore-pill" class="fm-fi-score-pill">
                <appui:Text name="nutriscore-badge" size="L" class="fm-fi-nutriscore fm-fi-score-pill__badge"/>
                <appui:Text name="nutriscore-label" size="S" text="NUTRI-SCORE" class="fm-fi-score-pill__label"/>
            </ui:VisualElement>
            <ui:VisualElement name="nova-pill" class="fm-fi-score-pill">
                <appui:Text name="nova-badge" size="L" class="fm-fi-nova fm-fi-score-pill__badge"/>
                <appui:Text name="nova-label" size="S" text="NOVA" class="fm-fi-score-pill__label"/>
            </ui:VisualElement>
            <ui:VisualElement name="eco-pill" class="fm-fi-score-pill">
                <appui:Text name="eco-badge" size="L" class="fm-fi-eco fm-fi-score-pill__badge"/>
                <appui:Text name="eco-label" size="S" text="ECO-SCORE" class="fm-fi-score-pill__label"/>
            </ui:VisualElement>
            <ui:VisualElement name="traffic-lights" class="fm-fi-traffic"/>
        </ui:VisualElement>
        <ui:VisualElement name="content" class="fm-fi-content">
            <appui:Text name="macro-header" class="fm-fi-macro-header"/>
            <ui:VisualElement name="macro-cards" class="fm-fi-macro-cards"/>
            <appui:Accordion name="sections-accordion">
                <appui:AccordionItem name="ingredients-section" label="Ingredients" title="Ingredients" expanded="true" class="fm-fi-section">
                    <appui:Text name="ingredients-body" size="M" class="fm-fi-section-body"/>
                </appui:AccordionItem>
                <appui:AccordionItem name="allergens-section" label="Allergens" title="Allergens" expanded="true" class="fm-fi-section">
                    <appui:Text name="allergens-body" size="M" class="fm-fi-section-body"/>
                </appui:AccordionItem>
                <appui:AccordionItem name="nutrition-detail-section" label="Full nutrition" title="Full nutrition" expanded="true" class="fm-fi-section">
                    <ui:VisualElement name="nutrition-detail-table" class="fm-fi-nutrition-table"/>
                </appui:AccordionItem>
                <appui:AccordionItem name="meta-section" label="Product details" title="Product details" expanded="true" class="fm-fi-section">
                    <ui:VisualElement name="meta-body" class="fm-fi-meta-body"/>
                </appui:AccordionItem>
            </appui:Accordion>
        </ui:VisualElement>
        <ui:VisualElement name="action-container" class="fm-fi-action-container">
            <appui:Button name="action-button" variant="Accent" class="fm-fi-action"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
