.fm-fi-root {
    flex-grow: 1;
    padding: 16px;
    flex-direction: column;
}
.fm-fi-header {
    flex-direction: row;
    margin-bottom: 16px;
    align-items: flex-start;
}
.fm-fi-image {
    width: 80px;
    height: 80px;
    margin-right: 12px;
    border-radius: 12px;
}
.fm-fi-emoji {
    font-size: 48px;
    margin-right: 12px;
    display: none;
}
.fm-fi-header-text {
    flex-grow: 1;
    flex-direction: column;
}
.fm-fi-food-name {
    margin-bottom: 4px;
}
.fm-fi-food-subtitle {
    color: rgb(var(--appui-texts-secondary));
    font-size: var(--appui-font-sizes-body-sm);
}
.fm-fi-badges-row {
    flex-direction: row;
    margin-top: 8px;
    flex-wrap: wrap;
    display: none;
}
.fm-fi-nutriscore, .fm-fi-nova, .fm-fi-eco {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    font-weight: bold;
    color: white;
}
.fm-fi-traffic {
    flex-direction: row;
    margin-left: 8px;
}
.fm-fi-macro-cards {
    flex-direction: row;
    margin-bottom: 16px;
    flex-wrap: wrap;
}
.fm-fi-macro-card {
    flex-grow: 1;
    flex-basis: 22%;
    padding: 12px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 12px;
    background-color: rgb(var(--appui-backgrounds-200));
    flex-direction: column;
    align-items: center;
}
.fm-fi-macro-card__value {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 4px;
}
.fm-fi-macro-card__label {
    color: rgb(var(--appui-texts-secondary));
    text-align: center;
}
.fm-fi-sections {
    flex-direction: column;
}
.fm-fi-section {
    margin-bottom: 16px;
}
.fm-fi-section-header {
    margin-bottom: 8px;
}
.fm-fi-section-body {
    color: rgb(var(--appui-texts-primary));
    font-size: var(--appui-font-sizes-body-md);
    white-space: normal;
}
.fm-fi-nutrition-table {
    flex-direction: column;
}
.fm-fi-nutrition-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 0;
    border-bottom: 1px solid rgb(var(--appui-borders-100));
}
.fm-fi-nutrition-row__label {
    color: rgb(var(--appui-texts-primary));
}
.fm-fi-nutrition-row__value {
    color: rgb(var(--appui-texts-secondary));
}
.fm-fi-action {
    margin-top: 16px;
    flex-grow: 1;
}
.fm-fi-action.hidden {
    display: none;
}
.fm-fi-score-badge--a, .fm-fi-nutriscore.fm-fi-score-badge--a { background-color: #008b3a; }
.fm-fi-score-badge--b, .fm-fi-nutriscore.fm-fi-score-badge--b { background-color: #7fc241; }
.fm-fi-score-badge--c, .fm-fi-nutriscore.fm-fi-score-badge--c { background-color: #ffa700; }
.fm-fi-score-badge--d, .fm-fi-nutriscore.fm-fi-score-badge--d { background-color: #ff7a00; }
.fm-fi-score-badge--e, .fm-fi-nutriscore.fm-fi-score-badge--e { background-color: #e63329; }
.fm-fi-nova-badge--1 { background-color: #008b3a; }
.fm-fi-nova-badge--2 { background-color: #7fc241; }
.fm-fi-nova-badge--3 { background-color: #ffa700; }
.fm-fi-nova-badge--4 { background-color: #e63329; }
.fm-fi-traffic-dot {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-bottom: 4px;
}
.fm-fi-traffic-dot--low { background-color: #008b3a; }
.fm-fi-traffic-dot--moderate { background-color: #ffa700; }
.fm-fi-traffic-dot--high { background-color: #e63329; }
.fm-fi-traffic-dot-container {
    margin-right: 12px;
    align-items: center;
}
.fm-fi-traffic-dot__label {
    font-size: 10px;
    color: rgb(var(--appui-texts-secondary));
}
