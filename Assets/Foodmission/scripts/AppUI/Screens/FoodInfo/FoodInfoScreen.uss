/* ============================================================
   FoodInfoScreen — Visual Redesign
   ============================================================ */

/* Root */
.fm-fi-root {
    flex-grow: 1;
    padding: 0;
    background-color: var(--fm-main-bg);
    padding-right: 20px;
    padding-left: 20px;
}

/* ── HERO HEADER ─────────────────────────────────────────── */

.fm-fi-hero {
    position: relative;
    min-height: 220px;
    margin-bottom: 0;
    align-items: center;
    overflow: hidden;
}

.fm-fi-hero-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--fm-surface-bg-transparent);
}

.fm-fi-image-container {
    width: auto;
    max-height: 560px;
    margin-left: -20px;
    margin-right: -20px;
    align-self: stretch;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    display: flex;
    margin-bottom: 16px;
}

.fm-fi-image {
    width: 100%;
    height: auto;
    align-self: stretch;
    flex-shrink: 0;
}

.fm-fi-emoji {
    font-size: var(--appui-font-sizes-display-lg, 64px);
    -unity-text-align: middle-center;
    align-self: center;
    margin-bottom: 8px;
    display: none;
}

.fm-fi-hero-content {
    flex-direction: column;
    align-items: center;
    padding: 24px 20px 16px 20px;
    width: 100%;
}

.fm-fi-food-name {
    width: 100%;
    -unity-text-align: middle-center;
    font-size: var(--appui-font-sizes-title-lg);
    -unity-font-style: bold;
    color: #ffffff;
    white-space: normal;
    margin-bottom: 4px;
    padding-bottom: 0;
}

.fm-fi-food-subtitle {
    width: 100%;
    -unity-text-align: middle-center;
    color: var(--appui-foregrounds-50);
    font-size: var(--appui-font-sizes-body-md);
    white-space: normal;
    margin-bottom: 8px;
}

/* ── SCORES STRIP ────────────────────────────────────────── */

.fm-fi-scores-strip {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    padding: 16px 12px;
    background-color: var(--fm-surface-bg-transparent);
    margin-bottom: 8px;
    flex-wrap: wrap;
    width: 100%;
}

.fm-fi-score-pill {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 12px;
    margin-right: 12px;
    min-width: 72px;
}

.fm-fi-score-pill__badge {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: #ffffff;
    font-size: var(--appui-font-sizes-title-md);
    margin-bottom: 6px;
    display: flex;
}

.fm-fi-score-pill__label {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-50);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

/* Nutri-Score colors */
.fm-fi-score-badge--a { background-color: #008b3a; }
.fm-fi-score-badge--b { background-color: #85BB2F; }
.fm-fi-score-badge--c { background-color: #FECB02; color: #1A1A1A; }
.fm-fi-score-badge--d { background-color: #EE8100; }
.fm-fi-score-badge--e { background-color: #E63329; }
.fm-fi-score-badge--unknown { background-color: #4A4A4A; color: #CCCCCC; }

/* NOVA colors */
.fm-fi-nova-badge--1 { background-color: #008b3a; }
.fm-fi-nova-badge--2 { background-color: #85BB2F; }
.fm-fi-nova-badge--3 { background-color: #EE8100; }
.fm-fi-nova-badge--4 { background-color: #E63329; }
.fm-fi-nova-badge--unknown { background-color: #4A4A4A; color: #CCCCCC; }

/* Eco-Score colors */
.fm-fi-eco-badge--a { background-color: #008b3a; }
.fm-fi-eco-badge--b { background-color: #85BB2F; }
.fm-fi-eco-badge--c { background-color: #FECB02; color: #1A1A1A; }
.fm-fi-eco-badge--d { background-color: #EE8100; }
.fm-fi-eco-badge--e { background-color: #E63329; }
.fm-fi-eco-badge--unknown { background-color: #4A4A4A; color: #CCCCCC; }

.fm-fi-badges-row {
    display: none;
}

/* ── TRAFFIC LIGHTS ──────────────────────────────────────── */

.fm-fi-traffic-strip {
    flex-direction: row;
    justify-content: center;
    padding: 12px 16px 4px 16px;
    flex-wrap: wrap;
}

.fm-fi-traffic {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.fm-fi-traffic-dot-container {
    flex-direction: column;
    align-items: center;
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 8px;
}

.fm-fi-traffic-pill {
    flex-direction: row;
    align-items: center;
    border-radius: 12px;
    padding-left: 10px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.08);
}

.fm-fi-traffic-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 6px;
    flex-shrink: 0;
}

.fm-fi-traffic-dot--low      { background-color: #2ecc71; }
.fm-fi-traffic-dot--moderate { background-color: #f39c12; }
.fm-fi-traffic-dot--high     { background-color: #e74c3c; }
.fm-fi-traffic-dot--unknown  { background-color: rgba(128,128,128,0.5); }

.fm-fi-traffic-dot__label {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-50);
    white-space: nowrap;
}

/* ── CONTENT AREA ────────────────────────────────────────── */

.fm-fi-content {
    flex-direction: column;
    padding: 16px 16px 0 16px;
}

/* ── MACRO CARDS ─────────────────────────────────────────── */

.fm-fi-macro-header {
    font-size: var(--appui-font-sizes-body-sm);
    /*opacity: 0.6;*/
    margin-left: 6px;
    margin-bottom: 6px;
}

.fm-fi-macro-cards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 20px;
    width: 100%;
}

.fm-fi-macro-card {
    flex-grow: 1;
    flex-basis: 44%;
    padding: 16px 12px;
    margin: 4px;
    border-radius: 16px;
    background-color: var(--fm-surface-bg-transparent);
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.fm-fi-macro-card__icon {
    font-size: var(--appui-font-sizes-title-md);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.fm-fi-macro-card__value {
    font-size: var(--appui-font-sizes-body-lg);
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-bottom: 4px;
}

.fm-fi-macro-card__label {
    color: var(--appui-foregrounds-50);
    font-size: var(--appui-font-sizes-body-sm);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ── SECTION COMMON ──────────────────────────────────────── */

.fm-fi-section {
    margin-top: 12px;
    margin-bottom: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    padding-top: 16px;
    padding-bottom: 8px;
}

.fm-fi-section-header {
    font-size: var(--appui-font-sizes-title-sm);
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 12px;
}

.fm-fi-section-body {
    color: var(--appui-foregrounds-70, #c0c0c0);
    font-size: var(--appui-font-sizes-body-md);
    white-space: normal;
    line-height: 1.4;
}

/* ── NUTRITION TABLE ─────────────────────────────────────── */

.fm-fi-nutrition-table {
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: var(--fm-surface-bg-transparent);
}

.fm-fi-nutrition-group-title {
    -unity-font-style: bold;
    padding: 10px 16px 6px 16px;
    font-size: var(--appui-font-sizes-body-sm);
    background-color: var(--fm-surface-bg-transparent);
    color: var(--appui-foregrounds-50);
    letter-spacing: 0.5px;
}

.fm-fi-nutrition-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

/* Zebra striping handled in C# via even/odd class */
.fm-fi-nutrition-row--odd {
    background-color: rgba(255, 255, 255, 0.03);
}

.fm-fi-nutrition-row__label {
    color: var(--appui-foregrounds-70, #b0b0b0);
    font-size: var(--appui-font-sizes-body-md);
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 12px;
    white-space: normal;
}

.fm-fi-nutrition-row__value {
    font-size: var(--appui-font-sizes-body-md);
    color: #ffffff;
    -unity-font-style: bold;
    flex-shrink: 0;
    white-space: nowrap;
    -unity-text-align: middle-right;
}

/* ── META ROWS ───────────────────────────────────────────── */

.fm-fi-meta-body {
    flex-direction: column;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: var(--fm-surface-bg-transparent);
}

.fm-fi-meta-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    overflow: hidden;
}

.fm-fi-meta-row--first {
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}

.fm-fi-meta-row--last {
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.fm-fi-meta-row--odd {
    background-color: rgba(255, 255, 255, 0.03);
}

.fm-fi-meta-row__label {
    color: var(--appui-foregrounds-70, #b0b0b0);
    font-size: var(--appui-font-sizes-body-md);
    flex-shrink: 0;
    white-space: nowrap;
    margin-right: 12px;
}

.fm-fi-meta-row__value {
    font-size: var(--appui-font-sizes-body-md);
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── ACTION BUTTON ───────────────────────────────────────── */

.fm-fi-action-container {
    padding: 20px 16px 32px 16px;
}

.fm-fi-action-container.hidden {
    display: none;
}

.fm-fi-action {
    width: 100%;
    height: 50px;
    border-radius: 14px;
}

.fm-fi-action.hidden {
    display: none;
}

/* ── MULTI-ACTION GROUP (responsive vertical layout) ────── */

.fm-fi-multi-action-container {
    flex-direction: column;
    width: 100%;
}

.fm-fi-multi-action-container.hidden {
    display: none;
}
