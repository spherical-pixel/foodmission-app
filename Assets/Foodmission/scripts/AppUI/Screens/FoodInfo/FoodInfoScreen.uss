/* ── VISIBILITY HELPERS ─────────────────────────────────── */

.fm-fi-section--hidden {
    display: none;
}

/* ── SCROLL PADDING ──────────────────────────────────────── */

.fm-fi-scroll-bottom-padding {
    height: 16px;
}
