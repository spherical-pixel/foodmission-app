<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform.Components" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <ui:VisualElement name="back" data-source-type="eu.foodmission.platform.GroupsViewModel, Foodmission" class="fm-back-screen-transparent" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0;"/>
    <ui:VisualElement name="root" data-source-type="eu.foodmission.platform.GroupsViewModel, Foodmission" class="fm-root">
        <ui:VisualElement name="header" class="fm-grp-header" style="margin-top: 20px; padding-left: 40px; padding-right: 40px;">
            <appui:Heading name="screen-title" size="L" text="Groups">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(7590950986000)"/>
                </Bindings>
            </appui:Heading>
        </ui:VisualElement>
        <eu:FMSearchOrCreateField name="search-or-create-field">
            <Bindings>
                <ui:DataBinding property="TextFieldValue" data-source-path="SearchText" binding-mode="TwoWay"/>
            </Bindings>
        </eu:FMSearchOrCreateField>
        <appui:Spacer spacing="XL"/>
        <appui:Text name="empty-state" text="No groups yet." class="fm-grp-empty" style="margin-bottom: 8px; margin-top: 20px; padding-left: 40px; padding-right: 40px;">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(7590950986001)"/>
            </Bindings>
        </appui:Text>
        <ui:ScrollView name="scroll-view" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="fm-sl-scroll">
            <ui:VisualElement name="groups-container" class="fm-sl-container"/>
        </ui:ScrollView>
        <appui:Spacer spacing="XL"/>
        <appui:Button name="btn-fab" title="Create Group" variant="Accent" size="L" class="fm-grp-fab fm-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(7590950986006)"/>
            </Bindings>
        </appui:Button>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
