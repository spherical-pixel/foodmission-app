<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:fm="eu.foodmission.platform.Components" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/AppUI/Styles/Components/FMStepProgressBar.uss"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Base/StepFlowScreen.uss"/>
    
    <ui:VisualElement name="root" class="fm-root fm-step-flow">
        <!-- Progress bar container (fixed) -->
        <fm:FMStepProgressBar name="step-progress" class="fm-step-flow__progress" />
        
        <!-- Companion Slot (fixed, for Nutri mascot etc) -->
        <ui:VisualElement name="companion-slot" class="fm-step-flow__companion" style="display: none;" />
        
        <!-- Swipe View (dynamic swipe container) -->
        <appui:SwipeView name="step-swipeview" direction="Horizontal" class="fm-step-flow__swipeview" />
        
        <!-- Button Row (fixed) -->
        <ui:VisualElement class="fm-step-flow__buttons">
            <fm:FMButton name="btn-previous" title="Back" variant="Default" size="L" class="fm-step-flow__btn-back fm-button fm-button-shadow" />
            <fm:FMButton name="btn-next" title="Next" variant="Accent" size="L" class="fm-step-flow__btn-next fm-button fm-button-shadow" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
