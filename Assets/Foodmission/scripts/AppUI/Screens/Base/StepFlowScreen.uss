/* Root step flow layout */
.fm-step-flow {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    /*background-color: var(--fm-main-bg, transparent);*/
    background-color: transparent;
}

/* Progress bar alignment */
.fm-step-flow__progress {
    flex-grow: 0;
    flex-shrink: 0;
}

/* Companion Slot (e.g. Nutri Pet dialog) styling */
.fm-step-flow__companion {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 12px;
}

/* SwipeView container occupying the main screen space */
.fm-step-flow__swipeview {
    flex-grow: 1;
    width: 100%;
    height: auto;
}

/* SwipeViewItem styling to ensure inner views fill correctly */
.appui-swipeview-item {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 16px 24px;
}

/* Bottom navigation buttons layout */
.fm-step-flow__buttons {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
}

.fm-step-flow__btn-back {
    flex-grow: 1;
    margin-right: 8px;
}

.fm-step-flow__btn-next {
    flex-grow: 1;
    margin-left: 8px;
}

.fm-step-flow__guide-nutri {
    margin-top: -120px;
    margin-bottom: 25px;
    height: 800px;
}

/* Guide Card within companion slot */
.fm-step-flow__guide-card {
    background-color: var(--fm-surface-bg);
    padding: 35px;
    margin-top: 25px;
    margin-bottom: 25px;
    min-height: 200px;   
    opacity: 0;
    translate: 0 10px;
    scale: 0.95;
    transition-property: opacity, translate, scale;
    transition-duration: 250ms, 250ms, 250ms;
    transition-timing-function: ease-out, ease-out, ease-out;
}

/* Visible status (in animation) */
.fm-step-flow__guide-card--visible {
    opacity: 1;
    translate: 0 0;
    scale: 1;
}
/* Exit status (quick transition to change the message) */
.fm-step-flow__guide-card--exit {
    opacity: 0;
    translate: 0 -6px;
    scale: 0.97;
    transition-duration: 150ms, 150ms, 150ms;
    transition-timing-function: ease-in, ease-in, ease-in;
}

