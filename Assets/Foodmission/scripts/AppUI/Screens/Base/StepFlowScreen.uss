.fm-step-flow {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: transparent;
}

.fm-step-flow__progress {
    flex-grow: 0;
    flex-shrink: 0;
}

.fm-step-flow__body-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
}

.fm-step-flow__body-scroll > .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
}

.fm-step-flow__body-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
    min-height: 100%;
}

.fm-step-flow__companion {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 12px;
}

.fm-step-flow__swipeview {
    flex-grow: 1;
    flex-shrink: 0;
    /* align-items: stretch; */
    height: 100%;   
    width: 100%;
}

.appui-swipeview-item {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    /* align-items: stretch; */
}

.fm-step-flow__buttons {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
}

.fm-step-flow__btn-back {
    flex-grow: 1;
    margin-right: 8px;
}

.fm-step-flow__btn-next {
    flex-grow: 1;
    margin-left: 8px;
}

.fm-step-flow__guide-nutri {
    margin-top: -120px;
    margin-bottom: 25px;
    height: 800px;
}

.fm-step-flow__guide-card {
    background-color: var(--fm-surface-bg);
    padding: 40px;
    margin-top: 12px;
    margin-bottom: 12px;
    opacity: 0;
    translate: 0 10px;
    scale: 0.95;
    transition-property: opacity, translate, scale;
    transition-duration: 250ms, 250ms, 250ms;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.fm-step-flow__guide-card .appui-text {
    color: var(--appui-foregrounds-50);
}

.fm-step-flow__guide-card--visible {
    opacity: 1;
    translate: 0 0;
    scale: 1;
}

.fm-step-flow__guide-card--exit {
    opacity: 0;
    translate: 0 -6px;
    scale: 0.97;
    transition-duration: 150ms, 150ms, 150ms;
    transition-timing-function: ease-in, ease-in, ease-in;
}
