<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform.Components"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="FoodWasteScreen.uss"/>
    <ui:VisualElement name="back" class="fm-back-screen-transparent fm-fw-back"/>
    <ui:VisualElement name="root" class="fm-root">
        <eu:FMPantryPickerField name="pantry-search"/>
        <ui:VisualElement name="main-content" class="fm-fw-main">
            <ui:VisualElement name="expired-section" class="fm-fw-section">
                <ui:VisualElement class="fm-fw-section-header-row">
                    <appui:Text name="expired-title" text="" class="fm-fw-section-title"/>
                    <appui:Button name="btn-move-all-to-waste" title="@UI:MOVE_TO_WASTE" variant="Destructive" size="S"/>
                </ui:VisualElement>
                <ui:VisualElement name="expired-container" class="fm-fw-container"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-fw-section-header-row">
                <appui:Text name="history-title" text="" class="fm-fw-section-title"/>
                <eu:FMArrowStepper name="month-stepper" cyclic="false" class="fm-fw-month-stepper"/>
            </ui:VisualElement>
            <appui:Text name="empty-state" text="" class="fm-fw-empty"/>
            <ui:ScrollView name="scroll-view" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="fm-fw-scroll">
                <ui:VisualElement name="history-container" class="fm-fw-container"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
