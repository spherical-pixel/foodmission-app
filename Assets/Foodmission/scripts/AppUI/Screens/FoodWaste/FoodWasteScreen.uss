.fm-fw-root {
    flex-grow: 1;
    padding: 16px;
}
.fm-fw-header {
    margin-bottom: 12px;
}
.fm-fw-spinner {
    align-self: center;
    display: none;
}
.fm-fw-spinner.visible {
    display: flex;
}
.fm-fw-error {
    color: rgb(var(--fm-color-error));
    display: none;
    margin-bottom: 8px;
}
.fm-fw-error.visible {
    display: flex;
}
.fm-fw-empty {
    color: rgb(var(--fm-color-text-secondary));
    display: none;
    margin-top: 24px;
    text-align: center;
}
.fm-fw-empty.visible {
    display: flex;
}
.fm-fw-scroll {
    flex-grow: 1;
}
.fm-fw-container {
    flex-grow: 1;
}
.fm-fw-fab {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 48px;
    height: 48px;
    font-size: 24px;
}
.fm-fw-section-header {
    font-size: 14px;
    font-weight: bold;
    color: rgb(var(--fm-color-text-secondary));
    margin-top: 16px;
    margin-bottom: 4px;
    text-transform: uppercase;
}
.fm-fw-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgb(var(--fm-color-border));
}
.fm-fw-row:active {
    background-color: rgb(var(--fm-color-surface-pressed));
}
.fm-fw-row-info {
    flex-grow: 1;
}
.fm-fw-row-name {
    font-size: 16px;
}
.fm-fw-row-detail {
    font-size: 12px;
    color: rgb(var(--fm-color-text-secondary));
}
.fm-fw-row-badge {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 8px;
}
.fm-fw-row-badge--carbon {
    background-color: rgb(var(--fm-color-success));
    color: white;
}
.fm-fw-row-badge--cost {
    background-color: rgb(var(--fm-color-warning));
    color: white;
}
