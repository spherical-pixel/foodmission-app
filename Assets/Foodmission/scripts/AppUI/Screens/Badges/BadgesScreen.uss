.fm-badges-root {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 100%;
    width: 100%;
}

.fm-badges-header {
    margin-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.fm-badges-summary {
    margin-top: 4px;
    color: var(--appui-foregrounds-50);
}

.fm-badges-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.fm-badge-card {
    width: 48%;
    margin-bottom: 12px;
    padding: 12px;
    align-items: center;
    border-radius: 16px;
    background-color: var(--appui-backgrounds-200);
    flex-shrink: 0;
}

.fm-badge-card__image {
    width: 96px;
    height: 96px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.fm-badge-card__name {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.fm-badge-card__description {
    margin-top: 4px;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--appui-foregrounds-50);
}

.fm-badge-card__meta {
    margin-top: 6px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--appui-foregrounds-50);
}

.fm-badge-card__progress {
    margin-top: 8px;
    width: 100%;
}

.fm-badge-card--locked .fm-badge-card__name {
    color: var(--appui-foregrounds-50);
}

.hidden {
    display: none;
}
