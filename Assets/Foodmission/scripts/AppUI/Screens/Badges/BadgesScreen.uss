.fm-badges-root {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 100%;
    width: 100%;
}

.fm-badges-header {
    margin-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.fm-badges-summary {
    margin-top: 4px;
    color: var(--appui-foregrounds-100);
}

.fm-badges-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 16px;
    flex-shrink: 0;
}

.fm-badge-card {
    width: 48%;
    margin-bottom: 12px;
    padding: 12px;
    align-items: center;
    border-radius: 16px;
    flex-shrink: 0;
}

.fm-badge-card__image {
    width: 456px;
    height: 456px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.fm-badge-card__fallback {
    font-size: 96px;
    -unity-text-align: middle-center;
}

.fm-badge-card__name {
    color: var(--appui-foregrounds-200);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 10px;
    width: 100%;

}

.fm-badge-card__description {
    margin-top: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--appui-foregrounds-100);
    min-height: 80px;
    margin-bottom: 8px;
}

.fm-badge-card__meta {
    margin-top: 6px;
    -unity-text-align: middle-center;
    color: var(--appui-foregrounds-100);
}

/* Visuals come from the drawer's .fm-xp-progress; undo its drawer-only margins (badge overlap). */
.fm-xp-progress.fm-badge-card__progress {
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 0;
    width: 100%;
}

.fm-badge-card--locked .fm-badge-card__name {
    color: var(--appui-foregrounds-100);
}

.hidden {
    display: none;
}
