<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform.Components" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/ShoppingList/ShoppingListDetailScreen.uss?fileID=7433441132597879392&amp;guid=6ebae1d8d5f994dbcb9fb17766ba25d0&amp;type=3#ShoppingListDetailScreen"/>
    <ui:VisualElement name="back" data-source-type="eu.foodmission.platform.ShoppingListViewModel, Foodmission" class="fm-back-screen-transparent"/>
    <ui:VisualElement name="root" data-source-type="eu.foodmission.platform.ShoppingListDetailViewModel, Foodmission" class="fm-root">
        <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 20px; padding-left: 40px; padding-right: 40px;">
            <appui:Heading name="list-title" text="Nombre de la lista" size="L" style="margin-top: 0; margin-bottom: 0;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="ListName" binding-mode="ToTarget"/>
                </Bindings>
            </appui:Heading>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row-reverse; flex-shrink: 0;">
                <appui:ActionGroup compact="true" quiet="true">
                    <appui:ActionButton name="change-list-button" label="hkjkhj">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(26661509051441152)"/>
                        </Bindings>
                    </appui:ActionButton>
                    <appui:ActionButton name="reset-list-button" label="uuu">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(26664711310270464)"/>
                        </Bindings>
                    </appui:ActionButton>
                </appui:ActionGroup>
            </ui:VisualElement>
        </ui:VisualElement>
        <appui:Text text="What do you want to add to the list?" style="margin-bottom: 8px; margin-top: 20px; padding-left: 40px; padding-right: 40px;">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(26666342005334016)"/>
            </Bindings>
        </appui:Text>
        <eu:FMSearchOrCategoryField name="search-category-field">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="Placeholder" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(26308484147437568)"/>
            </Bindings>
        </eu:FMSearchOrCategoryField>
        <ui:VisualElement name="auto-add-checkbox-container" class="fm-sld-action-bar" style="margin-bottom: 24px; margin-top: 14px;">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <appui:Checkbox name="auto-add-pantry-checkbox"/>
                <appui:Text name="auto-add-label" text="Add to pantry" class="fm-sld-auto-add-label">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(26664242240282624)"/>
                    </Bindings>
                </appui:Text>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="main-content" style="flex-grow: 1;">
            <appui:Text name="empty-state" text="No items yet. Tap + to add items." size="L" class="fm-sld-empty">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000033)"/>
                </Bindings>
            </appui:Text>
            <ui:ScrollView name="scroll-view" class="fm-sl-scroll">
                <ui:VisualElement name="items-container" class="fm-sl-container"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
