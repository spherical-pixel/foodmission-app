<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="ShoppingListDetailScreen.uss"/>

    <ui:VisualElement name="root" class="fm-sld-root fm-plain-background">

        <ui:VisualElement name="toolbar" class="fm-sld-toolbar">
            <appui:Heading name="list-title" size="M" text="Shopping List" class="fm-sld-title">
    <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000031)"/>
                </Bindings>
</appui:Heading>
            <appui:Text name="progress-label" class="fm-sld-progress"/>
            <appui:Button name="btn-clear-checked" title="Clear done" size="S">
    <Bindings>
                    <UnityEngine.Localization.LocalizedString property="title" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000032)"/>
                </Bindings>
</appui:Button>
        </ui:VisualElement>

        <appui:Text name="error-message" class="fm-sl-error"/>

        <appui:TextField name="filter-field" placeholder="Filter items..." class="fm-sld-filter"/>
        <appui:Text name="empty-state" text="No items yet. Tap + to add items." class="fm-sld-empty">
    <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:e58ac225f892840658d216244603ef45" entry="Id(41000000000000033)"/>
                </Bindings>
</appui:Text>
        <ui:ScrollView name="scroll-view" class="fm-sl-scroll">
            <ui:VisualElement name="items-container" class="fm-sl-container"/>
        </ui:ScrollView>

        <appui:Button name="btn-add" title="Add item" variant="Accent" size="L" class="fm-sld-fab fm-button"/>

    </ui:VisualElement>
</ui:UXML>
