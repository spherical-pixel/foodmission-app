<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:fm="eu.foodmission.platform.Components" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Challenges/ChallengeDetailScreen.uss?fileID=7433441132597879392&amp;guid=17cbdd9d948654662b487a103b5a8dd4&amp;type=3#ChallengeDetailScreen"/>
    <ui:VisualElement name="root" class="fm-root fm-challenge-root">
        <fm:FMNutriView name="nutri-view" class="fm-home-nutri-image fm-challenge-nutri"/>
        <appui:ExVisualElement name="challenge-card" class="box-background fm-shadow-wrapper fm-challenge-card">
            <appui:Text name="challenge-level-badge" text="" size="S" class="fm-challenge-badge"/>
            <appui:Heading name="challenge-title" text="" size="M" class="fm-challenge-title"/>
            <appui:Text name="challenge-task" text="" size="L" class="fm-challenge-task"/>
            <ui:VisualElement class="fm-challenge-why-box">
                <appui:Text text="@UI:CHALLENGE_WHY_TITLE" size="M" class="fm-challenge-why-title"/>
                <appui:Text name="challenge-why-it-matters" text="" size="M" class="fm-challenge-why-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="challenge-actions" class="fm-challenge-actions">
                <appui:Text name="challenge-auto-hint" text="@UI:CHALLENGE_HINT_AUTO" size="S" class="fm-challenge-hint"/>
                <fm:FMButton name="btn-helper-module" title="" variant="Accent" size="L" trailing-icon="fm-arrow-right" class="fm-challenge-btn fm-button fm-button-align-left"/>
                <appui:Spacer/>
                <fm:FMButton name="btn-mark-done" title="@UI:CHALLENGE_BTN_DONE" variant="Accent" size="L" trailing-icon="fm-arrow-right" class="fm-challenge-btn fm-button-align-left fm-button"/>
                <appui:Spacer/>
                <fm:FMButton name="btn-later" title="@UI:CHALLENGE_BTN_LATER" variant="Secondary" size="L" trailing-icon="fm-arrow-right" class="fm-challenge-btn fm-button fm-button-align-left"/>
                <appui:Spacer/>
            </ui:VisualElement>
            <ui:VisualElement name="challenge-completed-box" class="fm-challenge-completed">
                <appui:Text text="@UI:CHALLENGE_COMPLETED_BADGE" size="M" class="fm-challenge-completed-badge"/>
            </ui:VisualElement>
        </appui:ExVisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
