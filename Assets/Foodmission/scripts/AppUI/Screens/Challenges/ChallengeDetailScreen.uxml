<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:eu="eu.foodmission.platform.Components" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Quests/QuestDetailScreen.uss?fileID=7433441132597879392&amp;guid=5821b2fde381647d297af73b5ef1cbff&amp;type=3#QuestDetailScreen"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Challenges/ChallengeDetailScreen.uss?fileID=7433441132597879392&amp;guid=17cbdd9d948654662b487a103b5a8dd4&amp;type=3#ChallengeDetailScreen"/>
    <ui:VisualElement name="root" class="fm-root fm-activity-detail-root">
        <ui:VisualElement name="card" class="fm-quest-detail-card fm-activity-detail-card">
            <ui:VisualElement class="fm-activity-header-badges">
                <appui:Text name="challenge-level-badge" text="BEGINNER" size="S" class="fm-activity-badge"/>
            </ui:VisualElement>
            <appui:Text name="challenge-title" text="" size="XXL" class="fm-quest-detail-title fm-activity-title"/>
            <ui:VisualElement name="banner-container" class="fm-quest-detail-banner-container">
                <ui:Image name="image-dimension-banner" class="fm-quizzes-dim-icon fm-quest-detail-banner-image"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-activity-section">
                <appui:Text text="🏆 Reto" size="L" class="fm-activity-section-title"/>
                <appui:Text name="challenge-goal" text="" size="L" class="fm-quest-detail-desc"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-activity-section">
                <appui:Text text="💡 Por qué importa" size="L" class="fm-activity-section-title"/>
                <appui:Text name="challenge-why-it-matters" text="" size="L" class="fm-quest-detail-desc fm-activity-why-text"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-activity-progress-card">
                <ui:VisualElement class="fm-activity-progress-header">
                    <appui:Text text="Estado del reto" size="M" class="fm-activity-progress-title"/>
                    <appui:Text name="challenge-progress-label" text="0%" size="M" class="fm-activity-progress-pct"/>
                </ui:VisualElement>
                <ui:VisualElement class="fm-activity-progress-track">
                    <ui:VisualElement name="challenge-progress-fill" class="fm-activity-progress-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="challenge-action-box" class="fm-activity-action-box">
                <appui:Text name="native-module-hint" text="Registra esta acción usando las herramientas de Foodmission para completar el reto automáticamente." size="M" class="fm-activity-tab-desc"/>
                <eu:FMButton name="btn-go-module" title="Ir al módulo" variant="Accent" size="L" class="fm-activity-action-btn"/>
            </ui:VisualElement>
            <ui:VisualElement name="challenge-completed-box" class="fm-activity-completed-box" style="display: none;">
                <ui:VisualElement class="fm-activity-completed-badge-row">
                    <appui:Text text="RETO COMPLETADO" size="M" class="fm-activity-completed-badge"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
