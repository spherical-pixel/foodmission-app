.hidden {
    display: none;
}

.fm-challenge-root {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-height: 100%;
    height: auto;
    align-items: stretch;
}

.fm-challenge-nutri {
    height: 720px;
    margin-bottom: 0;
    flex-shrink: 0;
}

.fm-challenge-card {
    background-color: var(--fm-surface-bg-transparent-80);
    border-radius: 44px;
    padding: 35px;
    margin: 0 16px 16px 16px;
    align-items: stretch;
    height: auto;
    flex-grow: 0;
    flex-shrink: 0;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.fm-challenge-card--entering {
    translate: 0 120px;
    opacity: 0;
    transition-duration: 0s;
}

.fm-challenge-badge {
    align-self: center;
    border-radius: 32px;
    padding: 12px 25px;
    background-color: var(--fm-surface-bg);
    color: var(--appui-primary-100);
    -unity-font-style: bold;
    margin-bottom: 20px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.fm-challenge-title {
    color: var(--appui-foregrounds-50);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.fm-challenge-task {
    color: var(--appui-foregrounds-50);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.fm-challenge-why-box {
    background-color: var(--fm-surface-bg);
    border-radius: 32px;
    padding: 25px;
    margin-bottom: 24px;
    height: auto;
    flex-shrink: 0;
}

.fm-challenge-why-title {
    color: var(--appui-primary-100);
    -unity-font-style: bold;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.fm-challenge-why-text {
    color: var(--appui-foregrounds-50);
    white-space: normal;
    flex-shrink: 0;
}

.fm-challenge-actions {
    align-items: stretch;
    flex-shrink: 0;
    flex-grow: 0;
    height: auto;
}

.fm-challenge-hint {
    color: var(--appui-foregrounds-200);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.fm-challenge-btn {
    width: 100%;
    margin-top: 10px;
    flex-shrink: 0;
}

.fm-challenge-completed {
    align-items: center;
    margin-top: 10px;
    flex-shrink: 0;
}

.fm-challenge-completed-badge {
    border-radius: 32px;
    padding: 25px 35px;
    background-color: rgb(0, 139, 58);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    flex-shrink: 0;
    width: 100%;
}

.fm-challenge-root .fm-bottom-nav-padding {
    flex-shrink: 0;
}
