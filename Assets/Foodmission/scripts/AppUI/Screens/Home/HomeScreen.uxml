<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>

    <ui:ScrollView name="root" data-source-type="eu.foodmission.platform.HomeScreenViewModel, Foodmission" style="flex-grow: 1;">

        <!-- Nutri + status label -->
        <ui:Image name="nutri-render" source="project://database/Assets/Foodmission/RenderTextures/NutriRenderTexture.renderTexture?fileID=8400000&amp;guid=70b891fe7178443c7b15210d9bd22e0e&amp;type=2#NutriRenderTexture" class="fm-home-nutri-image"/>
        <ui:Label text="Your nutritional intelligence status" class="fm-home-nutri-label"/>

        <!-- Status Bars: icon + label + progress in one row each -->
        <ui:VisualElement class="fm-home-status-bars">
            <ui:VisualElement class="fm-status-row">
                <ui:Label text="❤️" class="fm-status-icon"/>
                <ui:Label text="Health" class="fm-status-label"/>
                <appui:LinearProgress name="health-progress" class="fm-status-progress"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-status-row">
                <ui:Label text="🌍" class="fm-status-icon"/>
                <ui:Label text="Sustainability" class="fm-status-label"/>
                <appui:LinearProgress name="sustainability-progress" class="fm-status-progress"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-status-row">
                <ui:Label text="🧠" class="fm-status-icon"/>
                <ui:Label text="Knowledge" class="fm-status-label"/>
                <appui:LinearProgress name="knowledge-progress" class="fm-status-progress"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Simple selectors row: ◄ Today ►   ◄ Me ► -->
        <ui:VisualElement class="fm-home-selectors-row">
            <ui:VisualElement class="fm-simple-stepper">
                <appui:IconButton name="btn-prev-period" icon="caret-left" quiet="true"/>
                <ui:Label name="label-period" text="Today" class="fm-stepper-value"/>
                <appui:IconButton name="btn-next-period" icon="caret-right" quiet="true"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-simple-stepper">
                <appui:IconButton name="btn-prev-scope" icon="caret-left" quiet="true"/>
                <ui:Label name="label-scope" text="Me" class="fm-stepper-value"/>
                <appui:IconButton name="btn-next-scope" icon="caret-right" quiet="true"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Calories card with circular progress -->
        <ui:VisualElement class="fm-calories-card">
            <!-- Card type selector: ◄ Calories ► -->
            <ui:VisualElement class="fm-simple-stepper">
                <appui:IconButton name="btn-prev-card" icon="caret-left" quiet="true"/>
                <ui:Label name="label-card-type" text="Calories" class="fm-stepper-value"/>
                <appui:IconButton name="btn-next-card" icon="caret-right" quiet="true"/>
            </ui:VisualElement>

            <!-- Circular progress + stats overlay -->
            <ui:VisualElement class="fm-calories-circle-wrapper">
                <appui:CircularProgress name="calories-circular" class="fm-calories-circular"/>
                <ui:VisualElement class="fm-calories-center">
                    <ui:Label text="Calories consumed" class="fm-calories-consumed-label"/>
                    <ui:Label name="calories-consumed" text="0" class="fm-calories-big-number"/>
                    <ui:Label text="Left" class="fm-calories-left-label"/>
                    <ui:Label name="calories-left" text="0" class="fm-calories-left-number"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:ScrollView>
</ui:UXML>
