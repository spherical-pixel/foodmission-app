.fm-missions-root {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.fm-missions-header-section {
    margin-bottom: 12px;
    flex-shrink: 0;
}

.fm-missions-filters-container {
    display: flex;
    flex-direction: column;
    margin-bottom: 12px;
}

.fm-missions-action-group {
    width: 100%;
    margin-bottom: 8px;
}

.fm-missions-empty {
    margin-top: 32px;
    -unity-text-align: middle-center;
    color: var(--appui-foreground-muted, rgb(107, 114, 128));
    display: none;
}

.fm-missions-scroll {
    flex-grow: 1;
}

.fm-missions-groups-container {
    display: flex;
    flex-direction: column;
    padding-bottom: 24px;
}

/* =========================================================================
   MISSION ITEM LAYOUT & DISTRIBUTION
   ========================================================================= */

.fm-mission-item {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    margin-bottom: 10px;
    background-color: var(--appui-backgrounds-200);
    border-radius: 12px;
}

.fm-mission-item-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.fm-mission-titles-container {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 14px;
}

.fm-mission-item-title {
    -unity-font-style: bold;
    color: var(--appui-foregrounds-50);
    white-space: normal;
}

.fm-mission-item-duration {
    color: var(--appui-foreground-muted, rgb(107, 114, 128));
}

.fm-mission-item-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
}

.fm-mission-item-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    flex-shrink: 0;
}

.fm-mission-item-badges .fm-quiz-level-badge {
    margin-right: 0;
    margin-bottom: 4px;
    align-self: flex-end;
}

.fm-mission-item-badges .fm-quiz-status-badge {
    margin-right: 0;
    align-self: flex-end;
}

.fm-mission-item-badges .fm-quiz-level-badge-text,
.fm-mission-item-badges .fm-quiz-status-badge-text {
    white-space: nowrap;
}

.fm-mission-item-arrow {
    flex-shrink: 0;
    align-self: center;
    margin-left: 12px;
}
