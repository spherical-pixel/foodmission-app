<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:fm="eu.foodmission.platform.Components" editor-extension-mode="False">
    <Style src="project://database/Assets/Foodmission/AppUI/Foodmission_Global_Styles.uss?fileID=7433441132597879392&amp;guid=86346275682b4470483ba900372b6b10&amp;type=3#Foodmission_Global_Styles"/>
    <Style src="project://database/Assets/Foodmission/scripts/AppUI/Screens/Missions/MissionDetailScreen.uss?fileID=7433441132597879392&amp;guid=ae0bf96b4b97f4d49886c0d747caa382&amp;type=3#MissionDetailScreen"/>
    <ui:VisualElement name="root" class="fm-root fm-mission-root">
        <fm:FMNutriView name="nutri-view" class="fm-home-nutri-image fm-mission-nutri"/>
        <appui:ExVisualElement name="mission-card" class="box-background fm-shadow-wrapper fm-mission-card">
            <appui:Text name="mission-level-badge" text="" size="S" class="fm-mission-badge"/>
            <appui:Heading name="mission-title" text="" size="M" class="fm-mission-title"/>
            <appui:Text name="mission-goal" text="" size="L" class="fm-mission-goal"/>
            <ui:VisualElement class="fm-mission-progress-row">
                <ui:VisualElement class="fm-mission-progress-track">
                    <ui:VisualElement name="mission-progress-fill" class="fm-mission-progress-fill"/>
                </ui:VisualElement>
                <appui:Text name="mission-progress-label" text="" size="S" class="fm-mission-progress-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="fm-mission-why-box">
                <appui:Text text="@UI:CHALLENGE_WHY_TITLE" size="M" class="fm-mission-why-title"/>
                <appui:Text name="mission-why-it-matters" text="" size="M" class="fm-mission-why-text"/>
            </ui:VisualElement>
            <appui:Text name="mission-status" text="" size="M" class="fm-mission-status"/>
            <ui:VisualElement name="mission-actions" class="fm-mission-actions">
                <appui:Text name="mission-auto-hint" text="@UI:MISSION_HINT_AUTO" size="S" class="fm-mission-hint"/>
                <ui:VisualElement name="mission-auto-modules" class="fm-mission-module-list"/>
                <ui:VisualElement name="mission-helper-modules" class="fm-mission-module-list"/>
                <fm:FMButton name="btn-tell-nutri" title="@UI:MISSION_BTN_TELL_NUTRI" variant="Accent" size="L" trailing-icon="fm-arrow-right" class="fm-mission-btn fm-button fm-button-align-left"/>
                <fm:FMButton name="btn-later" title="@UI:CHALLENGE_BTN_LATER" variant="Secondary" size="L" trailing-icon="fm-arrow-right" class="fm-mission-btn fm-button fm-button-align-left"/>
                <fm:FMButton name="btn-restart-active" title="@UI:MISSION_BTN_RESTART" variant="Secondary" size="L" trailing-icon="fm-arrow-right" class="fm-mission-btn fm-button fm-button-align-left"/>
            </ui:VisualElement>
            <ui:VisualElement name="mission-completed-box" class="fm-mission-completed">
                <appui:Text text="@UI:MISSION_COMPLETED_BADGE" size="M" class="fm-mission-completed-badge"/>
            </ui:VisualElement>
            <ui:VisualElement name="mission-failed-box" class="fm-mission-failed">
                <appui:Text text="@UI:MISSION_FAILED_BADGE" size="M" class="fm-mission-failed-badge"/>
                <appui:Text name="mission-failed-text" text="@UI:MISSION_FAILED_MESSAGE" size="M" class="fm-mission-failed-text"/>
                <fm:FMButton name="btn-restart-failed" title="@UI:MISSION_BTN_RESTART" variant="Accent" size="L" trailing-icon="fm-arrow-right" class="fm-mission-btn fm-button fm-button-align-left"/>
            </ui:VisualElement>
        </appui:ExVisualElement>
        <ui:VisualElement class="fm-bottom-nav-padding"/>
    </ui:VisualElement>
</ui:UXML>
