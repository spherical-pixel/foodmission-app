.hidden {
    display: none;
}

.fm-mission-root {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-height: 100%;
    height: auto;
    align-items: stretch;
}

.fm-mission-nutri {
    height: 720px;
    margin-bottom: 0;
    flex-shrink: 0;
}

.fm-mission-card {
    background-color: var(--fm-surface-bg-transparent-80);
    border-radius: 44px;
    padding: 35px;
    margin: 0 16px 16px 16px;
    align-items: stretch;
    height: auto;
    flex-grow: 0;
    flex-shrink: 0;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.fm-mission-card--entering {
    translate: 0 120px;
    opacity: 0;
    transition-duration: 0s;
}

.fm-mission-badge {
    align-self: center;
    border-radius: 32px;
    padding: 12px 25px;
    background-color: var(--fm-surface-bg);
    color: var(--appui-primary-100);
    -unity-font-style: bold;
    margin-bottom: 20px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.fm-mission-title {
    color: var(--appui-foregrounds-50);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.fm-mission-goal {
    color: var(--appui-foregrounds-50);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.fm-mission-why-box {
    background-color: var(--fm-surface-bg);
    border-radius: 32px;
    padding: 25px;
    margin-bottom: 24px;
    height: auto;
    flex-shrink: 0;
}

.fm-mission-why-title {
    color: var(--appui-primary-100);
    -unity-font-style: bold;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.fm-mission-why-text {
    color: var(--appui-foregrounds-50);
    white-space: normal;
    flex-shrink: 0;
}

.fm-mission-actions {
    align-items: stretch;
    flex-shrink: 0;
    flex-grow: 0;
    height: auto;
}

.fm-mission-hint {
    color: var(--appui-foregrounds-200);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.fm-mission-btn {
    width: 100%;
    margin-top: 10px;
    flex-shrink: 0;
}

.fm-mission-completed {
    align-items: center;
    margin-top: 10px;
    flex-shrink: 0;
}

.fm-mission-completed-badge {
    border-radius: 32px;
    padding: 25px 35px;
    background-color: rgb(0, 139, 58);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    flex-shrink: 0;
    width: 100%;
}

.fm-mission-root .fm-bottom-nav-padding {
    flex-shrink: 0;
}

.fm-mission-progress-row {
    flex-direction: row;
    align-items: center;
    margin: 10px 15px 20px 15px;
}

.fm-mission-progress-track {
    flex-grow: 1;
    height: 16px;
    border-radius: 8px;
    background-color: var(--fm-surface-bg);
    overflow: hidden;
    margin-right: 12px;
}

.fm-mission-progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--appui-primary-100);
}

.fm-mission-progress-label {
    -unity-font-style: bold;
    white-space: nowrap;

}

.fm-mission-status {
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 12px 0;
}

.fm-mission-module-list {
    flex-shrink: 0;
}

.fm-mission-module-list > .fm-mission-btn {
    margin-bottom: 12px;
}
