<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:fm="eu.foodmission.platform.Components" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="SelectorItemAvatar" class="box-background" style="justify-content: flex-end; overflow: hidden; flex-direction: column-reverse; border-bottom-left-radius: 0; border-bottom-right-radius: 0; align-content: flex-end; margin-bottom: 0; background-color: rgb(209, 209, 209);">
