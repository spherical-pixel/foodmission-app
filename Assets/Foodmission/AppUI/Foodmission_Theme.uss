/* ============================================
   Foodmission Custom Theme
   Based on corporate green: #024639
   ============================================ */

.appui {

   
   /* Sizing */
    
    --appui-sizing-60: 21px;
    --appui-sizing-100: 25px;
    --appui-sizing-150: 29px;
    --appui-sizing-200: 35px;
    --appui-sizing-250: 41px;
    --appui-sizing-300: 48px;
    --appui-sizing-320: 51px;
    
    --appui-checkbox__box-size-md: var(--appui-sizing-500);
    /* Inner corner = radius - border width (8px), so it must be well above the border to read as rounded */
    --appui-checkbox__box-border-radius-md: 36px;
    --appui-sizing-350: 54px;
    --appui-sizing-400: 57px;
    --appui-sizing-450: 61px;
    --appui-sizing-500: 65px; /* 90*/
    --appui-sizing-550: 75px; 
    --appui-sizing-600: 86px;
    --appui-sizing-650: 100px;
    --appui-sizing-700: 115px;
    --appui-sizing-750: 132px;
    --appui-sizing-800: 152px;
    --appui-sizing-850: 174px;
    --appui-sizing-900: 200px;
    --appui-sizing-950: 230px;
    --appui-sizing-1000: 264px;
    --appui-sizing-1050: 304px;
    --appui-sizing-1100: 350px;
    --appui-sizing-1150: 402px;
    --appui-sizing-1200: 462px;


   /* AppBar */
   --appui-appbar-height-default: var(--appui-sizing-800);
   --appui-appbar-height-compact: var(--appui-sizing-600);

   
   /* TextField - transparent background for both modes */
   
   --appui-alias-field-background-color-default: transparent;
   --appui-alias-actions-background-color-default: transparent;
   --appui-alias-actions-background-color-active: var(--appui-base-100);
   

    --appui-spacing-25: 8px;
    --appui-spacing-50: 16px;
    --appui-spacing-100: 32px;
    --appui-spacing-125: 40px;
    --appui-spacing-150: 48px;
    --appui-spacing-200: 64px;
    --appui-spacing-250: 80px;
    --appui-spacing-300: 96px;
    --appui-spacing-400: 128px;
    --appui-spacing-450: 128px;
    --appui-spacing-500: 160px;
    --appui-spacing-600: 192px;
    --appui-spacing-700: 224px;
    --appui-spacing-800: 256px;
    --appui-spacing-900: 288px;
    --appui-spacing-1000: 320px;

    --appui-alias-control-border-width: 8px;
    --appui-alias-control-border-radius: 35px;  

    --appui-alias-control-sizing-lg-height: var(--appui-sizing-850);
    --appui-alias-control-sizing-md-height: var(--appui-sizing-800);
    --appui-alias-control-sizing-sm-height: var(--appui-sizing-750);

    --appui-alias-caret-icon-default: var(--appui-icon-fm-arrow-down-regular);

    
    -unity-text-generator: advanced; /* ZWJ support for ligatures in icons */

    --fm-color-positive: #47df29;
    --fm-color-negative: #c81d1d;
}


.appui--light {
    --fm-main-bg: #024639;
    

    --appui-positive-300: var(--appui-color-green-1000);
    --appui-positive-200: var(--appui-color-green-900);
    --appui-positive-100: var(--appui-color-green-800);
    --appui-positive-50: var(--appui-color-green-700);
    --appui-positive-25: var(--appui-color-green-600);
    --appui-warning-300: var(--appui-color-orange-1000);
    --appui-warning-200: var(--appui-color-orange-900);
    --appui-warning-100: var(--appui-color-orange-800);
    --appui-warning-50: var(--appui-color-orange-700);
    --appui-warning-25: var(--appui-color-orange-600);
    --appui-destructive-300: var(--appui-color-red-1000);
    --appui-destructive-200: var(--appui-color-red-900);
    --appui-destructive-100: #EF8787;/*var(--appui-color-red-800);*/
    --appui-destructive-50: var(--appui-color-red-700);
    --appui-destructive-25: var(--appui-color-red-600);

    --appui-accent-300: var(--appui-color-blue-1000);
    --appui-accent-200: var(--appui-color-blue-900);
    --appui-accent-100: var(--appui-primary-1300);
    --appui-accent-50: var(--appui-color-blue-700);
    --appui-accent-25: var(--appui-color-blue-600);

    --appui-primary-1300: #FFFFFF;
    --appui-primary-1200: #F4FCFA;
    --appui-primary-1100: #E8F7F3;
    --appui-primary-1000: #D6F0EA;
    --appui-primary-900: #B3E2D6;
    --appui-primary-800: #88D4C3;
    --appui-primary-700: #5CC6B0;
    --appui-primary-600: #2FB89D;
    --appui-primary-500: #06A487;
    --appui-primary-400: #058A71;
    --appui-primary-300: #04705C;
    --appui-primary-200: #035A4A;
    --appui-primary-100: #024639; /* Corporate green */
    --appui-primary-50: #00332B;
    --appui-primary-25: #001A16;
    --appui-primary-15: #000000;

    --appui-base-600: var(--appui-primary-400);
    --appui-base-500: var(--appui-primary-500);
    --appui-base-400: var(--appui-primary-1300);
    --appui-base-300: var(--appui-primary-700);
    --appui-base-200: var(--appui-primary-200);/**/
    --appui-base-100: var(--appui-primary-200);/**/
    --appui-base-50: var(--appui-primary-1000);
    --appui-base-25: var(--appui-primary-1100);

    --appui-foregrounds-200: var(--appui-primary-1300);
    --appui-foregrounds-100: var(--appui-primary-1200);
    --appui-foregrounds-50: var(--appui-primary-100);
    --appui-foregrounds-25: var(--appui-primary-1200);

    --appui-backgrounds-300: var(--appui-primary-15);
    --appui-backgrounds-200: var(--appui-primary-1300);
    --appui-backgrounds-100: var(--appui-primary-100);
    --appui-backgrounds-50: var(--appui-primary-1100);

    --appui-alias-actions-accent-foreground-color-focus: var(--appui-primary-100);
    --appui-alias-actions-accent-foreground-color-active: var(--appui-primary-100);
    --appui-alias-actions-accent-foreground-color-hover: var(--appui-primary-100);
    --appui-alias-actions-accent-foreground-color-default: var(--appui-primary-100);

    --appui-alias-control-background-color-disabled: var(--appui-primary-1000);
    --appui-alias-control-background-color-focus: var(--appui-primary-300);
    --appui-alias-control-background-color-active: var(--appui-primary-300);
    --appui-alias-control-background-color-hover: var(--appui-primary-300);
    --appui-alias-control-background-color-default: var(--appui-primary-300);

    /* Surface colors for panels, menus, and cards */
    --fm-surface-bg: rgba(255, 255, 255, 0.90);
    --fm-surface-bg-transparent: rgba(255, 255, 255, 0.20);
    --fm-surface-bg-transparent-50: rgba(255, 255, 255, 0.50);
    --fm-surface-bg-transparent-80: rgba(255, 255, 255, 0.80);
    --fm-surface-bg-alt: #F5F5F5;
    --fm-card-bg: rgba(255, 255, 255, 0.90);
    /* Progress wheels (ring >= 3:1 vs --fm-card-bg, checked by ProgressWheelThemeContrastTests) */
    --fm-wheel-co2: #2E7D32;
    --fm-wheel-energy: #B25E00;
    --fm-wheel-water: #1565C0;
    --fm-wheel-land: #795548;
    --fm-wheel-default: #546E7A;
    --fm-wheel-card-shadow: rgba(0, 0, 0, 0.18);
    /* Recipe rating stars (design: rating-star-on / rating-star-off) */
    --fm-star-filled: #024639;
    --fm-star-empty: #B5B5B5;
    /* Recipe card pills (text over a 15% tint of the same hue, on a white card) */
    --fm-pill-time: #1D4ED8;
    --fm-pill-difficulty: #047857;
    --fm-pill-category: #B45309;
    --fm-icon-tint: var(--appui-primary-100);
    --fm-icon-tint-selected: var(--appui-primary-15);
    --fm-bg-screen-trans: rgba(255, 255, 255, 0.45);
    --fm-shadowColor: rgba(0, 0, 0, 0.65);
    --fm-shadowColorInner: rgba(255, 255, 255, 0.65);
}

.appui--dark {
    --fm-main-bg: #021f1a;

    /* ============================================
       PRIMARY PALETTE
       ============================================ */

    --appui-primary-1300: #ffffff;
    --appui-primary-1200: #e6f7f3;
    --appui-primary-1100: #cdeee6;
    --appui-primary-1000: #a8e0d3;
    --appui-primary-900: #7fd1bf;
    --appui-primary-800: #57c2ab;
    --appui-primary-700: #2fb398;
    --appui-primary-600: #1f8f79;
    --appui-primary-500: #176e5d;
    --appui-primary-400: #0f5447;
    --appui-primary-300: #0a3d33;
    --appui-primary-200: #072b24;
    --appui-primary-100: #ffffff;
    --appui-primary-50: #020f0d;
    --appui-primary-25: #010807;
    --appui-primary-15: #000000;


    /* ============================================
       SEMANTIC COLORS
       ============================================ */

    --appui-positive-300: var(--appui-color-green-1000);
    --appui-positive-200: var(--appui-color-green-900);
    --appui-positive-100: var(--appui-color-green-800);
    --appui-positive-50: var(--appui-color-green-700);
    --appui-positive-25: var(--appui-color-green-600);

    --appui-warning-300: var(--appui-color-orange-1000);
    --appui-warning-200: var(--appui-color-orange-900);
    --appui-warning-100: var(--appui-color-orange-800);
    --appui-warning-50: var(--appui-color-orange-700);
    --appui-warning-25: var(--appui-color-orange-600);

    --appui-destructive-300: var(--appui-color-red-1000);
    --appui-destructive-200: var(--appui-color-red-900);
    --appui-destructive-100: #EF8787;/*var(--appui-color-red-800);*/
    --appui-destructive-50: var(--appui-color-red-700);
    --appui-destructive-25: var(--appui-color-red-600);

    --appui-accent-300: var(--appui-color-blue-1000);
    --appui-accent-200: var(--appui-color-blue-900);
    --appui-accent-100: var(--appui-primary-400);
    --appui-accent-50: var(--appui-color-blue-700);
    --appui-accent-25: var(--appui-color-blue-600);


    /* ============================================
       BASE
       ============================================ */

    --appui-base-600: var(--appui-primary-700);
    --appui-base-500: var(--appui-primary-600);
    --appui-base-400: var(--appui-primary-300);
    --appui-base-300: var(--appui-primary-400);
    --appui-base-200: var(--appui-primary-300);
    --appui-base-100: var(--appui-primary-200);
    --appui-base-50: var(--appui-primary-100);
    --appui-base-25: var(--appui-primary-50);


    /* ============================================
       FOREGROUNDS (texto)
       ============================================ */

   --appui-foregrounds-200: var(--appui-primary-1300); /* blanco puro */
   --appui-foregrounds-100: var(--appui-primary-1200); /* texto principal */
   --appui-foregrounds-50: var(--appui-primary-1000);  /* secundario */
   --appui-foregrounds-25: var(--appui-primary-1200);   /* tertiary */


    /* ============================================
       BACKGROUNDS
       ============================================ */

    --appui-backgrounds-300: var(--appui-primary-25);  /* fondo app */
    --appui-backgrounds-200: var(--appui-primary-15); /* surface */
    --appui-backgrounds-100: var(--appui-primary-200); /* cards */
    --appui-backgrounds-50: var(--appui-primary-300);  /* hover */


    /* ============================================
       ACTIONS
       ============================================ */

   --appui-alias-actions-accent-foreground-color-focus: var(--appui-primary-1300);
   --appui-alias-actions-accent-foreground-color-active: var(--appui-primary-1300);
   --appui-alias-actions-accent-foreground-color-hover: var(--appui-primary-1300);
   --appui-alias-actions-accent-foreground-color-default: var(--appui-primary-1300);

   --appui-alias-control-background-color-disabled: var(--appui-primary-300);
   --appui-alias-control-background-color-focus: var(--appui-primary-300);
   --appui-alias-control-background-color-active: var(--appui-primary-300);
   --appui-alias-control-background-color-hover: var(--appui-primary-300);
   --appui-alias-control-background-color-default: var(--appui-primary-300);



    /* ============================================
       INPUTS / INTERACTIONS
       ============================================ */

    --appui-alias-field-background-color-default: rgba(255,255,255,0.05);
    --appui-alias-actions-background-color-default: transparent;
    --appui-alias-actions-background-color-active: var(--appui-primary-300);


    /* ============================================
       SURFACES
       ============================================ */

    --fm-surface-bg: rgba(10, 20, 18, 0.95);
    --fm-surface-bg-transparent: rgba(10, 20, 18, 0.65);
    --fm-surface-bg-transparent-50: rgba(10, 20, 18, 0.65);
    --fm-surface-bg-transparent-80: rgba(10, 20, 18, 0.80);
    --fm-surface-bg-alt: #0f1f1c;
    --fm-card-bg: rgba(15, 30, 26, 0.95);
    /* Progress wheels (ring >= 3:1 vs --fm-card-bg, checked by ProgressWheelThemeContrastTests) */
    --fm-wheel-co2: #66BB6A;
    --fm-wheel-energy: #FFB74D;
    --fm-wheel-water: #64B5F6;
    --fm-wheel-land: #BCAAA4;
    --fm-wheel-default: #B0BEC5;
    --fm-wheel-card-shadow: rgba(0, 0, 0, 0.45);
    /* Recipe rating stars (design: rating-star-on / rating-star-off) */
    --fm-star-filled: #A8E0D3;
    --fm-star-empty: rgba(255, 255, 255, 0.25);
    --fm-pill-time: rgb(59, 130, 246);
    --fm-pill-difficulty: rgb(16, 185, 129);
    --fm-pill-category: rgb(245, 158, 11);

    --fm-icon-tint: var(--appui-primary-1200);
    --fm-icon-tint-selected: var(--appui-primary-900);

   --fm-bg-screen-trans: rgba(0, 0, 0, 0.45);
   --fm-shadowColor: rgba(255, 255, 255, 0.65);
   --fm-shadowColorInner: rgba(0, 0, 0, 0.65);


    /* ============================================
       CONTROLS
       ============================================ */

    --appui-alias-control-border-width: 4px;
}

/* ============================================
   Font sizes per scale level
   Defined after .appui so scale classes win in cascade.
   Every step is strictly larger than the previous one; small ~0.85x and
   large ~1.2x of medium. Aliases are explicit px (not var() to the numeric
   ramp) because App UI maps heading-xxs to font-sizes-50, below body text.
   Roles: see AGENTS.md "Typography scale & roles".
   ============================================ */

.appui--small {
    /* Body (Text size XXS..XXXL) */
    --appui-font-sizes-body-xxs: 18px;
    --appui-font-sizes-body-xs: 22px;
    --appui-font-sizes-body-sm: 26px;
    --appui-font-sizes-body-md: 30px;
    --appui-font-sizes-body-lg: 36px;
    --appui-font-sizes-body-xl: 40px;
    --appui-font-sizes-body-xxl: 48px;
    --appui-font-sizes-body-xxxl: 54px;

    /* Headings (Heading size XXS..XXXL) */
    --appui-font-sizes-heading-xxs: 28px;
    --appui-font-sizes-heading-xs: 30px;
    --appui-font-sizes-heading-sm: 34px;
    --appui-font-sizes-heading-md: 40px;
    --appui-font-sizes-heading-lg: 46px;
    --appui-font-sizes-heading-xl: 54px;
    --appui-font-sizes-heading-xxl: 68px;
    --appui-font-sizes-heading-xxxl: 82px;

    /* Numeric ramp (App UI components, autosize limits); 25..500 = body-xxs..body-xxxl */
    --appui-font-sizes-25: 18px;
    --appui-font-sizes-50: 22px;
    --appui-font-sizes-75: 26px;
    --appui-font-sizes-100: 30px;
    --appui-font-sizes-200: 36px;
    --appui-font-sizes-300: 40px;
    --appui-font-sizes-400: 48px;
    --appui-font-sizes-500: 54px;
    --appui-font-sizes-600: 60px;
    --appui-font-sizes-700: 64px;
    --appui-font-sizes-800: 70px;
    --appui-font-sizes-900: 74px;
    --appui-font-sizes-1000: 80px;
    --appui-font-sizes-1100: 84px;
    --appui-font-sizes-1200: 94px;
    --appui-font-sizes-1300: 102px;
    --appui-font-sizes-1400: 112px;
    --appui-font-sizes-1500: 122px;
    --appui-font-sizes-1600: 134px;
    --appui-font-sizes-1700: 148px;
    --appui-font-sizes-1800: 164px;
}

.appui--medium {
    /* Body (Text size XXS..XXXL) */
    --appui-font-sizes-body-xxs: 20px;
    --appui-font-sizes-body-xs: 26px;
    --appui-font-sizes-body-sm: 32px;
    --appui-font-sizes-body-md: 36px;
    --appui-font-sizes-body-lg: 42px;
    --appui-font-sizes-body-xl: 48px;
    --appui-font-sizes-body-xxl: 56px;
    --appui-font-sizes-body-xxxl: 64px;

    /* Headings (Heading size XXS..XXXL) */
    --appui-font-sizes-heading-xxs: 32px;
    --appui-font-sizes-heading-xs: 36px;
    --appui-font-sizes-heading-sm: 40px;
    --appui-font-sizes-heading-md: 46px;
    --appui-font-sizes-heading-lg: 54px;
    --appui-font-sizes-heading-xl: 64px;
    --appui-font-sizes-heading-xxl: 80px;
    --appui-font-sizes-heading-xxxl: 96px;

    /* Numeric ramp (App UI components, autosize limits); 25..500 = body-xxs..body-xxxl */
    --appui-font-sizes-25: 20px;
    --appui-font-sizes-50: 26px;
    --appui-font-sizes-75: 32px;
    --appui-font-sizes-100: 36px;
    --appui-font-sizes-200: 42px;
    --appui-font-sizes-300: 48px;
    --appui-font-sizes-400: 56px;
    --appui-font-sizes-500: 64px;
    --appui-font-sizes-600: 70px;
    --appui-font-sizes-700: 76px;
    --appui-font-sizes-800: 82px;
    --appui-font-sizes-900: 88px;
    --appui-font-sizes-1000: 94px;
    --appui-font-sizes-1100: 100px;
    --appui-font-sizes-1200: 110px;
    --appui-font-sizes-1300: 120px;
    --appui-font-sizes-1400: 132px;
    --appui-font-sizes-1500: 144px;
    --appui-font-sizes-1600: 158px;
    --appui-font-sizes-1700: 174px;
    --appui-font-sizes-1800: 192px;
}

.appui--large {
    /* Body (Text size XXS..XXXL) */
    --appui-font-sizes-body-xxs: 24px;
    --appui-font-sizes-body-xs: 32px;
    --appui-font-sizes-body-sm: 38px;
    --appui-font-sizes-body-md: 44px;
    --appui-font-sizes-body-lg: 50px;
    --appui-font-sizes-body-xl: 58px;
    --appui-font-sizes-body-xxl: 68px;
    --appui-font-sizes-body-xxxl: 76px;

    /* Headings (Heading size XXS..XXXL) */
    --appui-font-sizes-heading-xxs: 38px;
    --appui-font-sizes-heading-xs: 44px;
    --appui-font-sizes-heading-sm: 48px;
    --appui-font-sizes-heading-md: 56px;
    --appui-font-sizes-heading-lg: 64px;
    --appui-font-sizes-heading-xl: 76px;
    --appui-font-sizes-heading-xxl: 96px;
    --appui-font-sizes-heading-xxxl: 116px;

    /* Numeric ramp (App UI components, autosize limits); 25..500 = body-xxs..body-xxxl */
    --appui-font-sizes-25: 24px;
    --appui-font-sizes-50: 32px;
    --appui-font-sizes-75: 38px;
    --appui-font-sizes-100: 44px;
    --appui-font-sizes-200: 50px;
    --appui-font-sizes-300: 58px;
    --appui-font-sizes-400: 68px;
    --appui-font-sizes-500: 76px;
    --appui-font-sizes-600: 84px;
    --appui-font-sizes-700: 92px;
    --appui-font-sizes-800: 98px;
    --appui-font-sizes-900: 106px;
    --appui-font-sizes-1000: 112px;
    --appui-font-sizes-1100: 120px;
    --appui-font-sizes-1200: 132px;
    --appui-font-sizes-1300: 144px;
    --appui-font-sizes-1400: 158px;
    --appui-font-sizes-1500: 172px;
    --appui-font-sizes-1600: 190px;
    --appui-font-sizes-1700: 208px;
    --appui-font-sizes-1800: 230px;
}
