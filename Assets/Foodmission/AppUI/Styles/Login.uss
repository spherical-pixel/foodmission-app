.login-root {
    flex-grow: 1;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0);
}

.login-logo-foodmission {
    margin-top: 80px;
    margin-bottom: 40px;
    -unity-background-scale-mode: scale-to-fit;
    max-height: none;
    max-width: 90%;
    align-self: center;
}

/* Gear that opens AppearanceSettingsDialog (top right; LoginScreen adds the safe area) */
.login-appearance-bar {
    position: absolute;
    top: 8px;
    right: 8px;
}
