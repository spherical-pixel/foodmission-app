.fm-avatar-panel-item-spacing {
    margin-left: 35px;
    margin-right: 35px;
    padding-left: 35px;
    padding-right: 35px;
}

.appui-navigation-screen {
    background-color: transparent;
}

.appui-navhost__container > .appui-navhost__item {
    background-color: transparent;
}

.appui-navigation-screen__left-container,
.appui-navigation-screen__right-container,
.appui-navigation-screen__container {
    background-color: transparent;
}

.appui {
    background-color: var(--fm-main-bg);
    font-size: var(--appui-font-sizes-body-md);
}

.appui-button.fm-button.appui-button--size-s {
    min-height: var(--appui-sizing-800);
}

.appui-button.fm-button.appui-button--size-m {
    min-height: var(--appui-sizing-850);
}

.appui-button.fm-button.appui-button--size-l {
    min-height: var(--appui-sizing-900);
}

.appui-button:disabled {
    opacity: 0.65;
}

.appui--light .appui-button:disabled {
    background-color: var(--appui-primary-1000);
    color: var(--appui-primary-300);
}

.appui--dark .appui-button:disabled {
    background-color: var(--appui-primary-300);
    color: var(--appui-primary-1000);
}

.fm-button-align-left .appui-button__titlecontainer {
    align-items: flex-start;
}

.fm-button-avatar-list {
    flex-direction: row;
    align-content: center;
    justify-content: space-between;
    flex-shrink: 1;
}

.fm-heading-avatar-editor-part {
    align-self: center;
    color: var(--appui-primary-100);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.appui-button.fm-button-avatar-scroll {
    margin: 5px;
    min-width: 150px;
    min-height: 150px;
    aspect-ratio: 1;
    width: auto;
    height: auto;
}

.appui-button.fm-button-avatar-scroll-arrow {
    min-height: 150px;
    width: auto;
    height: auto;
}

.fm-button-avatar #appui-button__leading-icon {
    width: 85%;
    height: 85%;
}

.fm-button-drawer {
    font-size: var(--appui-font-sizes-500);
}

.appui-button--accent.appui-button--quiet.fm-button-list {
    color: var(--appui-foregrounds-100);
}

.appui-button--accent.appui-button--quiet.fm-button-list .appui-icon,
.appui-button--primary.appui-button--quiet.fm-button-list .appui-icon,
.appui-button--destructive.appui-button--quiet.fm-button-list .appui-icon {
    --unity-image-tint-color: var(--appui-foregrounds-100);
}

.appui-button--size-s.fm-button-list {
    min-height: var(--appui-sizing-600);
    min-width: var(--appui-sizing-700);
    padding-top: var(--appui-spacing-25);
    padding-bottom: var(--appui-spacing-25);
}

.appui-button--size-m.fm-button-list {
    min-height: var(--appui-sizing-650);
    min-width: var(--appui-sizing-750);
    padding-top: var(--appui-spacing-50);
    padding-bottom: var(--appui-spacing-50);
}

.appui-button--size-l.fm-button-list {
    min-height: var(--appui-sizing-700);
    min-width: var(--appui-sizing-800);
    padding-top: var(--appui-spacing-100);
    padding-bottom: var(--appui-spacing-100);
}

.fm-button-drawer .appui-icon {
    --unity-image-tint-color: var(--fm-icon-tint);
}

.appui-bottom-navbar {
    min-height: var(--appui-sizing-1000);
    background-color: transparent;
    background-image: url("project://database/Assets/Foodmission/graphics/png/NavBarBack.png?fileID=21300000&guid=f15965a97feed4bb0be052f64bbcb614&type=3#NavBarBack");
    padding: 40px 40px 6px 40px;
}

.appui--dark .appui-bottom-navbar {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.appui--light .appui-bottom-navbar {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.appui-bottom-navbar-item {
    align-items: center;
    justify-content: center;
    border-width: 0;
    width: var(--appui-sizing-850);
    height: var(--appui-sizing-850);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.appui-bottom-navbar-item .appui-bottom-navbar-item__icon.appui-icon {
    min-width: 72px;
    min-height: 72px;
    margin-bottom: 0;
}

.appui-bottom-navbar-item .appui-icon--primary {
    --unity-image-tint-color: var(--fm-icon-tint);
}

.appui-bottom-navbar-item.is-selected .appui-bottom-navbar-item__icon {
    --unity-image-tint-color: var(--fm-icon-tint-selected);
}

.appui-bottom-navbar-item.no-tint .appui-icon--primary,
.appui-bottom-navbar-item.no-tint.is-selected .appui-icon--primary {
    --unity-image-tint-color: rgb(255, 255, 255);
}

.appui-bottom-navbar-item .appui-bottom-navbar-item__label,
.appui-bottom-navbar-item .appui-bottom-navbar-item__label.appui-localized-text,
.appui-bottom-navbar-item .appui-localized-text {
    -unity-text-align: upper-center;
    font-size: var(--appui-font-sizes-body-sm);
    text-overflow: ellipsis;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    -unity-text-auto-size: best-fit;
    --unity-text-min-size: var(--appui-font-sizes-25);
    --unity-text-max-size: var(--appui-font-sizes-body-sm);
    color: var(--fm-icon-tint);
    margin-top: 0;
    padding: 0;
    flex-wrap: nowrap;
    white-space: nowrap;
}

.appui-drawer__drawer-container {
    background-color: var(--fm-surface-bg);
}

.appui-drawer.fm-drawer-pre-init .appui-drawer__drawer-container {
    visibility: hidden;
}

.fm-menu-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: flex-end;
}

.fm-menu-panel {
    background-color: var(--fm-surface-bg);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding-bottom: 16px;
    translate: 0 100%;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease;
    margin-left: 40px;
    margin-right: 40px;
}

.fm-menu-panel--visible {
    translate: 0 0%;
}

.fm-menu-panel__handle {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(128, 128, 128, 0.4);
    align-self: center;
    margin-top: 12px;
    margin-bottom: 8px;
}

.fm-notification-card {
    flex-direction: row;
    align-items: flex-start;
    padding: 14px 12px;
    margin-bottom: 8px;
    border-radius: 12px;
    background-color: var(--fm-card-bg);
}

.fm-notification-card--read {
    opacity: 0.65;
}

.fm-notification-card__indicator {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(0, 120, 90);
    margin-top: 5px;
    margin-right: 12px;
    flex-shrink: 0;
}

.fm-notification-card--read .fm-notification-card__indicator {
    background-color: transparent;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
}

.fm-notification-card__content {
    flex-grow: 1;
    flex-shrink: 1;
}

.fm-notification-card__text {
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-foregrounds-100);
    white-space: normal;
    -unity-text-align: upper-left;
}

.fm-notification-card__timestamp {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-50);
    margin-top: 5px;
}

.fm-notifications-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: flex-end;
}

.fm-notifications-panel {
    background-color: var(--fm-surface-bg-alt);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding-bottom: 16px;
    translate: 0 100%;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}

.fm-notifications-panel--visible {
    translate: 0 0%;
}

.fm-notifications-panel__handle {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(128, 128, 128, 0.4);
    align-self: center;
    margin-top: 12px;
    margin-bottom: 8px;
}

.fm-notifications-panel__header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px 8px 16px;
}

.fm-notifications-panel__title {
    flex-grow: 1;
    font-size: var(--appui-font-sizes-heading-sm);
    -unity-font-style: bold;
    color: var(--appui-foregrounds-100);
}

.fm-notifications-panel__divider {
    height: 1px;
    background-color: rgba(128, 128, 128, 0.2);
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 8px;
}

.fm-notifications-empty {
    -unity-text-align: middle-center;
    color: var(--appui-foregrounds-50);
    margin-top: 32px;
    margin-bottom: 32px;
    font-size: var(--appui-font-sizes-body-md);
}

.fm-dialog-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    padding: var(--appui-sizing-150);
}

.fm-dialog-scroll .block {
    margin-bottom: 16px;
}

.fm-dialog-scroll .heading {
    margin-top: 18px;
    margin-bottom: 8px;
}

.fm-dialog-scroll .paragraph .line {
    overflow: visible;
}

.fm-dialog-scroll-text {
    white-space: normal;
    -unity-text-align: upper-left;
}

.appui-modal__content {
    background-color: var(--appui-backgrounds-100);
    border-radius: 35px;
    --box-shadow-offset-y: 10;
    --box-shadow-offset-x: 10;
    --box-shadow-spread: 20;
    --box-shadow-blur: 30;
    --box-shadow-color: rgba(0, 0, 0, 0.65);
}

.appui-dialog__content {
    margin-top: var(--appui-spacing-100);
}

.appui-dialog--size-s,
.appui-dialog--size-m,
.appui-dialog--size-l {
    width: 900px;
}

.fm-info-dialog {
    padding: var(--appui-spacing-200);
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.fm-info-dialog__heading {
    margin-bottom: var(--appui-spacing-50);
    white-space: normal;
}

.fm-info-dialog__scroll {
    flex-grow: 1;
    margin-bottom: 20px;
}

.fm-info-dialog__body {
    white-space: normal;
    font-size: var(--appui-font-sizes-body-md);
}

.fm-info-dialog__actions {
    flex-direction: column;
}

.fm-nutri-dialog {
    opacity: 0;
    scale: 0.95;
    transition-property: opacity, scale;
    transition-duration: 350ms, 350ms;
    transition-timing-function: ease-out, ease-out;
}

.fm-nutri-dialog.fm-nutri-dialog--visible {
    opacity: 1;
    scale: 1;
}

.fm-nutri-dialog.fm-nutri-dialog--exit {
    opacity: 0;
    scale: 0.95;
    transition-duration: 200ms, 200ms;
    transition-timing-function: ease-in, ease-in;
}

.stepper-heading {
    width: 45%;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-auto-size: best-fit var(--appui-font-sizes-25) var(--appui-font-sizes-500);
}

.fm-arrow-stepper__row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.fm-arrow-stepper__label {
    flex-basis: 180px;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    font-size: var(--appui-font-sizes-body-md);
    white-space: nowrap;
    overflow: hidden;
    -unity-text-auto-size: best-fit var(--appui-font-sizes-25) var(--appui-font-sizes-body-md);
}

.fm-simple-stepper .appui-button {
    width: var(--appui-sizing-600);
    height: var(--appui-sizing-600);
}

.fm-arrow-stepper-narrow .fm-arrow-stepper__label {
    width: 100px;
}

.fm-simple-stepper {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.fm-stepper-value {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: var(--appui-font-sizes-body-md);
    -unity-font-style: bold;
}

.fm-calories-stepper {
    margin-top: 15%;
}

.fm-home-nutri-label {
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-foregrounds-100);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
}

.fm-home-status-bars {
    flex-direction: row;
    justify-content: space-around;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 8px;
}

.fm-status-row {
    flex-direction: column;
    align-items: center;
    margin-bottom: 8px;
}

.fm-status-icon {
    font-size: 20px;
    width: 28px;
    flex-shrink: 0;
}

.fm-status-label {
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-foregrounds-100);
    -unity-font-style: bold;
    width: 120px;
    flex-shrink: 0;
}

.fm-status-progress {
    flex-grow: 0;
    height: 27px;
    width: 268px;
    --progress-color: rgb(41, 209, 227);
    --appui-linear-progress-border-radius: 12px;
}

.fm-home-selectors-row {
    flex-direction: row;
    padding-top: 8px;
    padding-bottom: 8px;
    flex: 1;
    align-items: center;
    justify-content: space-around;
}

.fm-calories-card {
    flex-grow: 1;
    width: 800px;
    height: 800px;
    max-width: 800px;
    max-height: 800px;
    align-self: center;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 500px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 20px;
    margin-bottom: 20px;
    aspect-ratio: 1;
    align-items: center;
}

.fm-calories-circle-wrapper {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.fm-calories-circular {
    position: absolute;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
}

.fm-calories-center {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    max-height: 100%;
    padding-left: 12%;
    padding-right: 12%;
    margin-bottom: 8px;
}

.fm-calories-consumed-label {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-50);
    -unity-text-align: middle-center;
}

.fm-calories-big-number {
    font-size: var(--appui-font-sizes-body-lg);
    color: var(--appui-foregrounds-100);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.fm-calories-left-label {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-50);
    -unity-text-align: middle-center;
}

.fm-calories-left-number {
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-foregrounds-100);
    -unity-text-align: middle-center;
}

.fm-calories-background {
    flex-grow: 1;
    background-color: var(--appui-backgrounds-50);
    position: absolute;
    flex-direction: column;
    align-items: center;
    width: 80%;
    height: 80%;
    border-top-left-radius: 500px;
    border-top-right-radius: 500px;
    border-bottom-right-radius: 500px;
    border-bottom-left-radius: 500px;
    display: flex;
}

.fm-calories-consumed-value {
    color: rgb(75, 229, 255);
}

.fm-profile-avatar {
    width: 184px;
    height: 184px;
    border-radius: 125px;
    flex-shrink: 0;
    margin-right: 16px;
    background-color: var(--appui-primary-300);
    border-width: 6px;
    border-color: var(--appui-primary-50);
    --unity-image-tint-color: var(--appui-primary-300);
    --unity-image-size: scale-to-fit;
    padding: 10px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.fm-profile-avatar--appbar {
    width: 124px;
    height: 124px;
    border-radius: 62px;
    border-width: 4px;
    margin-right: 0;
    padding: 6px;
}

.fm-profile-username {
    flex-grow: 1;
    font-size: var(--appui-font-sizes-500);
    color: var(--appui-primary-100);
    padding-bottom: 8px;
    -unity-font-definition: var(--appui-font-weights-200);
}

.fm-xp-progress {
    --progress-color: rgb(41, 209, 227);
    --appui-linear-progress-height: 28px;
    --appui-linear-progress-border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.08);
    margin-right: -60px;
    margin-bottom: 45px;
}

.fm-profile-xp-badge {
    width: 115px;
    height: 115px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/Foodmission/graphics/png/icons/fm-star.png?fileID=21300000&guid=b4db6c7cc883c433caa9e390badce675&type=3#fm-star");
    -unity-background-image-size: contain;
    -unity-background-image-tint-color: rgb(53, 229, 255);
    margin-bottom: 45px;
}

.fm-profile-xp-label {
    color: white;
    font-size: var(--appui-font-sizes-body-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.heading-wrap {
    white-space: nowrap;
    overflow: hidden;
}

.heading-wrap-pre {
    white-space: pre-wrap;
    overflow: hidden;
}

.item-field {
    margin-top: 0;
}

.centered-text {
    -unity-text-align: middle-center;
}

.fm-primary-color,
.fm-primary-color .fm-arrow-stepper__label {
    color: var(--appui-primary-100);
}

.autosize-body-sm {
    -unity-text-auto-size: best-fit var(--appui-font-sizes-25) var(--appui-font-sizes-body-sm);
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    flex-shrink: 1;
    flex-wrap: nowrap;
    white-space: nowrap;
}

.autosize-body-md {
    -unity-text-auto-size: best-fit var(--appui-font-sizes-25) var(--appui-font-sizes-body-md);
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    flex-shrink: 1;
    flex-wrap: nowrap;
    white-space: nowrap;
}

.autosize-body-lg {
    -unity-text-auto-size: best-fit var(--appui-font-sizes-25) var(--appui-font-sizes-body-lg);
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    flex-shrink: 1;
    flex-wrap: nowrap;
    white-space: nowrap;
}

.autosize-font-sizes-1100 {
    -unity-text-auto-size: best-fit var(--appui-font-sizes-25) var(--appui-font-sizes-1100);
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    flex-shrink: 1;
    flex-wrap: nowrap;
    white-space: nowrap;
}

.heading-auto-size-md {
    -unity-text-auto-size: best-fit var(--appui-font-sizes-heading-sm) var(--appui-font-sizes-heading-md);
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    flex-shrink: 1;
    flex-wrap: nowrap;
    white-space: nowrap;
}

.bold-text {
    -unity-font-style: bold;
}

.unity-scroller--vertical {
    width: var(--appui-sizing-60);
}

.unity-scroller--horizontal {
    height: var(--appui-sizing-60);
}

.unity-scroller--vertical > .unity-scroller__slider {
    width: var(--appui-sizing-60);
    min-width: var(--appui-sizing-60);
}

.unity-scroller--horizontal > .unity-scroller__slider {
    height: var(--appui-sizing-60);
    min-height: var(--appui-sizing-60);
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: var(--appui-sizing-60);
    left: 0;
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    height: var(--appui-sizing-60);
    top: 0;
    bottom: 0;
}

.fm-background-tile {
    background-image: url("project://database/Assets/Foodmission/graphics/icons_miscellaneous.png?fileID=2800000&guid=63b9996e727774f16a08dde171cdadd8&type=3#icons_miscellaneous");
    background-repeat: repeat;
    background-size: 256px 256px;
    background-color: var(--fm-main-bg);
}

.fm-back-screen-transparent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.box-background {
    --background-color: var(--fm-surface-bg-transparent);
    border-radius: 35px;
    padding: 25px;
}

.box-background .appui-text {
    color: var(--appui-primary-1000);
}

.fm-nutri-card .unity-text-element {
    color: var(--appui-foregrounds-50);
}

.box-background .unity-text-element {
    padding-top: 25px;
    padding-bottom: 25px;
}

.margin-300 {
    margin: var(--appui-spacing-25);
}

.appui-picker__menu {
    max-height: 500px;
}

.fm-button {
    background-color: var(--appui-accent-100);
    color: var(--appui-alias-actions-accent-foreground-color-default);
