.fm-quiz-main-card {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--fm-surface-bg-transparent-50);
    padding: 40px;
    margin-top: 200px;
    margin-bottom: 12px;
    min-height: 990px;
    translate: 0 0%;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.fm-quiz-main-card--hidden {
    translate: 0 -120%;
    opacity: 0;
    transition-timing-function: ease-in-cubic;
}

.fm-quiz-main-card .unity-text-element {
    color: var(--appui-foregrounds-50);
}

.fm-quiz-question {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    min-height: 200px;
    margin-top: 30px;
    padding: 35px;
}

.fm-quiz-response-card {
    background-color: var(--fm-surface-bg);
    padding: 40px;
    margin-top: 12px;
    margin-bottom: 12px;
    min-height: var(--appui-sizing-900);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    scale: 1;
    border-width: 0;
    border-color: transparent;
    transition-property: border-color, border-width, scale;
    transition-duration: 0.2s;
}

.fm-quiz-response-card .unity-text-element {
    color: var(--appui-primary-100);
    -unity-font-style: bold;
    padding-right: 20px;
    flex-grow: 1;
}

.fm-quiz-response-card .unity-image {
    --unity-image-tint-color: var(--appui-primary-100);
    padding-right: 20px;
}

.fm-quiz-response-card--selected {
    border-width: 15px;
    border-color: var(--appui-accent-300);
    scale: 1;
}

.fm-quiz-response-card--correct {
    border-width: 15px;
    border-color: var(--fm-color-positive);
    scale: 1.05;
}

.fm-quiz-response-card--incorrect {
    border-width: 15px;
    border-color: var(--fm-color-negative);
    scale: 1.05;
}

.fm-quiz-explanation-card {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--fm-surface-bg-transparent-80);
    padding: 40px;
    margin-top: 20px;
    margin-bottom: 12px;
    min-height: 990px;
    translate: 0 0%;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.fm-quiz-topic-image {
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    align-self: stretch;
    height: auto;
    flex-shrink: 0;
    margin-bottom: 20px;
    border-radius: 12px;
}

.fm-quiz-explanation-card .unity-text-element {
    color: var(--appui-foregrounds-50);
}

.fm-quiz-explanation-card--hidden {
    translate: 0 -120%;
    opacity: 0;
    transition-timing-function: ease-in-cubic;
}

.fm-quiz-avatar-panel {
    height: 1200px;
}

.fm-quiz-feedback-icon {
    position: absolute;
    bottom: 320px;
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.fm-quiz-feedback-icon--hidden {
    opacity: 0;
    scale: 0.2 0.2;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-cubic;
}

.fm-source-item {
    flex-direction: column;
}

.fm-source-item-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.fm-source-item-prefix {
    -unity-font-style: bold;
}

.fm-source-item-citation {
    -unity-font-style: italic;
    white-space: normal;
}

.fm-source-item-links {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
}

.fm-source-item-link-btn {
    cursor: link;
    padding: 6px 12px;
    align-items: flex-start;
    flex-grow: 1;
}

.is-selected.appui-actionbutton{
    background-color: var(--appui-primary-900);
}


.fm-foodfact-card {
    /* position: absolute;
    top: 0;
    left: 0;
    right: 0; */
    background-color: var(--fm-surface-bg-transparent-80);
    padding: 40px;
    margin-top: 20px;
    margin-bottom: 12px;
    min-height: 990px;
    translate: 0 0%;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.fm-foodfact-card .unity-text-element {
    color: var(--appui-foregrounds-50);
}

.fm-foodfact-card--hidden {
    translate: 0 -120%;
    opacity: 0;
    transition-timing-function: ease-in-cubic;
}