.appui-navigation-screen {
    background-color: transparent;
}

.appui-navhost__container > .appui-navhost__item {
    background-color: transparent;
}

.appui-navigation-screen__left-container,
.appui-navigation-screen__right-container,
.appui-navigation-screen__container {
    background-color: transparent;
}

.fm-screen-fixed .appui-navigation-screen__container {
    overflow: hidden;
}

.fm-screen-fixed .appui-navigation-screen__container > .unity-scroll-view {
    overflow: hidden;
}

.fm-screen-fixed .appui-navigation-screen__container > .unity-scroll-view > .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.fm-screen-fixed .appui-navigation-screen__container > .unity-scroll-view > .unity-scroll-view__horizontal-scroller,
.fm-screen-fixed .appui-navigation-screen__container > .unity-scroll-view > .unity-scroll-view__vertical-scroller {
    display: none;
}

.appui {
    background-color: var(--fm-main-bg);
}

.appui-picker,
.appui-textfield {
    background-color: transparent;
    border-width: 6px;
    border-color: rgb(255, 255, 255);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    margin: 20px 0 20px 0;
    font-size: var(--appui-font-sizes-body-md);
}

.appui-navigation-screen__container {
    background-image: url("project://database/Assets/Foodmission/graphics/icons_miscellaneous.png?fileID=2800000&guid=63b9996e727774f16a08dde171cdadd8&type=3#icons_miscellaneous");
    background-repeat: repeat;
    background-size: 256px 256px;
}

.appui-bottom-navbar {
    min-height: 223px;
    background-color: transparent;
    background-image: url("project://database/Assets/Foodmission/graphics/png/NavBarBack.png?fileID=21300000&guid=f15965a97feed4bb0be052f64bbcb614&type=3#NavBarBack");
    padding: 40px 40px 6px 40px;
}

.appui-bottom-navbar-item {
    align-items: center;
    justify-content: center;
    border-width: 0;
    width: 170px;
    height: 170px;
    flex-grow: 1;
    flex-direction: column;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.appui-bottom-navbar-item .appui-bottom-navbar-item__icon.appui-icon {
    min-width: 72px;
    min-height: 72px;
    margin-bottom: 0;
}

.appui-bottom-navbar-item .appui-icon--primary {
    --unity-image-tint-color: var(--fm-icon-tint);
}

.appui-bottom-navbar-item.is-selected .appui-icon--primary {
    --unity-image-tint-color: var(--fm-icon-tint-selected);
}

.appui-bottom-navbar-item.no-tint .appui-icon--primary,
.appui-bottom-navbar-item.no-tint.is-selected .appui-icon--primary {
    --unity-image-tint-color: rgb(255, 255, 255);
}

.appui-bottom-navbar-item .appui-bottom-navbar-item__label,
.appui-bottom-navbar-item .appui-bottom-navbar-item__label.appui-localized-text,
.appui-bottom-navbar-item .appui-localized-text {
    -unity-text-align: upper-center;
    font-size: var(--appui-font-sizes-body-sm);
    min-height: 20px;
    height: 20px;
    /*line-height: 20px;*/
    color: var(--fm-icon-tint);
    margin-top: 0;
    padding-top: 15px;
    padding-bottom: 15px;
    white-space: normal;
}

.heading-wrap {
    white-space: normal;
    /*text-wrap: wrap;*/
}

.heading_field {
    margin-top: 40px;
    padding-left: 20px;
    padding-bottom: 10px;
}

.item-field {
    margin-top: 0;
}

.appui-picker__menu {
    background-color: var(--fm-surface-bg);
    border-radius: 16px;
    border-width: 0;
    padding: 8px;
    margin-top: 4px;
}

.appui-picker__menu .appui-dropdown-item,
.appui-picker__menu .appui-picker-item {
    padding: 14px 16px;
    border-radius: 10px;
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-foregrounds-100);
    -unity-font-style: normal;
    transition: background-color 0.15s ease;
}

.appui-picker__menu .appui-dropdown-item:hover,
.appui-picker__menu .appui-picker-item:hover {
    background-color: rgba(0, 120, 100, 0.1);
}

.appui-picker__menu .appui-dropdown-item.appui-dropdown-item--selected,
.appui-picker__menu .appui-picker-item.appui-picker-item--selected {
    background-color: rgba(0, 120, 100, 0.2);
    color: var(--fm-icon-tint-selected);
    -unity-font-style: bold;
}

.appui-picker__menu .appui-dropdown-item.appui-dropdown-item--selected .appui-dropdown-item__checkmark,
.appui-picker__menu .appui-picker-item--selected .appui-picker-item__checkmark {
    --unity-image-tint-color: var(--fm-icon-tint-selected);
}

.appui-picker__menu .unity-scroller {
    width: 6px;
}

.appui-picker__menu .unity-scroller .unity-scroller__slider {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
}

.centered-text {
    -unity-text-align: middle-center;
}

.appui-button {
    margin-top: 40px;
    margin-bottom: 20px;
}

.appui-checkbox {
    margin-top: 40px;
    margin-bottom: 20px;
}

/* HelpText font size - usa la variable de tamaño del tema */
.appui-help-text {
    font-size: var(--appui-font-sizes-body-sm);
}

/* ============================================
   Dialog/AlertDialog Overrides for Mobile
   Makes dialogs larger and more touch-friendly
   ============================================ */

/* Base dialog - more padding and full width on mobile */
.appui-dialog {
    padding: var(--appui-spacing-500);
    min-width: 320px;
    max-width: 85%;
}

/* Override fixed sizes to be responsive - higher specificity to beat Dialog.uss */
.appui-modal__content > .appui-dialog--size-s,
.appui-modal__content > .appui-dialog--size-m,
.appui-modal__content > .appui-dialog--size-l {
    width: 90%;
    min-width: 800px;
    max-width: 1000px;
}

/* Dialog header/title - much larger for mobile */
.appui-dialog__header{
    font-size: var(--appui-font-sizes-heading-lg);
    -unity-font-style: bold;
}

/* Dialog content/description - larger font with more line height */
.appui-dialog__content {
    font-size: var(--appui-font-sizes-body-lg);
    margin-top: var(--appui-spacing-400);
    -unity-text-align: middle-center;
}

.appui-dialog__content .appui-text {
    font-size: var(--appui-font-sizes-body-lg);
    -unity-text-align: middle-center;
}

/* Button group - more spacing */
.appui-dialog__buttongroup {
    margin-top: var(--appui-spacing-500);
    gap: var(--appui-spacing-300);
}

/* Action buttons - larger and more touch-friendly */
.appui-dialog__buttongroup > .appui-button {
    padding: var(--appui-spacing-300) var(--appui-spacing-500);
    font-size: var(--appui-font-sizes-body-lg);
    min-height: 44px;
}

/* Primary action button - accent color */
.appui-dialog__primary-action {
    font-size: var(--appui-font-sizes-body-lg);
}

/* Secondary/Cancel buttons */
.appui-dialog__secondary-action,
.appui-dialog__cancel-action {
    font-size: var(--appui-font-sizes-body-lg);
}

/* Icon in dialog - larger and positioned better */
.appui-dialog__icon {
    width: 56px;
    height: 56px;
    --unity-image-size: 56px;
}

/* Dialog heading row spacing */
.appui-dialog__heading {
    gap: var(--appui-spacing-300);
}

/* Modal content - larger border radius */
.appui-modal__content {
    border-radius: var(--appui-border-radius-xl);
}

/* Divider spacing */
.appui-dialog__divider {
    margin-top: var(--appui-spacing-300);
    margin-bottom: var(--appui-spacing-300);
}

/* ============================================
   Menu Bottom Sheet
   ============================================ */

.fm-menu-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: flex-end;
}

.fm-menu-panel {
    background-color: var(--fm-surface-bg-alt);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding-bottom: 16px;
    translate: 0 100%;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}

.fm-menu-panel--visible {
    translate: 0 0%;
}

.fm-menu-panel__handle {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(128, 128, 128, 0.4);
    align-self: center;
    margin-top: 12px;
    margin-bottom: 8px;
}

/* ============================================
   Notification Card
   ============================================ */

.fm-notification-card {
    flex-direction: row;
    align-items: flex-start;
    padding: 14px 12px;
    margin-bottom: 8px;
    border-radius: 12px;
    background-color: var(--fm-card-bg);
}

.fm-notification-card--read {
    opacity: 0.65;
}

.fm-notification-card__indicator {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(0, 120, 90);
    margin-top: 5px;
    margin-right: 12px;
    flex-shrink: 0;
}

.fm-notification-card--read .fm-notification-card__indicator {
    background-color: transparent;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
}

.fm-notification-card__content {
    flex-grow: 1;
    flex-shrink: 1;
}

.fm-notification-card__text {
    font-size: var(--appui-font-sizes-body-md);
    color: var(--appui-foregrounds-100);
    white-space: normal;
    -unity-text-align: upper-left;
}

.fm-notification-card__timestamp {
    font-size: var(--appui-font-sizes-body-sm);
    color: var(--appui-foregrounds-50);
    margin-top: 5px;
}

/* ============================================
   Notifications Bottom Sheet Panel
   ============================================ */

.fm-notifications-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    justify-content: flex-end;
}

.fm-notifications-panel {
    background-color: var(--fm-surface-bg-alt);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding-bottom: 16px;
    translate: 0 100%;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}

.fm-notifications-panel--visible {
    translate: 0 0%;
}

.fm-notifications-panel__handle {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(128, 128, 128, 0.4);
    align-self: center;
    margin-top: 12px;
    margin-bottom: 8px;
}

.fm-notifications-panel__header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px 8px 16px;
}

.fm-notifications-panel__title {
    flex-grow: 1;
    font-size: var(--appui-font-sizes-heading-sm);
    -unity-font-style: bold;
    color: var(--appui-foregrounds-100);
}

.fm-notifications-panel__divider {
    height: 1px;
    background-color: rgba(128, 128, 128, 0.2);
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 8px;
}

.fm-notifications-empty {
    -unity-text-align: middle-center;
    color: var(--appui-foregrounds-50);
    margin-top: 32px;
    margin-bottom: 32px;
    font-size: var(--appui-font-sizes-body-md);
}

/* ============================================
   Font Selection Overrides for AppUI Components
   Allows font selector to cascade to all text elements
   ============================================ */
.fm-font-open-sans .appui,
.fm-font-open-sans .appui-button__title,
.fm-font-open-sans .appui-appbar__compact-title.appui-localized-text,
.fm-font-open-sans .appui-appbar__large-title.appui-localized-text
 {
    -unity-font-definition: resource('Fonts & Materials/OpenSans-VariableFont_wdth,wght SDF') !important;
}

.fm-font-open-dyslexic .appui,
.fm-font-open-dyslexic .appui-button__title,
.fm-font-open-dyslexic .appui-appbar__compact-title.appui-localized-text,
.fm-font-open-dyslexic .appui-appbar__large-title.appui-localized-text {
    -unity-font-definition: resource('Fonts & Materials/OpenDyslexic-Regular SDF') !important;
}

.fm-font-roboto .appui,
.fm-font-roboto .appui-button__title,
.fm-font-roboto .appui-appbar__compact-title.appui-localized-text,
.fm-font-roboto .appui-appbar__large-title.appui-localized-text {
    -unity-font-definition: resource('Fonts & Materials/Roboto-VariableFont_wdth,wght SDF') !important;
}
