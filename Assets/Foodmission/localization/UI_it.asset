  - m_Id: 51673178689232905
    m_Localized: "\u2696\uFE0F CONFRONTO AMBIENTALE"
    m_Metadata:
      m_Items: []
  - m_Id: 51673178689232908
    m_Localized: "\u26A1 Confronta esempi consigliati"
    m_Metadata:
      m_Items: []
  - m_Id: 51673178689232909
    m_Localized: MINI-DUELLO AMBIENTALE
    m_Metadata:
      m_Items: []
  - m_Id: 51673178689232910
    m_Localized: "\U0001F331 Impronta minore"
    m_Metadata:
