      m_Items: []
  - m_Id: 49265187998392320
    m_Localized: Abitudini e alimentazione sostenibile
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380160
    m_Localized: Cibi senza carne / vegetariani
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380161
    m_Localized: Sostituzioni alimentari (Swaps)
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380162
    m_Localized: Alimentazione e salute
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380163
    m_Localized: "Quantit\xE0 di legumi consumata"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380164
    m_Localized: Pasto 100% vegetale / vegano
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380165
    m_Localized: "Piatto equilibrato (\xBD verdure, \xBC proteine, \xBC carboidrati)"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380166
    m_Localized: Cereali tradizionali o integrali
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380167
    m_Localized: Tubero o alimento base alternativo
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380168
    m_Localized: "Quantit\xE0 di carne conteggiata"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380169
    m_Localized: Porzione di verdure fresche o insalata
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380170
    m_Localized: Pane o cereali integrali al 100%
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380171
    m_Localized: Pasto ricco di fibre alimentari
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380172
    m_Localized: Senza sale aggiunto a tavola
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380173
    m_Localized: Grassi salutari (olio d'oliva, frutta secca)
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380174
    m_Localized: "Senza zuccheri aggiunti n\xE9 dolcificanti industriali"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574464
    m_Localized: Pasto 100% vegetale o senza carne?
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574465
    m_Localized: C'erano verdure fresche o legumi?
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574466
    m_Localized: Piatto sostenibile o cereali alternativi?
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574467
    m_Localized: 'Seleziona la sostituzione effettuata:'
    m_Metadata:
      m_Items: []
