  - m_Id: 52041725676347529
    m_Localized: Che ne pensi?
    m_Metadata:
      m_Items: []
  - m_Id: 52041725676347530
    m_Localized: Tocca una stella per valutare la ricetta
    m_Metadata:
      m_Items: []
