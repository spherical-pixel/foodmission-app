    m_Metadata:
      m_Items: []
  - m_Id: 56190243387203801
    m_Localized: "Snack \u2192 Frutta o frutta secca"
    m_Metadata:
      m_Items: []
  - m_Id: 56190243387203802
    m_Localized: "Cereali zuccherati \u2192 Avena/frutta"
    m_Metadata:
      m_Items: []
  - m_Id: 56190243387203803
    m_Localized: "Bevanda zuccherata \u2192 Acqua"
    m_Metadata:
      m_Items: []
  - m_Id: 56190243387203804
    m_Localized: "Piatto pronto \u2192 Pasto cucinato in casa"
    m_Metadata:
      m_Items: []
  - m_Id: 56190243387203805
    m_Localized: "Carne lavorata \u2192 Legumi"
