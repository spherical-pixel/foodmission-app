      m_Items: []
  - m_Id: 49560392710479876
    m_Localized: "\U0001F964 -> \U0001F4A7 Bevanda zuccherata con acqua"
    m_Metadata:
      m_Items: []
  - m_Id: 49560392710479877
    m_Localized: "\U0001F36A -> \U0001F34E Snack con frutta / frutta secca"
    m_Metadata:
      m_Items: []
  - m_Id: 49560392714674176
