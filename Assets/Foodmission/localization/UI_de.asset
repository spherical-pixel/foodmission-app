  - m_Id: 22819676332482560
    m_Localized: Land
    m_Metadata:
      m_Items: []
  - m_Id: 22819860558897152
    m_Localized: "W\xE4hlen Sie Ihr Land aus"
    m_Metadata:
      m_Items: []
  - m_Id: 22820314747494400
    m_Localized: Region
    m_Metadata:
      m_Items: []
  - m_Id: 22820425670057984
    m_Localized: "W\xE4hlen Sie Ihre Region aus"
    m_Metadata:
      m_Items: []
  - m_Id: 22820717341958144
    m_Localized: Postleitzahl
    m_Metadata:
      m_Items: []
  - m_Id: 25345767223844864
    m_Localized: "Ich stimme den <b>Nutzungsbedingungen</b> und der <b>Datenschutzerkl\xE4rung</b>
      zu."
    m_Metadata:
      m_Items: []
  - m_Id: 25351728189661184
    m_Localized: "Allgemeine Gesch\xE4ftsbedingungen"
    m_Metadata:
      m_Items: []
  - m_Id: 25351921299611648
    m_Localized: "<b>FOODMISSION \u2013 Allgemeine Gesch\xE4ftsbedingungen</b>\n\nDurch
      die Nutzung dieser Anwendung erkl\xE4ren Sie sich mit den folgenden Bedingungen
      einverstanden:\n\n<b>1. KONTOANLEGUNG</b>\nBei der Registrierung m\xFCssen
      Sie korrekte und vollst\xE4ndige Angaben machen. Sie sind f\xFCr die Geheimhaltung
      Ihrer Zugangsdaten verantwortlich.\n\n<b>2. DATENSCHUTZ</b>\nWir erheben und
      verarbeiten Ihre personenbezogenen Daten gem\xE4\xDF unserer Datenschutzerkl\xE4rung.
      Dazu geh\xF6ren Ern\xE4hrungsdaten, Standortinformationen und Nutzungsstatistiken.\n\nF\xFCr
      weitere Informationen kontaktieren Sie uns bitte unter support@foodmission.eu<b>FOODMISSION
      Nutzungsbedingungen</b>\n\nDurch die Nutzung dieser App erkl\xE4ren Sie sich
      mit den folgenden Bedingungen einverstanden:\n\nF\xFCr weitere Informationen
      kontaktieren Sie uns bitte unter support@foodmission.eu"
    m_Metadata:
      m_Items: []
  - m_Id: 25353163560181760
    m_Localized: Akzeptieren
    m_Metadata:
      m_Items: []
  - m_Id: 25353325686808576
    m_Localized: Abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 25353803774550016
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 25354482861727744
    m_Localized: Fehler
    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: Die Feldvalidierung ist fehlgeschlagen
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: Dieses Feld darf nicht leer sein.
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: "Bitte geben Sie eine g\xFCltige E-Mail-Adresse ein."
    m_Metadata:
      m_Items: []
  - m_Id: 25358751560097792
    m_Localized: Das Passwort muss mindestens 6 Zeichen lang sein.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284416
    m_Localized: "Ung\xFCltiges Geburtsjahr."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284417
    m_Localized: "Sie m\xFCssen mindestens 18 Jahre alt sein, um die Plattform nutzen
      zu k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284418
    m_Localized: "Sie m\xFCssen ein Land ausw\xE4hlen."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284419
    m_Localized: "Sie m\xFCssen eine Region ausw\xE4hlen."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284420
    m_Localized: "Ung\xFCltiges Postleitzahlenformat."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284421
    m_Localized: "Sie m\xFCssen die Allgemeinen Gesch\xE4ftsbedingungen akzeptieren,
      um fortzufahren."
    m_Metadata:
      m_Items: []
  - m_Id: 25367919163596800
    m_Localized: Anmelden
    m_Metadata:
      m_Items: []
  - m_Id: 25368981371084800
    m_Localized: Passwort vergessen?
    m_Metadata:
      m_Items: []
  - m_Id: 25369431499595776
    m_Localized: Sie haben noch kein Konto? Registrieren Sie sich
    m_Metadata:
      m_Items: []
  - m_Id: 25394900353671168
    m_Localized: "Passwort zur\xFCcksetzen"
    m_Metadata:
      m_Items: []
  - m_Id: 25395075277119488
    m_Localized: "Geben Sie Ihre E-Mail-Adresse ein, dann senden wir Ihnen einen
      Link zum Zur\xFCcksetzen Ihres Passworts."
    m_Metadata:
      m_Items: []
