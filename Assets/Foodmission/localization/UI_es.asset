    m_Localized: "Seleccione su regi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 22820717341958144
    m_Localized: "C\xF3digo postal"
    m_Metadata:
      m_Items: []
  - m_Id: 25345767223844864
    m_Localized: "Acepto los <b>T\xE9rminos de Servicio</b> y la <b>Pol\xEDtica de
      Privacidad</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 25351728189661184
    m_Localized: "T\xE9rminos y condiciones"
    m_Metadata:
      m_Items: []
  - m_Id: 25353163560181760
    m_Localized: Aceptar
    m_Metadata:
      m_Items: []
  - m_Id: 25353325686808576
    m_Localized: Cancelar
    m_Metadata:
      m_Items: []
  - m_Id: 25353803774550016
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 25354482861727744
    m_Localized: Error
    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: "La validaci\xF3n de los campos fall\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: "Este campo no puede estar vac\xEDo."
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: "Por favor, introduzca una direcci\xF3n de correo electr\xF3nico
      v\xE1lida."
    m_Metadata:
      m_Items: []
  - m_Id: 25358751560097792
    m_Localized: "La contrase\xF1a debe tener al menos 6 caracteres."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284416
    m_Localized: "A\xF1o de nacimiento no v\xE1lido."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284417
    m_Localized: "Debe tener m\xE1s de 18 a\xF1os para usar la plataforma."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284418
    m_Localized: "Debe seleccionar un pa\xEDs."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284419
    m_Localized: "Debe seleccionar una regi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284420
    m_Localized: "Formato de c\xF3digo postal no v\xE1lido."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284421
    m_Localized: "Debe aceptar los T\xE9rminos y Condiciones para continuar."
    m_Metadata:
      m_Items: []
  - m_Id: 25367919163596800
    m_Localized: "Inicia sesi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 25368981371084800
    m_Localized: "\xBFOlvidaste tu contrase\xF1a?"
    m_Metadata:
      m_Items: []
  - m_Id: 25369431499595776
    m_Localized: "\xBFNo tiene una cuenta? Reg\xEDstrese"
    m_Metadata:
      m_Items: []
  - m_Id: 25394900353671168
    m_Localized: "Restablecer contrase\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 25395075277119488
    m_Localized: "Ingrese su correo electr\xF3nico y le enviaremos un enlace para
      restablecer su contrase\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 25395779614007296
