    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: "Ha fallado la validaci\xF3n de los campos."
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: Este campo no puede estar vacio.
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: "Por favor introduce una direcci\xF3n de correo electr\xF3nico v\xE1lida."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284416
    m_Localized: "A\xF1o de nacimiento no v\xE1lido."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284417
    m_Localized: "Tienes que ser mayor de 18 a\xF1os para usar esta plataforma."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284418
    m_Localized: Debes elegir un pais.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284419
    m_Localized: "Debes elegir una regi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284420
    m_Localized: "Formato de c\xF3digo postal no v\xE1lido."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284421
    m_Localized: Debes aceptar los Terminos y Condiciones para continuar.
    m_Metadata:
      m_Items: []
  - m_Id: 25367919163596800
    m_Localized: "Iniciar sesi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 25368981371084800
