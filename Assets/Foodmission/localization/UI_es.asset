    m_Metadata:
      m_Items: []
  - m_Id: 18114763199340544
    m_Localized: "Comprobando Autenticaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 18417184911908864
    m_Localized: 'Juega, aprende y come mejor: juntos alimentamos el cambio.'
    m_Metadata:
      m_Items: []
  - m_Id: 18417602513592320
