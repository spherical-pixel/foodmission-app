    m_Metadata:
      m_Items:
      - rid: 4008881209995690412
  - m_Id: 25683680096673792
    m_Localized: Nikoli
    m_Metadata:
      m_Items: []
  - m_Id: 25683693593944064
    m_Localized: Manj kot enkrat na teden
    m_Metadata:
      m_Items: []
  - m_Id: 25706952255332352
    m_Localized: Naprej
    m_Metadata:
      m_Items: []
  - m_Id: 25707081205014528
    m_Localized: "Po\u0161lji"
    m_Metadata:
      m_Items: []
  - m_Id: 25709632411394048
    m_Localized: "Dobrodo\u0161li v Foodmission!\nTa kratka anketa nam pomaga razumeti
      va\u0161e prehranjevalne navade, ozave\u0161\u010Denost o izgubi hrane in trajnostne
      odlo\u010Ditve, da vam bo Nutri lahko pripravil priporo\u010Dila po meri."
    m_Metadata:
      m_Items: []
  - m_Id: 25709899143962624
    m_Localized: "Koliko obrokov z mesom obi\u010Dajno pojeste na teden?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710060687581184
    m_Localized: Kako pogosto jeste goveje meso?
    m_Metadata:
      m_Items: []
  - m_Id: 25710112776642560
    m_Localized: "Kako pogosto zavr\u017Ee\u0161 hrano, ki je \u0161e u\u017Eitna?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710126802395136
    m_Localized: "Kako pogosto u\u017Eivate visoko predelano hrano, kot so pakirani
      prigrizki, sladke pija\u010De, pripravljene jedi ali predelani mesni izdelki?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710140115116032
    m_Localized: "Kako pogosto uporabljate posode za ve\u010Dkratno uporabo ali kupujete
      izdelke za ponovno polnjenje?"
    m_Metadata:
      m_Items: []
  - m_Id: 25970700069101568
    m_Localized: KATEGORIJE
    m_Metadata:
      m_Items: []
  - m_Id: 25971230925381632
    m_Localized: "NAJNOVEJ\u0160E DODATKE"
    m_Metadata:
      m_Items: []
  - m_Id: 25972618610860032
    m_Localized: "Prej\u0161nja"
    m_Metadata:
      m_Items: []
  - m_Id: 25973559573602304
    m_Localized: Stran {0} od {1}
    m_Metadata:
      m_Items: []
  - m_Id: 26077910317129728
    m_Localized: Iskanje obrokov in receptov...
    m_Metadata:
      m_Items: []
  - m_Id: 26079908550664192
    m_Localized: Kaj si jedel za {0}?
    m_Metadata:
      m_Items: []
  - m_Id: 26082273878073344
    m_Localized: "Zadnjih obrokov ni zabele\u017Eenih."
    m_Metadata:
      m_Items: []
  - m_Id: 26082769774829568
    m_Localized: "Nalo\u017Ei prej\u0161nji obrok ali recept"
    m_Metadata:
      m_Items: []
  - m_Id: 26082930148237312
    m_Localized: "Prekli\u010Di iskanje"
    m_Metadata:
      m_Items: []
  - m_Id: 26083312333217792
    m_Localized: "Sestavine prednastavitve \xBB{0}\xAB so se spremenile. Ali \u017Eelite
      posodobiti obstoje\u010Do prednastavitev ali jo shraniti kot novo prednastavitev?"
    m_Metadata:
      m_Items: []
  - m_Id: 26083867323523072
    m_Localized: Prednastavitev je bila spremenjena.
    m_Metadata:
      m_Items: []
  - m_Id: 26084472809054208
    m_Localized: Shrani kot novo
    m_Metadata:
      m_Items: []
  - m_Id: 26084697950904320
    m_Localized: Ime prednastavitve
    m_Metadata:
      m_Items: []
  - m_Id: 26085108048977920
    m_Localized: Shrani kot novo prednastavitev
    m_Metadata:
      m_Items: []
  - m_Id: 26085312869425152
    m_Localized: Vnesite ime za novo prednastavitev
    m_Metadata:
      m_Items: []
  - m_Id: 26085540183924736
    m_Localized: Recept
    m_Metadata:
      m_Items: []
  - m_Id: 26299707348213760
    m_Localized: Izberite vrsto obroka
    m_Metadata:
      m_Items: []
  - m_Id: 26305215656353792
    m_Localized: "Kak\u0161en obrok \u017Eeli\u0161 vnesti?"
    m_Metadata:
      m_Items: []
  - m_Id: 26305695111438336
    m_Localized: Od kod je bil tvoj obrok?
    m_Metadata:
      m_Items: []
  - m_Id: 26308100574142464
    m_Localized: Iskanje obrokov in receptov...
    m_Metadata:
      m_Items: []
  - m_Id: 26308484147437568
    m_Localized: "Poi\u0161\u010Dite izdelke ali izberite kategorijo..."
    m_Metadata:
      m_Items: []
  - m_Id: 26309328330809344
    m_Localized: "Danes zau\u017Eiti obroki"
    m_Metadata:
      m_Items: []
  - m_Id: 26318181705441280
    m_Localized: "Prosimo, dodajte vsaj eno \u017Eivilo"
    m_Metadata:
      m_Items: []
