  m_TableData:
  - m_Id: 15417204736
    m_Localized: Domov
    m_Metadata:
      m_Items: []
  - m_Id: 467936468992
    m_Localized: Meni
    m_Metadata:
      m_Items: []
  - m_Id: 8970780532736
    m_Localized: Dnevnik obrokov
    m_Metadata:
      m_Items: []
  - m_Id: 9243779391488
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 2541068313681920
    m_Localized: Nalaganje
    m_Metadata:
      m_Items: []
  - m_Id: 18113535941795840
    m_Localized: Nalaganje datotek
    m_Metadata:
      m_Items: []
  - m_Id: 18114763199340544
    m_Localized: Preverjanje avtentifikacije
    m_Metadata:
      m_Items: []
  - m_Id: 18417184911908864
    m_Localized: "Igrajte se, u\u010Dite se in jejte bolje: skupaj spodbujamo spremembe."
    m_Metadata:
      m_Items: []
  - m_Id: 18417602513592320
    m_Localized: "Uporabni\u0161ko ime"
    m_Metadata:
      m_Items: []
  - m_Id: 18417848396275712
    m_Localized: "Va\u0161e uporabni\u0161ko ime"
    m_Metadata:
      m_Items: []
  - m_Id: 18418052671463424
    m_Localized: Geslo
    m_Metadata:
      m_Items: []
  - m_Id: 18418114709413888
    m_Localized: "Va\u0161e geslo"
    m_Metadata:
      m_Items: []
  - m_Id: 22812687661522944
    m_Localized: "E-po\u0161ta"
    m_Metadata:
      m_Items: []
  - m_Id: 22812856394178560
    m_Localized: "Va\u0161 e-po\u0161tni naslov"
    m_Metadata:
      m_Items: []
  - m_Id: 22819676332482560
    m_Localized: "Dr\u017Eava prebivali\u0161\u010Da"
    m_Metadata:
      m_Items: []
  - m_Id: 22819860558897152
    m_Localized: "Izberite dr\u017Eavo, v kateri prebivate"
    m_Metadata:
      m_Items: []
  - m_Id: 22820314747494400
    m_Localized: Regija
    m_Metadata:
      m_Items: []
  - m_Id: 22820425670057984
    m_Localized: Izberite svojo regijo
    m_Metadata:
      m_Items: []
  - m_Id: 25345767223844864
    m_Localized: Strinjam se s <b>Pogoji uporabe</b> in <b>Politiko zasebnosti</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 25351728189661184
    m_Localized: "Pogoji in dolo\u010Dila"
    m_Metadata:
      m_Items: []
  - m_Id: 25353163560181760
    m_Localized: Sprejmi
    m_Metadata:
      m_Items: []
  - m_Id: 25353325686808576
    m_Localized: "Prekli\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 25353803774550016
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 25354482861727744
    m_Localized: Napaka
    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: Preverjanje veljavnosti polj ni uspelo
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: To polje ne sme biti prazno.
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: "Vnesite veljaven e-po\u0161tni naslov."
    m_Metadata:
      m_Items: []
  - m_Id: 25358751560097792
    m_Localized: Geslo mora biti dolgo vsaj 6 znakov.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284416
    m_Localized: Neveljavno leto rojstva.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284417
    m_Localized: "Za uporabo platforme morate biti starej\u0161i od 18 let."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284418
    m_Localized: "Izberite dr\u017Eavo."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284419
    m_Localized: Izberite regijo.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284420
    m_Localized: "Neveljaven format po\u0161tne \u0161tevilke."
    m_Metadata:
      m_Items: []
  - m_Id: 25367919163596800
    m_Localized: Prijavi se
    m_Metadata:
      m_Items: []
  - m_Id: 25368981371084800
    m_Localized: Ste pozabili geslo?
    m_Metadata:
      m_Items: []
  - m_Id: 25369431499595776
    m_Localized: "\u0160e nimate ra\u010Duna? Registrirajte se"
    m_Metadata:
      m_Items: []
  - m_Id: 25394900353671168
    m_Localized: Ponastavi geslo
    m_Metadata:
      m_Items: []
  - m_Id: 25395075277119488
    m_Localized: "Vnesite svoj e-po\u0161tni naslov in vam bomo poslali povezavo
      za ponastavitev gesla."
    m_Metadata:
      m_Items: []
  - m_Id: 25395779614007296
    m_Localized: Nadaljuj
    m_Metadata:
      m_Items: []
  - m_Id: 25395959562231808
    m_Localized: Nazaj
    m_Metadata:
      m_Items: []
  - m_Id: 27512489452232704
    m_Localized: Nalaganje {global.PET_NAME}
    m_Metadata:
      m_Items:
      - rid: 4008881209995690412
  - m_Id: 27515040654417920
    m_Localized: Foody
    m_Metadata:
      m_Items: []
  - m_Id: 28204088708554752
    m_Localized: Obvestila
    m_Metadata:
      m_Items: []
  - m_Id: 35547983100502016
    m_Localized: "Skupaj bomo va\u0161o kuhinjo povezali s skrbjo za planet.\n\nVsak
      dan kuhajte, se u\u010Dite, delite in rastite.\n\nSte pripravljeni za\u010Deti?"
    m_Metadata:
      m_Items: []
  - m_Id: 35549851969118208
    m_Localized: Ustvari svoj avatar
    m_Metadata:
      m_Items: []
  - m_Id: 35549934412357632
    m_Localized: Dopolnite svoj profil
    m_Metadata:
      m_Items: []
  - m_Id: 35550076637011968
    m_Localized: Odpri aplikacijo
    m_Metadata:
      m_Items: []
  - m_Id: 38372841320603648
    m_Localized: "Nepravilen uporabni\u0161ki ime ali geslo"
    m_Metadata:
      m_Items: []
  - m_Id: 38373129888718848
    m_Localized: "Storitve ni bilo mogo\u010De najti"
    m_Metadata:
      m_Items: []
  - m_Id: 38373203972710400
    m_Localized: Neveljavna zahteva
    m_Metadata:
      m_Items: []
  - m_Id: 38373263087230976
    m_Localized: "Napaka stre\u017Enika"
    m_Metadata:
      m_Items: []
  - m_Id: 38373338052026368
    m_Localized: 'Napaka pri povezavi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 38380494998462464
    m_Localized: "Neveljaven odgovor stre\u017Enika"
    m_Metadata:
      m_Items: []
  - m_Id: 38381013338939392
    m_Localized: "Nepri\u010Dakovana napaka: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 38381665582571520
    m_Localized: Neveljavni podatki o registraciji
    m_Metadata:
      m_Items: []
  - m_Id: 38382047729803264
    m_Localized: "Uporabnik \u017Ee obstaja"
    m_Metadata:
      m_Items: []
  - m_Id: 38465117124288512
    m_Localized: Pozor!
    m_Metadata:
      m_Items: []
  - m_Id: 38465306467753984
    m_Localized: "Ta dejanja bodo trajno izbrisala vse va\u0161e podatke s platforme.\n\nSte
      prepri\u010Dani?"
    m_Metadata:
      m_Items: []
  - m_Id: 39878750429503488
    m_Localized: Velikost besedila
    m_Metadata:
      m_Items: []
  - m_Id: 39878840065974272
    m_Localized: Tema
    m_Metadata:
      m_Items: []
  - m_Id: 39878882189369344
    m_Localized: Uvod
    m_Metadata:
      m_Items: []
  - m_Id: 39878980084424704
    m_Localized: "\u010Crkovna vrsta"
    m_Metadata:
      m_Items: []
  - m_Id: 39879011575259136
    m_Localized: Obvestila s potisnim obvestilom
    m_Metadata:
      m_Items: []
  - m_Id: 39879077732016128
    m_Localized: Jezik
    m_Metadata:
      m_Items: []
  - m_Id: 39879128504066048
    m_Localized: Zvok
    m_Metadata:
      m_Items: []
  - m_Id: 39879174494609408
    m_Localized: Glasba
    m_Metadata:
      m_Items: []
  - m_Id: 39892766241579008
    m_Localized: Svetloba
    m_Metadata:
      m_Items: []
  - m_Id: 39892875138293760
    m_Localized: Temno
    m_Metadata:
      m_Items: []
  - m_Id: 39892914422145024
    m_Localized: Sistem
    m_Metadata:
      m_Items: []
  - m_Id: 39894833018429440
    m_Localized: "Nizozem\u0161\u010Dina"
