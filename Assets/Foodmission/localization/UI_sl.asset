    m_Metadata:
      m_Items: []
  - m_Id: 28872804286849024
    m_Localized: "Prehrana in \u017Eivljenjski slog"
    m_Metadata:
      m_Items: []
  - m_Id: 28873180532695040
    m_Localized: Oznake
    m_Metadata:
      m_Items: []
  - m_Id: 28901602873040896
    m_Localized: "\U0001F534 Zahtevno"
    m_Metadata:
      m_Items: []
  - m_Id: 28901779868475392
    m_Localized: "\U0001F7E0 Srednje te\u017Eko"
    m_Metadata:
      m_Items: []
  - m_Id: 28901897447399424
    m_Localized: "\U0001F7E2 Lahko"
    m_Metadata:
      m_Items: []
  - m_Id: 28902986997555200
    m_Localized: "Skupni \u010Das"
    m_Metadata:
      m_Items: []
  - m_Id: 28903160583020544
    m_Localized: min
    m_Metadata:
      m_Items: []
  - m_Id: 28907246254546944
    m_Localized: "\u010Cas priprave"
    m_Metadata:
      m_Items: []
  - m_Id: 28907620969472000
    m_Localized: "\u010Cas kuhanja"
    m_Metadata:
      m_Items: []
  - m_Id: 28908420210876416
    m_Localized: "\u0160tevilo porcij"
    m_Metadata:
      m_Items: []
  - m_Id: 28909425992392704
    m_Localized: "Te\u017Eavnost"
    m_Metadata:
      m_Items: []
  - m_Id: 28910041263235072
    m_Localized: Vrsta kuhinje
    m_Metadata:
      m_Items: []
  - m_Id: 28910081239146496
    m_Localized: Kategorija
    m_Metadata:
      m_Items: []
  - m_Id: 28911397441101824
    m_Localized: Okoljska ocena
    m_Metadata:
      m_Items: []
  - m_Id: 28911707144314880
    m_Localized: Ocenjena cena
    m_Metadata:
      m_Items: []
  - m_Id: 28917113388261376
    m_Localized: Moj seznam
    m_Metadata:
      m_Items: []
  - m_Id: 29219345275019264
    m_Localized: Uredi
    m_Metadata:
      m_Items: []
  - m_Id: 29226776210169856
    m_Localized: Koda povabila je kopirana!
    m_Metadata:
      m_Items: []
  - m_Id: 29234156377464832
    m_Localized: "Ali si prepri\u010Dan/-a, da \u017Eeli\u0161 tega uporabnika imenovati
      za administratorja skupine?"
    m_Metadata:
      m_Items: []
  - m_Id: 29234503556784128
    m_Localized: Uporabnik je bil imenovan za administratorja
    m_Metadata:
      m_Items: []
  - m_Id: 31123411232088064
    m_Localized: "Dobrodo\u0161el/-la v FOODMISSION! \nPlatforma za ljubiteljsko
      znanost za izbolj\u0161anje tvojega trajnostnega in prehranskega vedenja. \nNastavimo
      tvoj ra\u010Dun v nekaj preprostih korakih."
    m_Metadata:
      m_Items: []
  - m_Id: 31123536339787776
    m_Localized: "Izberi uporabni\u0161ko ime, po katerem bo\u0161 prepoznaven/-na
      na platformi FOODMISSION."
    m_Metadata:
      m_Items: []
  - m_Id: 31124113580875776
    m_Localized: "Vnesi svoj e-po\u0161tni naslov. Uporabili ga bomo za zavarovanje
      tvojega ra\u010Duna in po\u0161iljanje le pomembnih posodobitev."
    m_Metadata:
      m_Items: []
  - m_Id: 31124276500226048
    m_Localized: "Ustvari varno\_geslo z vsaj 6 znaki, da za\u0161\u010Diti\u0161
      svoj ra\u010Dun."
    m_Metadata:
      m_Items: []
  - m_Id: 31124326903177216
    m_Localized: "Povej nam svoje leto rojstva. To nam pomaga prilagoditi raziskovalne
      dejavnosti in priporo\u010Dila."
    m_Metadata:
      m_Items: []
  - m_Id: 31124438433914880
    m_Localized: "Izberi svojo dr\u017Eavo bivanja in regijo, da se pove\u017Ee\u0161
      z lokalnimi pobudami in geografsko statistiko."
    m_Metadata:
      m_Items: []
  - m_Id: 31124560802734080
    m_Localized: "Za nadaljevanje preglej in sprejmi na\u0161e Splo\u0161ne pogoje."
    m_Metadata:
      m_Items: []
  - m_Id: 31124623998312448
    m_Localized: "Preglej in sprejmi na\u0161 Pravilnik o zasebnosti, da bo\u0161
      razumel/-a, kako varujemo tvoje podatke."
    m_Metadata:
      m_Items: []
  - m_Id: 31124709910241280
    m_Localized: "Preglej in sprejmi Obrazec za informirano privolitev za sodelovanje
      v pilotni \u0161tudiji FOODMISSION."
    m_Metadata:
      m_Items: []
  - m_Id: 31124844652257280
    m_Localized: Sprejemam Pravilnik o zasebnosti
    m_Metadata:
      m_Items: []
  - m_Id: 31125157933211648
    m_Localized: "Sogla\u0161am s sodelovanjem v pilotni \u0161tudiji"
    m_Metadata:
      m_Items: []
  - m_Id: 31125240456142848
    m_Localized: "Preberi splo\u0161ne pogoje"
    m_Metadata:
      m_Items: []
  - m_Id: 31125292482289664
    m_Localized: Preberi Pravilnik o zasebnosti
    m_Metadata:
      m_Items: []
  - m_Id: 31125361180794880
    m_Localized: Preberi Obrazec za informirano privolitev
    m_Metadata:
      m_Items: []
  - m_Id: 31126126712578048
    m_Localized: "Izberi uporabni\u0161ko ime"
    m_Metadata:
      m_Items: []
  - m_Id: 31126448877068288
    m_Localized: Vsaj 6 znakov
    m_Metadata:
      m_Items: []
  - m_Id: 31126680599781376
    m_Localized: "Po\u0161tna \u0161tevilka"
    m_Metadata:
      m_Items: []
  - m_Id: 31126932849418240
    m_Localized: npr. 28001
    m_Metadata:
      m_Items: []
  - m_Id: 31127125703516160
    m_Localized: Pravilnik o zasebnosti
    m_Metadata:
      m_Items: []
  - m_Id: 31127159106953216
    m_Localized: "Obrazec za informirano privolitev za sodelovanje v pilotni \u0161tudiji"
    m_Metadata:
      m_Items: []
  - m_Id: 33345134950080512
    m_Localized: Izberi svoje leto rojstva
    m_Metadata:
      m_Items: []
  - m_Id: 33550412991684608
    m_Localized: "Dobrodo\u0161el/-la v FOODMISSION!"
    m_Metadata:
      m_Items: []
  - m_Id: 33625641466191872
    m_Localized: "V tvoji dr\u017Eavi se ne izvaja nobena pilotna \u0161tudija\nPlatformo
      lahko raziskuje\u0161 in uporablja\u0161, vendar tvoji podatki ne bodo uporabljeni
      za pilotno raziskavo."
    m_Metadata:
      m_Items: []
  - m_Id: 34022749457342464
    m_Localized: "\u017Divjo! Da bi prilagodili tvojo izku\u0161njo v aplikaciji
      Foodmission in ti pomagali dose\u010Di cilje, bi te radi malo bolje spoznali.
      Si za?\n\nOdgovori na nekaj neobveznih vpra\u0161anj, da ti bomo lahko prilagodili
      nasvete, predloge receptov in izzive."
    m_Metadata:
      m_Items: []
  - m_Id: 34022967284326400
    m_Localized: "Kaj te najbolj motivira za pridru\u017Eitev platformi FOODMISSION?
      Povej nam, kaj je tvoj glavni cilj."
    m_Metadata:
      m_Items: []
  - m_Id: 34023051975712768
    m_Localized: Nekaj podrobnosti o tebi nam pomaga prilagoditi aplikacijo ljudem
      v tvojem krogu in starostni skupini.
    m_Metadata:
      m_Items: []
  - m_Id: 34023332885028864
    m_Localized: "Ima\u0161 kak\u0161ne prehranske omejitve ali preference? Izbere\u0161
      jih lahko ve\u010D. Tako ti bomo la\u017Eje predlagali recepte in \u017Eivila,
      ki ti ustrezajo."
    m_Metadata:
      m_Items: []
  - m_Id: 34027969428054016
    m_Localized: "Razumevanje tvojih vsakodnevnih rutin nam omogo\u010Da, da ti svetujemo
      na na\u010Din, ki ustreza tvojemu resni\u010Dnemu \u017Eivljenju."
    m_Metadata:
      m_Items: []
  - m_Id: 34037819398676480
    m_Localized: Glavna motivacija
    m_Metadata:
      m_Items: []
  - m_Id: 34037939833921536
    m_Localized: Izberi svoj glavni cilj
    m_Metadata:
      m_Items: []
  - m_Id: 34038583797997568
    m_Localized: Izberi spol
    m_Metadata:
      m_Items: []
  - m_Id: 34038675313516544
    m_Localized: Stopnja izobrazbe
    m_Metadata:
      m_Items: []
  - m_Id: 34038791491543040
    m_Localized: Izberi svojo stopnjo izobrazbe
    m_Metadata:
      m_Items: []
  - m_Id: 34038925629579264
    m_Localized: Osebni bruto letni dohodek
    m_Metadata:
      m_Items: []
  - m_Id: 34039030617202688
    m_Localized: Izberi razpon bruto dohodka
    m_Metadata:
      m_Items: []
  - m_Id: 34039177296207872
    m_Localized: "Prehranske omejitve in \u017Eelje"
    m_Metadata:
      m_Items: []
  - m_Id: 34039865006874624
    m_Localized: Izberi vse, kar velja
    m_Metadata:
      m_Items: []
  - m_Id: 34039990223626240
    m_Localized: Stopnja telesne aktivnosti
    m_Metadata:
      m_Items: []
  - m_Id: 34040218603479040
    m_Localized: Izberi stopnjo aktivnosti
    m_Metadata:
      m_Items: []
  - m_Id: 34040348811452416
    m_Localized: Odgovornost za nakupovanje
    m_Metadata:
      m_Items: []
  - m_Id: 34040572049088512
    m_Localized: Izberi svojo stopnjo odgovornosti
    m_Metadata:
      m_Items: []
  - m_Id: 34040672355868672
    m_Localized: "Koliko \u010Dasa lahko vsak dan nameni\u0161 uporabi te aplikacije?"
    m_Metadata:
      m_Items: []
  - m_Id: 34040837200404480
    m_Localized: "Izberi predvideni \u010Das"
    m_Metadata:
      m_Items: []
  - m_Id: 34041809595260928
    m_Localized: "Odgovori na nekaj neobveznih vpra\u0161anj, da ti bomo lahko prilagodili
      nasvete, predloge receptov in izzive."
    m_Metadata:
      m_Items: []
  - m_Id: 34305618675228672
    m_Localized: "Ups! Ta razdelek \u0161e ni na voljo, vendar ne skrbi: delamo na
      tem, da bo\u0161 lahko v njem u\u017Eival/-a \u017Ee zelo kmalu.\n\nFOODMISSION
      se nenehno razvija. Aplikacijo izbolj\u0161ujemo in dodajamo nove funkcije
      zahvaljujo\u010D povratnim informacijam ljudi, kot si ti. Hvala, ker nam pomaga\u0161
      rasti!"
    m_Metadata:
      m_Items: []
  - m_Id: 34310338294833152
    m_Localized: Zadnji obroki
    m_Metadata:
      m_Items: []
  - m_Id: 36108391091789824
    m_Localized: Ni navedenih elementov
    m_Metadata:
      m_Items: []
  - m_Id: 37187273882591232
    m_Localized: Kvizi
    m_Metadata:
      m_Items: []
  - m_Id: 37187301837627392
    m_Localized: Vse
    m_Metadata:
      m_Items: []
  - m_Id: 37187373195321344
    m_Localized: "Za\u010Detnik/-ca"
    m_Metadata:
      m_Items: []
  - m_Id: 37187414811205632
    m_Localized: Nadaljevalec/-ka
    m_Metadata:
      m_Items: []
  - m_Id: 37187437674356736
    m_Localized: Napredno
    m_Metadata:
      m_Items: []
  - m_Id: 37187477251809280
    m_Localized: Vsi statusi
    m_Metadata:
      m_Items: []
  - m_Id: 37187522730647552
    m_Localized: "Na \u010Dakanju"
    m_Metadata:
      m_Items: []
  - m_Id: 37187606511869952
    m_Localized: Opravljeno
    m_Metadata:
      m_Items: []
  - m_Id: 37187629354049536
    m_Localized: Ni najdenih kvizov, ki bi ustrezali izbranim filtrom.
    m_Metadata:
      m_Items: []
  - m_Id: 37196650563756032
    m_Localized: Stopnja
    m_Metadata:
      m_Items: []
  - m_Id: 37196726493241344
    m_Localized: Status
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103936
    m_Localized: "Ostani na pravi poti! Vklopi potisna obvestila, da ne zamudi\u0161
      izzivov, vnosov obrokov in opozoril o poteku roka uporabnosti \u017Eivil v
      shrambi. Po\u0161iljali ti bomo le koristne opomnike."
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103937
    m_Localized: "Ob kateri uri bi najraje prejemal/-a dnevne opomnike za bele\u017Eenje
      obrokov ali preverjanje shrambe?"
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103938
    m_Localized: Potisna obvestila
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103939
    m_Localized: "Izberi, ali \u017Eeli\u0161 omogo\u010Diti obvestila"
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103940
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103941
    m_Localized: Ne zdaj
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103942
    m_Localized: "\u010Cas opomnika"
    m_Metadata:
      m_Items: []
  - m_Id: 37253702120103943
    m_Localized: "Izberi \u017Eeleni \u010Das"
    m_Metadata:
      m_Items: []
  - m_Id: 38390811904172032
    m_Localized: Kaj se je zgodilo z {0}?
    m_Metadata:
      m_Items: []
  - m_Id: 38390811904172033
    m_Localized: "Ozna\u010Di kot pojedeno"
    m_Metadata:
      m_Items: []
  - m_Id: 38390811904172034
    m_Localized: "Zabele\u017Ei kot odpadno hrano"
    m_Metadata:
      m_Items: []
  - m_Id: 38390811904172035
    m_Localized: Odstrani iz shrambe
    m_Metadata:
      m_Items: []
  - m_Id: 38390811904172036
    m_Localized: "Obrok je bil uspe\u0161no zabele\u017Een"
    m_Metadata:
      m_Items: []
  - m_Id: 38390811904172037
    m_Localized: "Odpadna hrana je bila uspe\u0161no zabele\u017Eena"
    m_Metadata:
      m_Items: []
  - m_Id: 38390811904172038
    m_Localized: Izdelek je bil odstranjen iz shrambe
    m_Metadata:
      m_Items: []
  - m_Id: 38403887139381248
    m_Localized: "Ocenjeni stro\u0161ek (\u20AC, neobvezno)"
    m_Metadata:
      m_Items: []
  - m_Id: 38404185903849472
    m_Localized: Dodatne opombe (neobvezno)
    m_Metadata:
      m_Items: []
  - m_Id: 38406003664871424
    m_Localized: "Koli\u010Dina ne sme presegati razpolo\u017Eljive koli\u010Dine
      ({0} {1})."
    m_Metadata:
      m_Items: []
  - m_Id: 40878604073033728
    m_Localized: "Posodobili smo dokument {0}. Prosimo, da ga natan\u010Dno pregleda\u0161
      in, \u010De se strinja\u0161, sprejme\u0161, da bo\u0161 lahko \u0161e naprej
      uporabljal/-a FOODMISSION."
    m_Metadata:
      m_Items: []
  - m_Id: 40937444932050944
    m_Localized: Opozorilo!
    m_Metadata:
      m_Items: []
  - m_Id: 40938002757705728
    m_Localized: "\u010Ce \u017Eeli\u0161 nadaljevati z uporabo platforme, mora\u0161
      sprejeti nov dokument {0}. \u010Ce se ne strinja\u0161, se lahko odjavi\u0161
      ali izbri\u0161e\u0161 svoj ra\u010Dun.\n\nProsimo, vzemi si trenutek in ponovno
      preglej nov dokument {0}. \u010Ce meni\u0161, da je v njem kaj narobe, nas
      kontaktiraj."
    m_Metadata:
      m_Items: []
  - m_Id: 41170053394063360
    m_Localized: Preglej dokument
    m_Metadata:
      m_Items: []
  - m_Id: 41275909230026752
    m_Localized: "\u017Divijo!\n\nKot udele\u017Eencu/udele\u017Eenki v pilotni \u0161tudiji
      ti po\u0161iljamo kratko anketo. Tvoji odgovori nam bodo pomagali izbolj\u0161ati
      platformo FOODMISSION. \n\nBi jo \u017Eelel/-a izpolniti zdaj?"
    m_Metadata:
      m_Items: []
  - m_Id: 41276238197678080
    m_Localized: Odgovori zdaj
    m_Metadata:
      m_Items: []
  - m_Id: 41276749693050880
    m_Localized: Pozneje
    m_Metadata:
      m_Items: []
  - m_Id: 41277120381444096
    m_Localized: "Ne \u017Eelim"
    m_Metadata:
      m_Items: []
  - m_Id: 41564040676237312
    m_Localized: Ni najdenih dejstev o hrani, ki bi ustrezala izbranim filtrom.
    m_Metadata:
      m_Items: []
  - m_Id: 41575049637912576
    m_Localized: "Ali si vedel/-a\_\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 41655488905994240
    m_Localized: Ni najdenih izzivov, ki bi ustrezali izbranim filtrom.
    m_Metadata:
      m_Items: []
  - m_Id: 44130274445877248
    m_Localized: KVIZ
    m_Metadata:
      m_Items: []
  - m_Id: 44130372064108544
    m_Localized: MISIJA
    m_Metadata:
      m_Items: []
  - m_Id: 44130442662633472
    m_Localized: IZZIV
    m_Metadata:
      m_Items: []
  - m_Id: 44130493631815680
    m_Localized: "ALI SI VEDEL/-A\_\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 44130682094477312
    m_Localized: "MIKROU\u010CENJE"
    m_Metadata:
      m_Items: []
  - m_Id: 44134886318006272
    m_Localized: "Pustolov\u0161\u010Dine"
    m_Metadata:
      m_Items: []
  - m_Id: 44135210076332032
    m_Localized: "Ni najdenih pustolov\u0161\u010Din, ki bi ustrezale izbranim filtrom."
    m_Metadata:
      m_Items: []
  - m_Id: 44177849203023872
    m_Localized: "Aktivna pustolov\u0161\u010Dina:"
    m_Metadata:
      m_Items: []
  - m_Id: 44181617910996992
    m_Localized: "Za\u010Dni pustolov\u0161\u010Dino"
    m_Metadata:
      m_Items: []
  - m_Id: 44181804343615488
    m_Localized: "Aktivna pustolov\u0161\u010Dina"
    m_Metadata:
      m_Items: []
  - m_Id: 44193049838870528
    m_Localized: "Ena pustolov\u0161\u010Dina je \u017Ee v teku. Ali si prepri\u010Dan/-a,
      da jo \u017Eeli\u0161 zamenjati?"
    m_Metadata:
      m_Items: []
  - m_Id: 44196897802412032
    m_Localized: "Zamenjaj pustolov\u0161\u010Dino"
    m_Metadata:
      m_Items: []
  - m_Id: 44197097057017856
    m_Localized: "Obdr\u017Ei trenutno"
    m_Metadata:
      m_Items: []
  - m_Id: 46966269096747008
    m_Localized: "{0:plural:Prislu\u017Een FoodyCoin!|Prislu\u017Eena FoodyCoina!|Prislu\u017Eeni
      FoodyCoini!|Prislu\u017Eenih FoodyCoinov!}"
    m_Metadata:
      m_Items:
      - rid: 4008881209995690412
  - m_Id: 46966074812391424
    m_Localized: "Nagrada prislu\u017Eena!"
    m_Metadata:
      m_Items: []
  - m_Id: 46966143921938432
    m_Localized: "XP-to\u010Dke prislu\u017Eene!"
    m_Metadata:
      m_Items: []
  - m_Id: 46966724417806336
    m_Localized: "Nova zna\u010Dka osvojena!"
    m_Metadata:
      m_Items: []
  - m_Id: 46966954571849728
    m_Localized: "Nov predmet za ljubljen\u010Dka!"
    m_Metadata:
      m_Items: []
  - m_Id: 46976427931721728
    m_Localized: Nov zbirateljski predmet!
    m_Metadata:
      m_Items: []
  - m_Id: 47093633499783168
    m_Localized: Prebrano
    m_Metadata:
      m_Items: []
  - m_Id: 47093633503977472
    m_Localized: Neprebrano
    m_Metadata:
      m_Items: []
  - m_Id: 47094236238045184
    m_Localized: "Pustolov\u0161\u010Dina opravljena!"
    m_Metadata:
      m_Items: []
  - m_Id: 47094236242239488
    m_Localized: Kviz opravljen!
    m_Metadata:
      m_Items: []
  - m_Id: 47094236242239489
    m_Localized: Novo dejstvo usvojeno!
    m_Metadata:
      m_Items: []
  - m_Id: 47367747305201664
    m_Localized: Zate
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395968
    m_Localized: "Razi\u0161\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395969
    m_Localized: Moji recepti
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395970
    m_Localized: Nov recept
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395971
    m_Localized: Tvoja shramba je prazna
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395972
    m_Localized: "Dodaj izdelke v svojo shrambo, da prejme\u0161 pametne predloge
      za recepte, ki zmanj\u0161ujejo koli\u010Dino odpadne hrane!"
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395973
    m_Localized: Pojdi v shrambo
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395974
    m_Localized: "Ni \u0161e ustvarjenih receptov"
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395975
    m_Localized: "Ustvari in deli svoje najljub\u0161e trajnostne recepte s skupnostjo!"
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395976
    m_Localized: Vse
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395977
    m_Localized: Preprosto
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395978
    m_Localized: Srednja
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395979
    m_Localized: "Te\u017Eko"
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395980
    m_Localized: Vse
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395981
    m_Localized: "{0} pote\u010De kmalu"
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395982
    m_Localized: '{0}/{1} v shrambi'
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395983
    m_Localized: "Splo\u0161no"
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395984
    m_Localized: Sestavine
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395985
    m_Localized: Navodila
    m_Metadata:
      m_Items: []
  - m_Id: 48786163203301379
    m_Localized: Ustvari recept
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395987
    m_Localized: Uredi recept
    m_Metadata:
      m_Items: []
  - m_Id: 47367747309395988
    m_Localized: Shrani recept
    m_Metadata:
      m_Items: []
  - m_Id: 48511689140723712
    m_Localized: "Izkoristi to, kar ima\u0161 doma"
    m_Metadata:
      m_Items: []
