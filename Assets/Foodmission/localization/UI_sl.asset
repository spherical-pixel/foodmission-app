    m_Metadata:
      m_Items: []
  - m_Id: 39903535817547776
    m_Localized: Pozabljeno geslo
    m_Metadata:
      m_Items: []
  - m_Id: 39903585188700160
    m_Localized: Uvajanje novih zaposlenih
    m_Metadata:
      m_Items: []
  - m_Id: 39906068652875776
    m_Localized: Uredi profil
    m_Metadata:
      m_Items: []
  - m_Id: 39906079050555392
    m_Localized: Uredi avatar
    m_Metadata:
      m_Items: []
  - m_Id: 39906116358889472
    m_Localized: Upravljanje skupin
    m_Metadata:
      m_Items: []
  - m_Id: 39906149892349952
    m_Localized: "Oglej si zna\u010Dke"
    m_Metadata:
      m_Items: []
  - m_Id: 39906172642254848
    m_Localized: "Izbri\u0161i ra\u010Dun"
    m_Metadata:
      m_Items: []
  - m_Id: 39906262576521216
    m_Localized: Odjavi se
    m_Metadata:
      m_Items: []
  - m_Id: 39910244942340096
    m_Localized: Dnevni izziv
    m_Metadata:
      m_Items: []
  - m_Id: 39910254861869056
    m_Localized: Misije
    m_Metadata:
      m_Items: []
  - m_Id: 39910298566516736
    m_Localized: Seznam nakupov
    m_Metadata:
      m_Items: []
  - m_Id: 39910325154209792
    m_Localized: Shramba
    m_Metadata:
      m_Items: []
  - m_Id: 39910356015898624
    m_Localized: Kuharska knjiga
    m_Metadata:
      m_Items: []
  - m_Id: 39910387632562176
    m_Localized: "\u017Divilske odpadke"
    m_Metadata:
      m_Items: []
  - m_Id: 39910411816919040
    m_Localized: Znanje
    m_Metadata:
      m_Items: []
  - m_Id: 39910434310971392
    m_Localized: Svetovna skupnost
    m_Metadata:
      m_Items: []
  - m_Id: 39910459409686528
    m_Localized: Zemljevid
    m_Metadata:
      m_Items: []
  - m_Id: 39910482159591424
    m_Localized: "Ozna\u010Di vse kot prebrano"
    m_Metadata:
      m_Items: []
  - m_Id: 39910503894335488
    m_Localized: Ni obvestil
    m_Metadata:
      m_Items: []
  - m_Id: 39915502649204736
    m_Localized: "Va\u0161a raven prehranske ozave\u0161\u010Denosti"
    m_Metadata:
      m_Items: []
  - m_Id: 39915588338835456
    m_Localized: Zdravje
    m_Metadata:
      m_Items: []
  - m_Id: 39915847026728960
    m_Localized: Hrana in odpadki
    m_Metadata:
      m_Items: []
  - m_Id: 39915896439824384
    m_Localized: Izbira hrane
    m_Metadata:
      m_Items: []
  - m_Id: 39916671006138368
    m_Localized: Danes
    m_Metadata:
      m_Items: []
  - m_Id: 39916733786480640
    m_Localized: Teden
    m_Metadata:
      m_Items: []
  - m_Id: 39916761389195264
    m_Localized: Mesec
    m_Metadata:
      m_Items: []
  - m_Id: 39916799158902784
    m_Localized: Jaz
    m_Metadata:
      m_Items: []
  - m_Id: 39916808910659584
    m_Localized: Skupina
    m_Metadata:
      m_Items: []
  - m_Id: 40182439656546304
    m_Localized: "Ustvarite svoj ra\u010Dun"
    m_Metadata:
      m_Items: []
  - m_Id: 40270284408741888
    m_Localized: Spol
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000001
    m_Localized: "E-po\u0161ta je bila poslana. Preverite svoj predal za prejete
      e-po\u0161te."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000002
    m_Localized: "E-po\u0161tnega sporo\u010Dila za ponastavitev ni bilo mogo\u010De
      poslati. Poskusite znova."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000003
    m_Localized: Uspeh
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000004
    m_Localized: Zapis obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000008
    m_Localized: Vrsta obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000009
    m_Localized: Iz shrambe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000010
    m_Localized: Pojedel
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000015
    m_Localized: "Koli\u010Dina odpadkov"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000016
    m_Localized: Nesmiselni razlog
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000019
    m_Localized: Opombe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000020
    m_Localized: Shrani
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000022
    m_Localized: Premakni v odpadke
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "Tvoja shramba je prazna. Tapni na +, da doda\u0161 izdelke."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000033
    m_Localized: "\u0160e ni nobenih izdelkov. Dodajte nekaj izdelkov."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000038
    m_Localized: Rok uporabnosti
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000040
    m_Localized: "Izbri\u0161i"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000042
    m_Localized: Izberi...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000050
    m_Localized: Potrdi
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000052
    m_Localized: Porabljene kalorije
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000053
    m_Localized: Levo
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000054
    m_Localized: "Izbrisati \xBB{0}\xAB?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000055
    m_Localized: "Izbri\u0161i dnevnik"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000056
    m_Localized: "Izbri\u0161i seznam"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000058
    m_Localized: Nov nakupovalni seznam
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000059
    m_Localized: Seznam preimenovanj
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000060
    m_Localized: Dodaj izdelek
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000061
    m_Localized: 'Uredi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000062
    m_Localized: 1 izdelek je potekel
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000063
    m_Localized: '{0} izdelkov je potekel rok veljavnosti'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000064
    m_Localized: "{0} predmet je bil odlo\u017Een med odpadke"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000065
    m_Localized: "{0} predmetov je bilo odlo\u017Eenih med odpadke"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000066
    m_Localized: Ime seznama
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000068
    m_Localized: Poglej
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000069
    m_Localized: Najprej izberite izdelek.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000072
    m_Localized: Ustvari
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000073
    m_Localized: "Ali naj 1 izdelek s prete\u010Denim rokom uporabe odlo\u017Eim
      med \u017Eivilski odpadki?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000074
    m_Localized: "Ali naj {0} izte\u010Denih izdelkov prestavim v odpadke iz hrane?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000075
    m_Localized: ta izdelek
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000080
    m_Localized: Izberite vrsto obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000085
    m_Localized: "Koli\u010Dina mora biti ve\u010Dja od 0"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000086
    m_Localized: "Vnosa o odpadkih ni bilo mogo\u010De shraniti"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000088
    m_Localized: "Napaka pri nalaganju dnevnika o \u017Eivilskih odpadkih"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000089
    m_Localized: "Elementa ni bilo mogo\u010De nalo\u017Eiti"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000090
    m_Localized: "Elementa ni bilo mogo\u010De shraniti"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000091
    m_Localized: Napaka pri nalaganju shrambe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000093
    m_Localized: "Izdelka ni bilo mogo\u010De dodati: morda manjkajo potrebni podatki
      o izdelku"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000094
