  m_TableData:
  - m_Id: 15417204736
    m_Localized: Domov
    m_Metadata:
      m_Items: []
  - m_Id: 467936468992
    m_Localized: Meni
    m_Metadata:
      m_Items: []
  - m_Id: 8970780532736
    m_Localized: Dnevnik obrokov
    m_Metadata:
      m_Items: []
  - m_Id: 9243779391488
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 2541068313681920
    m_Localized: Nalaganje
    m_Metadata:
      m_Items: []
  - m_Id: 18113535941795840
    m_Localized: Nalaganje virov
    m_Metadata:
      m_Items: []
  - m_Id: 18114763199340544
    m_Localized: Preverjanje pristnosti
    m_Metadata:
      m_Items: []
  - m_Id: 18417184911908864
    m_Localized: "Igraj se, u\u010Di se in jej bolje: skupaj spodbujamo spremembe."
    m_Metadata:
      m_Items: []
  - m_Id: 18417602513592320
    m_Localized: "Uporabni\u0161ko ime"
    m_Metadata:
      m_Items: []
  - m_Id: 18417848396275712
    m_Localized: "Tvoje uporabni\u0161ko ime"
    m_Metadata:
      m_Items: []
  - m_Id: 18418052671463424
    m_Localized: Geslo
    m_Metadata:
      m_Items: []
  - m_Id: 18418114709413888
    m_Localized: Tvoje geslo
    m_Metadata:
      m_Items: []
  - m_Id: 22812687661522944
    m_Localized: "E-po\u0161ta"
    m_Metadata:
      m_Items: []
  - m_Id: 22812856394178560
    m_Localized: "Tvoj e-po\u0161tni naslov"
    m_Metadata:
      m_Items: []
  - m_Id: 22819676332482560
    m_Localized: "Dr\u017Eava bivanja"
    m_Metadata:
      m_Items: []
  - m_Id: 22819860558897152
    m_Localized: "Izberi svojo dr\u017Eavo bivanja"
    m_Metadata:
      m_Items: []
  - m_Id: 22820314747494400
    m_Localized: Regija
    m_Metadata:
      m_Items: []
  - m_Id: 22820425670057984
    m_Localized: Izberi svojo regijo
    m_Metadata:
      m_Items: []
  - m_Id: 25345767223844864
    m_Localized: Strinjam se s <b>Pogoji uporabe</b> in <b>Politiko zasebnosti</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 25351728189661184
    m_Localized: "Splo\u0161ni pogoji"
    m_Metadata:
      m_Items: []
  - m_Id: 25353163560181760
    m_Localized: Sprejmi
    m_Metadata:
      m_Items: []
  - m_Id: 25353325686808576
    m_Localized: "Prekli\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 25353803774550016
    m_Localized: V redu
    m_Metadata:
      m_Items: []
  - m_Id: 25354482861727744
    m_Localized: Napaka
    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: Preverjanje polj ni uspelo
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: To polje ne sme biti prazno.
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: "Vnesi veljaven e-po\u0161tni naslov."
    m_Metadata:
      m_Items: []
  - m_Id: 25358751560097792
    m_Localized: Geslo mora biti dolgo vsaj 6 znakov.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284416
    m_Localized: Neveljavno leto rojstva.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284417
    m_Localized: "Za uporabo platforme mora\u0161 biti star/-a ve\u010D kot 18 let."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284418
    m_Localized: "Izbrati mora\u0161 dr\u017Eavo."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284419
    m_Localized: "Izbrati mora\u0161 regijo."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284420
    m_Localized: "Neveljavna oblika po\u0161tne \u0161tevilke."
    m_Metadata:
      m_Items: []
  - m_Id: 25367919163596800
    m_Localized: Prijava
    m_Metadata:
      m_Items: []
  - m_Id: 25368981371084800
    m_Localized: Pozabljeno geslo?
    m_Metadata:
      m_Items: []
  - m_Id: 25369431499595776
    m_Localized: "\u0160e nima\u0161 ra\u010Duna? Registriraj se"
    m_Metadata:
      m_Items: []
  - m_Id: 25394900353671168
    m_Localized: Ponastavi geslo
    m_Metadata:
      m_Items: []
  - m_Id: 25395075277119488
    m_Localized: "Vnesi svoj e-po\u0161tni naslov in poslali ti bomo povezavo za
      ponastavitev gesla."
    m_Metadata:
      m_Items: []
  - m_Id: 25395779614007296
    m_Localized: Nadaljuj
    m_Metadata:
      m_Items: []
  - m_Id: 25395959562231808
    m_Localized: Nazaj
    m_Metadata:
      m_Items: []
  - m_Id: 27512489452232704
    m_Localized: Nalaganje {global.PET_NAME}
    m_Metadata:
      m_Items:
      - rid: 4008881209995690412
  - m_Id: 27515040654417920
    m_Localized: Foody
    m_Metadata:
      m_Items: []
  - m_Id: 28204088708554752
    m_Localized: Obvestila
    m_Metadata:
      m_Items: []
  - m_Id: 35547983100502016
    m_Localized: "Skupaj bomo tvojo kuhinjo povezali s skrbjo za planet.\n\nKuhaj,
      u\u010Di se, deli in rasti vsak dan.\n\nSi pripravljen/-a na za\u010Detek?"
    m_Metadata:
      m_Items: []
  - m_Id: 35549851969118208
    m_Localized: Ustvari svoj avatar
    m_Metadata:
      m_Items: []
  - m_Id: 35549934412357632
    m_Localized: Dopolni svoj profil
    m_Metadata:
      m_Items: []
  - m_Id: 35550076637011968
    m_Localized: Vstopi v aplikacijo
    m_Metadata:
      m_Items: []
  - m_Id: 38372841320603648
    m_Localized: "Uporabni\u0161ko ime ali geslo ni pravilno"
    m_Metadata:
      m_Items: []
  - m_Id: 38373129888718848
    m_Localized: "Storitve ni mogo\u010De najti"
    m_Metadata:
      m_Items: []
  - m_Id: 38373203972710400
    m_Localized: Neveljavna zahteva
    m_Metadata:
      m_Items: []
  - m_Id: 38373263087230976
    m_Localized: "Napaka stre\u017Enika"
    m_Metadata:
      m_Items: []
  - m_Id: 38373338052026368
    m_Localized: 'Napaka pri povezavi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 38380494998462464
    m_Localized: "Neveljaven odgovor stre\u017Enika"
    m_Metadata:
      m_Items: []
  - m_Id: 38381013338939392
    m_Localized: "Nepri\u010Dakovana napaka: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 38381665582571520
    m_Localized: Neveljavni podatki za registracijo
    m_Metadata:
      m_Items: []
  - m_Id: 38382047729803264
    m_Localized: "Uporabnik \u017Ee obstaja"
    m_Metadata:
      m_Items: []
  - m_Id: 38465117124288512
    m_Localized: Pozor!
    m_Metadata:
      m_Items: []
  - m_Id: 38465306467753984
    m_Localized: "S tem dejanjem bo\u0161 trajno izbrisal/-a vse svoje podatke s
      platforme.\n\nAli si prepri\u010Dan/-a?"
    m_Metadata:
      m_Items: []
