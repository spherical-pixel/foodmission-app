    m_Metadata:
      m_Items: []
  - m_Id: 26664242240282624
    m_Localized: "Samodejno dodaj v shrambo ob ozna\u010Ditvi"
    m_Metadata:
      m_Items: []
  - m_Id: 26664711310270464
    m_Localized: Ponastavi seznam
    m_Metadata:
      m_Items: []
  - m_Id: 26665383497818112
    m_Localized: Ponastavi seznam?
    m_Metadata:
      m_Items: []
  - m_Id: 26665444902428672
    m_Localized: To bo pobrisalo izbiro vseh izdelkov.
    m_Metadata:
      m_Items: []
  - m_Id: 26665526003490816
    m_Localized: "Seznama ni bilo mogo\u010De ponastaviti"
    m_Metadata:
      m_Items: []
  - m_Id: 26665593070411776
    m_Localized: "Izdelka ni bilo mogo\u010De dodati v shrambo"
    m_Metadata:
      m_Items: []
  - m_Id: 26665665698979840
    m_Localized: Izdelek je dodan v shrambo
    m_Metadata:
      m_Items: []
  - m_Id: 26666342005334016
    m_Localized: "Kaj \u017Eeli\u0161 dodati na seznam?"
    m_Metadata:
      m_Items: []
  - m_Id: 26683190063128576
