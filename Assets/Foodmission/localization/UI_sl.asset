  - m_Id: 39910387632562176
    m_Localized: Odpadna hrana
    m_Metadata:
      m_Items: []
  - m_Id: 39910411816919040
    m_Localized: Znanje
    m_Metadata:
      m_Items: []
  - m_Id: 39910434310971392
    m_Localized: Globalna skupnost
    m_Metadata:
      m_Items: []
  - m_Id: 39910459409686528
    m_Localized: Zemljevid
    m_Metadata:
      m_Items: []
  - m_Id: 39910482159591424
    m_Localized: "Ozna\u010Di vse kot prebrano"
    m_Metadata:
      m_Items: []
  - m_Id: 39910503894335488
    m_Localized: Ni obvestil
    m_Metadata:
      m_Items: []
  - m_Id: 39915502649204736
    m_Localized: Tvoj status prehranske inteligence
    m_Metadata:
      m_Items: []
  - m_Id: 39915588338835456
    m_Localized: Zdravje
    m_Metadata:
      m_Items: []
  - m_Id: 39915847026728960
    m_Localized: Hrana in odpadki
    m_Metadata:
      m_Items: []
  - m_Id: 39915896439824384
    m_Localized: Izbira hrane
    m_Metadata:
      m_Items: []
  - m_Id: 39916671006138368
    m_Localized: Danes
    m_Metadata:
      m_Items: []
  - m_Id: 39916733786480640
    m_Localized: Teden
    m_Metadata:
      m_Items: []
  - m_Id: 39916761389195264
    m_Localized: Mesec
    m_Metadata:
      m_Items: []
  - m_Id: 39916799158902784
    m_Localized: Jaz
    m_Metadata:
      m_Items: []
  - m_Id: 39916808910659584
    m_Localized: Skupina
    m_Metadata:
      m_Items: []
  - m_Id: 40182439656546304
    m_Localized: "Ustvari svoj ra\u010Dun"
    m_Metadata:
      m_Items: []
  - m_Id: 40270284408741888
    m_Localized: Spol
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000001
    m_Localized: "E-po\u0161ta je bila poslana. Preveri svojo mapo s prejeto po\u0161to."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000002
    m_Localized: "E-po\u0161te za ponastavitev ni bilo mogo\u010De poslati. Poskusi
      znova."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000003
    m_Localized: "Uspe\u0161no"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000008
    m_Localized: Vrsta obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000009
    m_Localized: Iz shrambe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000010
    m_Localized: Obrok zunaj
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000015
    m_Localized: "Koli\u010Dina odpadne hrane"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000016
    m_Localized: Razlog za odpadke
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000019
    m_Localized: Opombe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000020
    m_Localized: Shrani
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000022
    m_Localized: Premakni med odpadke
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "Tvoja shramba je prazna. Pritisni +, da doda\u0161 izdelke."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000033
    m_Localized: "Ni \u0161e izdelkov. Dodaj nekaj izdelkov."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000038
    m_Localized: Rok uporabe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000040
    m_Localized: "Izbri\u0161i"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000042
    m_Localized: "Izberi\_\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000050
    m_Localized: Potrdi
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000052
    m_Localized: "Zau\u017Eite kalorije"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000053
    m_Localized: Preostalo
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000054
    m_Localized: "Izbri\u0161em \xBB{0}\xAB?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000055
    m_Localized: "Izbri\u0161i vnos"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000056
    m_Localized: "Izbri\u0161i seznam"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000058
    m_Localized: Nov nakupovalni seznam
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000059
    m_Localized: Preimenuj seznam
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000060
    m_Localized: Dodaj izdelek
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000061
    m_Localized: 'Uredi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000062
    m_Localized: 1 item expired
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000063
    m_Localized: '{0} predmetov poteklo'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000064
    m_Localized: "{0} predmet premaknjen v ko\u0161"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000065
    m_Localized: "{0} predmetov premaknjenih v ko\u0161"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000066
    m_Localized: Ime seznama
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000068
    m_Localized: "Prika\u017Ei"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000069
    m_Localized: Najprej izberi izdelek.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000072
    m_Localized: Ustvari
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000073
    m_Localized: "Premaknem 1 izdelek s prete\u010Denim rokom uporabe med odpadke?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000074
    m_Localized: "Premaknem {0} izdelkov s prete\u010Denim rokom uporabe med odpadke?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000075
    m_Localized: ta izdelek
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000080
    m_Localized: Izberi vrsto obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000085
    m_Localized: "Koli\u010Dina mora biti ve\u010Dja od 0"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000086
    m_Localized: "Vnosa o odpadkih ni bilo mogo\u010De shraniti"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000088
    m_Localized: Napaka pri nalaganju dnevnika odpadkov
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000089
    m_Localized: "Izdelka ni bilo mogo\u010De nalo\u017Eiti"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000090
    m_Localized: "Izdelka ni bilo mogo\u010De shraniti"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000091
    m_Localized: Napaka pri nalaganju shrambe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000093
    m_Localized: "Izdelka ni bilo mogo\u010De dodati: izdelku morda manjkajo zahtevani
      podatki"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000094
    m_Localized: "Izdelka kategorije ni bilo mogo\u010De dodati"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000096
    m_Localized: Neveljaven nakupovalni seznam
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000097
