    m_Metadata:
      m_Items: []
  - m_Id: 39910254861869056
    m_Localized: Misije
    m_Metadata:
      m_Items: []
  - m_Id: 39910298566516736
    m_Localized: Seznam nakupov
    m_Metadata:
      m_Items: []
  - m_Id: 39910325154209792
    m_Localized: Shramba
    m_Metadata:
      m_Items: []
  - m_Id: 39910356015898624
    m_Localized: Kuharska knjiga
    m_Metadata:
      m_Items: []
  - m_Id: 39910387632562176
    m_Localized: "\u017Divilske odpadke"
    m_Metadata:
      m_Items: []
  - m_Id: 39910411816919040
    m_Localized: Znanje
    m_Metadata:
      m_Items: []
  - m_Id: 39910434310971392
    m_Localized: Svetovna skupnost
    m_Metadata:
      m_Items: []
  - m_Id: 39910459409686528
    m_Localized: Zemljevid
    m_Metadata:
      m_Items: []
  - m_Id: 39910482159591424
    m_Localized: "Ozna\u010Di vse kot prebrano"
    m_Metadata:
      m_Items: []
  - m_Id: 39910503894335488
    m_Localized: Ni obvestil
    m_Metadata:
      m_Items: []
  - m_Id: 39915502649204736
    m_Localized: "Va\u0161a raven prehranske ozave\u0161\u010Denosti"
    m_Metadata:
      m_Items: []
  - m_Id: 39915588338835456
    m_Localized: Zdravje
    m_Metadata:
      m_Items: []
  - m_Id: 39915847026728960
    m_Localized: Trajnost
    m_Metadata:
      m_Items: []
  - m_Id: 39915896439824384
    m_Localized: Znanje
    m_Metadata:
      m_Items: []
  - m_Id: 39916671006138368
    m_Localized: Danes
    m_Metadata:
      m_Items: []
  - m_Id: 39916733786480640
    m_Localized: Teden
    m_Metadata:
      m_Items: []
  - m_Id: 39916761389195264
    m_Localized: Mesec
    m_Metadata:
      m_Items: []
  - m_Id: 39916799158902784
    m_Localized: Jaz
    m_Metadata:
      m_Items: []
  - m_Id: 39916808910659584
    m_Localized: Skupina
    m_Metadata:
      m_Items: []
  - m_Id: 40182439656546304
    m_Localized: "Ustvarite svoj ra\u010Dun"
    m_Metadata:
      m_Items: []
  - m_Id: 40270284408741888
    m_Localized: Spol
    m_Metadata:
      m_Items: []
  - m_Id: 40270509588340736
    m_Localized: Dopolnite svoj profil
    m_Metadata:
      m_Items: []
  - m_Id: 40270634402439168
    m_Localized: "Te informacije nam pomagajo prilagoditi va\u0161o izku\u0161njo"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000001
    m_Localized: "E-po\u0161ta je bila poslana. Preverite svoj predal za prejete
      e-po\u0161te."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000002
    m_Localized: "E-po\u0161tnega sporo\u010Dila za ponastavitev ni bilo mogo\u010De
      poslati. Poskusite znova."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000003
    m_Localized: Uspeh
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000004
    m_Localized: Zapis obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000005
    m_Localized: Obrok
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000006
    m_Localized: Iskanje obrokov...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000007
    m_Localized: Ustvari obrok
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000008
    m_Localized: Vrsta obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000009
    m_Localized: Iz shrambe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000010
    m_Localized: Pojedel
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000011
    m_Localized: "Izberite izdelke, ki jih \u017Eelite odvzeti iz shrambe"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000012
    m_Localized: Zapis obroka
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000013
    m_Localized: Odpadni hlodi
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000014
    m_Localized: "\u017Divila iz shrambe"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000015
    m_Localized: "Koli\u010Dina odpadkov"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000016
    m_Localized: Nesmiselni razlog
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000017
    m_Localized: Metoda odkrivanja
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000018
    m_Localized: "Predvideni stro\u0161ki (\u20AC)"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000019
    m_Localized: Opombe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000020
    m_Localized: Shrani
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000021
    m_Localized: Filtriraj elemente...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000022
    m_Localized: Premakni v odpadke
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "Tvoja shramba je prazna. Tapni na +, da doda\u0161 izdelke."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000024
    m_Localized: "\u017Divilske odpadke"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000025
    m_Localized: "Odpadki \u0161e niso zabele\u017Eeni. Kliknite na +, da zabele\u017Eite
      odpadke."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000026
    m_Localized: Dnevnik obrokov
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000027
    m_Localized: "Zaenkrat \u0161e ni zabele\u017Eenih obrokov. Tapnite +, da zabele\u017Eite
      svoj prvi obrok."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000028
    m_Localized: Nakupovalni seznami
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000029
    m_Localized: "Seznamov za nakupovanje \u0161e ni. Tapnite \xBBNov seznam\xAB,
      da ga ustvarite."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000030
    m_Localized: Nov seznam
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000031
    m_Localized: Nakupovalni seznam
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000032
    m_Localized: "Pojasnjeno, kon\u010Dano"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000033
    m_Localized: "\u0160e ni nobenih izdelkov. Dodajte nekaj izdelkov."
    m_Metadata:
