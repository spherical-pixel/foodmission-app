  - m_Id: 26764712233394176
    m_Localized: Hitro iskanje
    m_Metadata:
      m_Items: []
  - m_Id: 26777548250669056
    m_Localized: Izdelek je dodan na nakupovalni seznam
    m_Metadata:
      m_Items: []
  - m_Id: 26777752722989056
    m_Localized: "Poi\u0161\u010Di ali skeniraj izdelek"
    m_Metadata:
      m_Items: []
  - m_Id: 26799037893042176
    m_Localized: Poreklo
    m_Metadata:
      m_Items: []
  - m_Id: 27039676689801216
    m_Localized: "Poravnaj \u010Drtno kodo znotraj okvirja"
    m_Metadata:
      m_Items: []
  - m_Id: 27100895719186432
    m_Localized: "Koli\u010Dina in enota"
    m_Metadata:
      m_Items: []
