    m_Metadata:
      m_Items: []
  - m_Id: 48786163199107075
    m_Localized: "Kratek uvod v recept\_\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 48786163199107076
    m_Localized: "\u010Cas priprave (min)"
    m_Metadata:
      m_Items: []
  - m_Id: 48786163199107077
    m_Localized: "\u010Cas kuhanja (min)"
    m_Metadata:
      m_Items: []
  - m_Id: 48786163199107078
    m_Localized: "\u0160tevilo porcij"
    m_Metadata:
      m_Items: []
  - m_Id: 48786163199107079
    m_Localized: "Te\u017Eavnost"
    m_Metadata:
      m_Items: []
  - m_Id: 48786163199107080
    m_Localized: Izberi zahtevnost
    m_Metadata:
      m_Items: []
