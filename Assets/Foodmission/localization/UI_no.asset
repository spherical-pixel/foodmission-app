    m_Localized: Gi nytt navn til listen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000060
    m_Localized: Legg til element
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000061
    m_Localized: 'Rediger: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000062
    m_Localized: "1 vare er utl\xF8pt"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000063
    m_Localized: "{0} varer har utl\xF8pt"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000064
    m_Localized: '{0} vare flyttet til avfall'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000065
    m_Localized: '{0} varer flyttet til avfall'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000066
    m_Localized: Listenavn
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000067
    m_Localized: Mengde
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000068
    m_Localized: Utsikt
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000069
    m_Localized: "Velg et element f\xF8rst."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000070
    m_Localized: Kunne ikke legge til det valgte elementet.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000071
    m_Localized: 'Maks: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000072
    m_Localized: Skape
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000073
    m_Localized: "Flytte 1 utg\xE5tt vare til matavfall?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000074
    m_Localized: "Flytte {0} utg\xE5tte varer til matavfall?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000075
    m_Localized: denne varen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000076
    m_Localized: "Kunne ikke s\xF8ke etter m\xE5ltider. Sjekk tilkoblingen din."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000077
    m_Localized: "Skriv inn et m\xE5ltidsnavn"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000078
    m_Localized: "Kunne ikke opprette m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000079
    m_Localized: "Velg et m\xE5ltid f\xF8rst"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000080
    m_Localized: "Velg type m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000081
    m_Localized: "Kunne ikke loggf\xF8re m\xE5ltidet"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000082
    m_Localized: "M\xE5ltidet er logget, men matkassen kunne ikke oppdateres. Sjekk
      matkassen din."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000083
    m_Localized: "Feil ved lasting av m\xE5ltidslogg"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000084
    m_Localized: "Velg en vare i matskapet f\xF8rst"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000085
    m_Localized: "Mengden m\xE5 v\xE6re st\xF8rre enn 0"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000086
    m_Localized: Kunne ikke lagre avfallsposten
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000087
    m_Localized: Kunne ikke oppdatere. Viser hurtigbufrede data.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000088
    m_Localized: Feil ved lasting av matsvinnslogg
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000089
    m_Localized: Kunne ikke laste inn elementet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000090
    m_Localized: Kunne ikke lagre elementet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000091
    m_Localized: Feil ved lasting av spiskammerset
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000092
    m_Localized: 'Kunne ikke importere mat: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000093
    m_Localized: "Kunne ikke legge til vare: produktet kan mangle n\xF8dvendige data"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000094
    m_Localized: Kunne ikke legge til kategorielement
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000095
    m_Localized: "Automatisk oppdaget utl\xF8pt vare"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000096
    m_Localized: Ugyldig handleliste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000097
    m_Localized: Kunne ikke laste inn elementer
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000098
    m_Localized: "Kunne ikke s\xF8ke etter produkter"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000099
    m_Localized: Kunne ikke legge til elementet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000100
    m_Localized: Kunne ikke importere det valgte produktet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000101
    m_Localized: Kunne ikke legge til elementet i listen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000102
    m_Localized: Kunne ikke oppdatere elementet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000103
    m_Localized: Kunne ikke slette elementet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000104
    m_Localized: "Kunne ikke fjerne fullf\xF8rte elementer"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000105
    m_Localized: Feil ved lasting av lister
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000106
    m_Localized: Listenavn er obligatorisk
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000107
    m_Localized: Kunne ikke opprette listen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000108
    m_Localized: Kunne ikke slette listen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000109
    m_Localized: Invitasjonskode kreves
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000110
    m_Localized: Ugyldig invitasjonskode eller allerede medlem
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000111
    m_Localized: Navn er obligatorisk
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000112
    m_Localized: Feil ved oppretting av gruppe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000113
    m_Localized: Feil ved lasting av grupper
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000114
    m_Localized: "Innlogging mislyktes. Pr\xF8v p\xE5 nytt."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000115
    m_Localized: "Du m\xE5 godta vilk\xE5rene og betingelsene"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000116
    m_Localized: Laster inn data ...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000117
    m_Localized: "Kunne ikke laste inn data. Pr\xF8v p\xE5 nytt."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000118
    m_Localized: Feil ved innlasting av data.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000119
    m_Localized: "Kunne ikke lagre profilen. Pr\xF8v p\xE5 nytt."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000120
    m_Localized: "Uventet feil. Pr\xF8v p\xE5 nytt."
