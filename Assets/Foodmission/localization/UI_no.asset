  - m_Id: 26664711310270464
    m_Localized: Tilbakestill listen
    m_Metadata:
      m_Items: []
  - m_Id: 26665383497818112
    m_Localized: Tilbakestille listen?
    m_Metadata:
      m_Items: []
  - m_Id: 26665444902428672
    m_Localized: Dette vil fjerne merket fra alle elementene.
    m_Metadata:
      m_Items: []
  - m_Id: 26665526003490816
    m_Localized: Kunne ikke tilbakestille listen
    m_Metadata:
      m_Items: []
  - m_Id: 26665593070411776
    m_Localized: "Det var ikke mulig \xE5 legge varen til i spiskammeret"
    m_Metadata:
      m_Items: []
  - m_Id: 26665665698979840
    m_Localized: Varen er lagt til i spiskammeret
    m_Metadata:
      m_Items: []
  - m_Id: 26666342005334016
    m_Localized: "Hva vil du legge til p\xE5 listen?"
    m_Metadata:
