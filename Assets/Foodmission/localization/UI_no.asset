    m_Localized: Flytt til avfall
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "Spiskammeret ditt er tomt. Trykk p\xE5 + for \xE5 legge til varer."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000024
    m_Localized: Matsvinn
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000025
    m_Localized: "Det er ikke registrert noe avfall enn\xE5. Trykk p\xE5 + for \xE5
