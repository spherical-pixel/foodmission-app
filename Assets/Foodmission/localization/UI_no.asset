      m_Items: []
  - m_Id: 41000000000000043
    m_Localized: Kostholdspreferanser
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000044
    m_Localized: Ansvar for handleturen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000045
    m_Localized: "Utdanningsniv\xE5"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000046
    m_Localized: "\xC5rlig inntekt"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000047
    m_Localized: Hopp over
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000048
    m_Localized: Lagre og fortsett
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000049
    m_Localized: "Avslutt uten \xE5 lagre"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000050
    m_Localized: Bekrefte
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000051
    m_Localized: Kalorier, Karbonavtrykk, Mengde brukt, Proteiner
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000052
    m_Localized: Kalorier forbrukt
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000053
    m_Localized: Igjen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000054
    m_Localized: "Slette \xAB{0}\xBB?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000055
    m_Localized: Slett logg
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000056
    m_Localized: Slett liste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000057
    m_Localized: Slett avfallspost
    m_Metadata:
      m_Items: []
