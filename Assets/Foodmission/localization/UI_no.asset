      m_Items: []
  - m_Id: 41000000000000012
    m_Localized: "Logg m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000013
    m_Localized: "Avfall fra t\xF8mming av logger"
    m_Metadata:
