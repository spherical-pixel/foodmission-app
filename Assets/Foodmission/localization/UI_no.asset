  - m_Id: 50999984835780613
    m_Localized: Ikke nok FoodyCoins
    m_Metadata:
      m_Items: []
  - m_Id: 51022050452561920
    m_Localized: "\u2696\uFE0F Sammenlign proteiner fra listen min"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950528
    m_Localized: Matsammenligning
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950529
    m_Localized: "Oppdag milj\xF8p\xE5virkningen av det du kj\xF8per"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950530
    m_Localized: Nesten klar for utfordringen!
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950531
    m_Localized: "For \xE5 starte denne utfordringen trenger du minst 2 proteinkilder
      p\xE5 handlelisten din."
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950532
    m_Localized: "\U0001F6D2 G\xE5 til handleliste"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950533
    m_Localized: "\U0001F914 Hvilken har lavere fotavtrykk?"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950534
    m_Localized: "Trykk p\xE5 maten du tror genererer lavere karbonavtrykk:"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950535
    m_Localized: "\U0001F4CA Se detaljert sammenligning"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950536
    m_Localized: "Karbonavtrykk (kg CO\u2082e/kg)"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950537
    m_Localized: "PNAS milj\xF8p\xE5virkning (0-100)"
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950538
    m_Localized: "Data ansl\xE5tt fra Clark et al. (PNAS 2022) og globale databaser."
    m_Metadata:
      m_Items: []
  - m_Id: 51022050460950539
    m_Localized: "\U0001F504 Sammenlign annen mat"
    m_Metadata:
      m_Items: []
  - m_Id: 51673178685038592
    m_Localized: "Fisk og sj\xF8mat"
    m_Metadata:
      m_Items: []
