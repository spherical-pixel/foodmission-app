  - m_Id: 25707081205014528
    m_Localized: Send inn
    m_Metadata:
      m_Items: []
  - m_Id: 25709632411394048
    m_Localized: "Velkommen til Foodmission!\nDenne korte unders\xF8kelsen hjelper
      oss \xE5 forst\xE5 dine spisevaner, din bevissthet rundt matsvinn og dine b\xE6rekraftige
      valg, slik at Nutri kan skreddersy anbefalinger til deg."
    m_Metadata:
      m_Items: []
  - m_Id: 25709899143962624
    m_Localized: "Hvor mange m\xE5ltider med kj\xF8tt spiser du vanligvis hver uke?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710060687581184
    m_Localized: Hvor ofte spiser du biff?
    m_Metadata:
      m_Items: []
  - m_Id: 25710112776642560
    m_Localized: Hvor ofte kaster du mat som fortsatt er spiselig?
    m_Metadata:
      m_Items: []
  - m_Id: 25710126802395136
    m_Localized: "Hvor ofte spiser du ultraprosesserte matvarer som ferdigpakkede
      snacks, sukkerholdige drikker, ferdigretter eller bearbeidede kj\xF8ttprodukter?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710140115116032
    m_Localized: "Hvor ofte bruker du gjenbrukbare beholdere eller kj\xF8per p\xE5fyllingsprodukter?"
    m_Metadata:
      m_Items: []
  - m_Id: 25970700069101568
    m_Localized: KATEGORIER
    m_Metadata:
      m_Items: []
  - m_Id: 25971230925381632
    m_Localized: NYTT INNHOLD
    m_Metadata:
      m_Items: []
  - m_Id: 25972618610860032
    m_Localized: Forrige
    m_Metadata:
      m_Items: []
  - m_Id: 25973559573602304
    m_Localized: Side {0} av {1}
    m_Metadata:
      m_Items: []
  - m_Id: 26077910317129728
    m_Localized: "S\xF8ker etter m\xE5ltider og oppskrifter..."
    m_Metadata:
      m_Items: []
  - m_Id: 26079908550664192
    m_Localized: Hva spiste du til {0}?
    m_Metadata:
      m_Items: []
  - m_Id: 26082273878073344
    m_Localized: "Det er ikke registrert noen m\xE5ltider i det siste."
    m_Metadata:
      m_Items: []
  - m_Id: 26082769774829568
    m_Localized: "Last inn forrige m\xE5ltid eller oppskrift"
    m_Metadata:
      m_Items: []
  - m_Id: 26082930148237312
    m_Localized: "Avbryt s\xF8ket"
    m_Metadata:
      m_Items: []
  - m_Id: 26083312333217792
    m_Localized: "Ingrediensene i \xAB{0}\xBB har endret seg. Vil du oppdatere den
      eksisterende forh\xE5ndsinnstillingen eller lagre den som en ny forh\xE5ndsinnstilling?"
    m_Metadata:
      m_Items: []
  - m_Id: 26083867323523072
    m_Localized: "Forh\xE5ndsinnstillingen er endret."
    m_Metadata:
      m_Items: []
