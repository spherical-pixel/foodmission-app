  - m_Id: 39910387632562176
    m_Localized: Matsvinn
    m_Metadata:
      m_Items: []
  - m_Id: 39910411816919040
    m_Localized: Kunnskap
    m_Metadata:
      m_Items: []
  - m_Id: 39910434310971392
    m_Localized: Det globale samfunnet
    m_Metadata:
      m_Items: []
  - m_Id: 39910459409686528
    m_Localized: Kart
    m_Metadata:
      m_Items: []
  - m_Id: 39910482159591424
    m_Localized: Merk alle som lest
    m_Metadata:
      m_Items: []
  - m_Id: 39910503894335488
    m_Localized: Ingen varsler
    m_Metadata:
      m_Items: []
  - m_Id: 39915502649204736
    m_Localized: "Din ern\xE6ringsmessige intelligensstatus"
    m_Metadata:
      m_Items: []
  - m_Id: 39915588338835456
    m_Localized: Helse
    m_Metadata:
      m_Items: []
  - m_Id: 39915847026728960
    m_Localized: Mat og avfall
    m_Metadata:
      m_Items: []
  - m_Id: 39915896439824384
    m_Localized: Valg av mat
    m_Metadata:
      m_Items: []
  - m_Id: 39916671006138368
    m_Localized: I dag
    m_Metadata:
      m_Items: []
  - m_Id: 39916733786480640
    m_Localized: Uke
    m_Metadata:
      m_Items: []
  - m_Id: 39916761389195264
    m_Localized: "M\xE5ned"
    m_Metadata:
      m_Items: []
  - m_Id: 39916799158902784
    m_Localized: Meg
    m_Metadata:
      m_Items: []
  - m_Id: 39916808910659584
    m_Localized: Gruppe
    m_Metadata:
      m_Items: []
  - m_Id: 40182439656546304
    m_Localized: Opprett din konto
    m_Metadata:
      m_Items: []
  - m_Id: 40270284408741888
    m_Localized: "Kj\xF8nn"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000001
    m_Localized: E-posten er sendt. Sjekk innboksen din.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000002
    m_Localized: "Det gikk ikke an \xE5 sende e-posten for tilbakestilling. Pr\xF8v
      p\xE5 nytt."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000003
    m_Localized: Suksess
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000008
    m_Localized: "M\xE5ltidstype"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000009
    m_Localized: Fra spiskammeret
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000010
    m_Localized: Spist ute
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000015
    m_Localized: "Mengde som g\xE5r til spille"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000016
    m_Localized: Grunn til avfall
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000019
    m_Localized: Merknader
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000020
    m_Localized: Lagre
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000022
    m_Localized: Flytt til avfall
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "Spiskammeret ditt er tomt. Trykk p\xE5 + for \xE5 legge til varer."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000033
    m_Localized: "Ingen varer enn\xE5. Legg til noen produkter."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000038
    m_Localized: "Utl\xF8psdato"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000040
    m_Localized: Slett
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000042
    m_Localized: Velg...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000050
    m_Localized: Bekreft
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000052
    m_Localized: Forbrukte kalorier
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000053
    m_Localized: Venstre
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000054
    m_Localized: "Skal \xAB{0}\xBB slettes?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000055
    m_Localized: Slett logg
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000056
    m_Localized: Slett liste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000058
    m_Localized: Ny handleliste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000059
    m_Localized: Liste over navneendringer
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000060
    m_Localized: Legg til vare
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000061
    m_Localized: 'Rediger: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000062
    m_Localized: "1 vare har g\xE5tt ut p\xE5 dato"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000063
    m_Localized: "{0} varer har g\xE5tt ut p\xE5 dato"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000064
    m_Localized: '{0} gjenstand er flyttet til avfall'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000065
    m_Localized: '{0} gjenstander er flyttet til avfall'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000066
    m_Localized: "Navn p\xE5 listen"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000068
    m_Localized: Vis
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000069
    m_Localized: "Velg f\xF8rst et element."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000072
    m_Localized: Opprett
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000073
    m_Localized: "Skal jeg kaste 1 utg\xE5tt vare i matavfallet?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000074
    m_Localized: "Skal {0} utg\xE5tte varer legges i matavfallet?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000075
    m_Localized: denne varen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000080
    m_Localized: "Velg type m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000085
    m_Localized: "Antallet m\xE5 v\xE6re st\xF8rre enn 0"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000086
    m_Localized: "Kunne ikke lagre avfallsoppf\xF8ringen"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000088
    m_Localized: Feil ved innlasting av matavfallsloggen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000089
    m_Localized: Kunne ikke laste inn varen
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000090
    m_Localized: Kunne ikke lagre elementet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000091
    m_Localized: Feil ved innlasting av pantry
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000093
    m_Localized: "Kunne ikke legge til varen: det kan v\xE6re at produktet mangler
      n\xF8dvendige opplysninger"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000094
    m_Localized: Kunne ikke legge til et kategorielement
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000096
    m_Localized: Ugyldig handleliste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000097
    m_Localized: Kunne ikke laste inn varene
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000098
    m_Localized: "Kunne ikke s\xF8ke etter produkter"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000099
    m_Localized: "Det var ikke mulig \xE5 legge til varen"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000100
    m_Localized: "Det var ikke mulig \xE5 importere det valgte produktet"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000101
    m_Localized: "Det var ikke mulig \xE5 legge til elementet i listen"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000102
    m_Localized: "Det var ikke mulig \xE5 oppdatere elementet"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000103
    m_Localized: "Det var ikke mulig \xE5 slette elementet"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000104
    m_Localized: Kunne ikke fjerne avkryssede varer
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000105
    m_Localized: Feil ved innlasting av lister
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000106
    m_Localized: "Navnet p\xE5 listen er obligatorisk"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000107
    m_Localized: "Det var ikke mulig \xE5 opprette listen"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000108
    m_Localized: "Det var ikke mulig \xE5 slette listen"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000109
    m_Localized: Det kreves en invitasjonskode
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000110
    m_Localized: Ugyldig invitasjonskode, eller du er allerede medlem
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000111
    m_Localized: Navn er obligatorisk
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000112
    m_Localized: Feil ved opprettelse av gruppe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000113
    m_Localized: Feil ved innlasting av grupper
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000114
    m_Localized: "Innloggingen mislyktes. Pr\xF8v p\xE5 nytt."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000115
    m_Localized: "Jeg godtar vilk\xE5rene og betingelsene"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000116
    m_Localized: Laster inn data...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000117
    m_Localized: "Det gikk ikke \xE5 laste inn dataene. Pr\xF8v p\xE5 nytt."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000118
    m_Localized: Det oppstod en feil ved innlasting av data.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000119
    m_Localized: "Det gikk ikke an \xE5 lagre profilen. Pr\xF8v p\xE5 nytt."
