  - m_Id: 467936468992
    m_Localized: Meny
    m_Metadata:
      m_Items: []
  - m_Id: 8970780532736
    m_Localized: "M\xE5ltidslogg"
    m_Metadata:
      m_Items: []
  - m_Id: 9243779391488
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 2541068313681920
    m_Localized: Laster
    m_Metadata:
      m_Items: []
  - m_Id: 18113535941795840
    m_Localized: Laster inn ressurser
    m_Metadata:
      m_Items: []
  - m_Id: 18114763199340544
    m_Localized: Kontroll av autentisering
    m_Metadata:
      m_Items: []
  - m_Id: 18417184911908864
    m_Localized: "Lek, l\xE6r og spis sunnere: sammen bidrar vi til forandringen."
    m_Metadata:
      m_Items: []
  - m_Id: 18417602513592320
    m_Localized: Brukernavn
    m_Metadata:
      m_Items: []
  - m_Id: 18417848396275712
    m_Localized: Brukernavnet ditt
    m_Metadata:
      m_Items: []
  - m_Id: 18418052671463424
    m_Localized: Passord
    m_Metadata:
      m_Items: []
  - m_Id: 18418114709413888
    m_Localized: Passordet ditt
    m_Metadata:
      m_Items: []
  - m_Id: 22812687661522944
    m_Localized: E-post
    m_Metadata:
      m_Items: []
  - m_Id: 22812856394178560
    m_Localized: E-postadressen din
    m_Metadata:
      m_Items: []
  - m_Id: 22819676332482560
    m_Localized: Bostedsland
    m_Metadata:
      m_Items: []
  - m_Id: 22819860558897152
    m_Localized: Velg landet du bor i
    m_Metadata:
      m_Items: []
  - m_Id: 22820314747494400
    m_Localized: Region
    m_Metadata:
      m_Items: []
  - m_Id: 22820425670057984
    m_Localized: Velg din region
    m_Metadata:
      m_Items: []
  - m_Id: 25345767223844864
    m_Localized: "Jeg godtar <b>vilk\xE5rene for bruk</b> og <b>personvernreglene</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 25351728189661184
    m_Localized: "Vilk\xE5r og betingelser"
    m_Metadata:
      m_Items: []
  - m_Id: 25353163560181760
    m_Localized: Godta
    m_Metadata:
      m_Items: []
  - m_Id: 25353325686808576
    m_Localized: Avbryt
    m_Metadata:
      m_Items: []
  - m_Id: 25353803774550016
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 25354482861727744
    m_Localized: Feil
    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: Validering av feltene mislyktes
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: "Dette feltet m\xE5 ikke v\xE6re tomt."
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: Vennligst oppgi en gyldig e-postadresse.
    m_Metadata:
      m_Items: []
  - m_Id: 25358751560097792
    m_Localized: "Passordet m\xE5 best\xE5 av minst 6 tegn."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284416
    m_Localized: "Ugyldig f\xF8dsels\xE5r."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284417
    m_Localized: "Du m\xE5 v\xE6re over 18 \xE5r for \xE5 kunne bruke plattformen."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284418
    m_Localized: "Du m\xE5 velge et land."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284419
    m_Localized: "Du m\xE5 velge en region."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284420
    m_Localized: Ugyldig postnummerformat.
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284421
    m_Localized: "Du m\xE5 godta vilk\xE5rene og betingelsene for \xE5 fortsette."
    m_Metadata:
      m_Items: []
  - m_Id: 25367919163596800
    m_Localized: Logg inn
    m_Metadata:
      m_Items: []
  - m_Id: 25368981371084800
    m_Localized: Har du glemt passordet ditt?
    m_Metadata:
      m_Items: []
  - m_Id: 25369431499595776
    m_Localized: Har du ikke en konto? Registrer deg
    m_Metadata:
      m_Items: []
  - m_Id: 25394900353671168
    m_Localized: Tilbakestill passord
    m_Metadata:
      m_Items: []
  - m_Id: 25395075277119488
    m_Localized: "Skriv inn e-postadressen din, s\xE5 sender vi deg en lenke for
      \xE5 tilbakestille passordet ditt."
    m_Metadata:
      m_Items: []
  - m_Id: 25395779614007296
    m_Localized: Fortsett
    m_Metadata:
      m_Items: []
  - m_Id: 25395959562231808
    m_Localized: Tilbake
    m_Metadata:
      m_Items: []
  - m_Id: 27512489452232704
    m_Localized: Laster inn {global.PET_NAME}
    m_Metadata:
      m_Items:
      - rid: 4008881209995690410
  - m_Id: 27515040654417920
    m_Localized: Foody
    m_Metadata:
      m_Items: []
  - m_Id: 28204088708554752
    m_Localized: Varsler
    m_Metadata:
      m_Items: []
  - m_Id: 35547983100502016
    m_Localized: "Sammen skal vi knytte kj\xF8kkenet ditt til omsorgen for planeten.\n\nLag
      mat, l\xE6r, del og utvikle deg hver dag.\n\nEr du klar til \xE5 komme i gang?"
    m_Metadata:
      m_Items: []
  - m_Id: 35549851969118208
    m_Localized: Lag din egen avatar
    m_Metadata:
      m_Items: []
  - m_Id: 35549934412357632
    m_Localized: "Fullf\xF8r profilen din"
    m_Metadata:
      m_Items: []
  - m_Id: 35550076637011968
    m_Localized: "\xC5pne appen"
    m_Metadata:
      m_Items: []
  - m_Id: 38372841320603648
    m_Localized: Feil brukernavn eller passord
    m_Metadata:
      m_Items: []
  - m_Id: 38373129888718848
    m_Localized: Tjenesten ble ikke funnet
    m_Metadata:
      m_Items: []
  - m_Id: 38373203972710400
    m_Localized: "Ugyldig foresp\xF8rsel"
    m_Metadata:
      m_Items: []
  - m_Id: 38373263087230976
    m_Localized: Serverfeil
    m_Metadata:
      m_Items: []
  - m_Id: 38373338052026368
    m_Localized: 'Tilkoblingsfeil: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 38380494998462464
    m_Localized: Ugyldig svar fra serveren
    m_Metadata:
      m_Items: []
  - m_Id: 38381013338939392
    m_Localized: 'Uventet feil: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 38381665582571520
    m_Localized: Ugyldige registreringsopplysninger
    m_Metadata:
      m_Items: []
  - m_Id: 38382047729803264
    m_Localized: Brukeren finnes allerede
    m_Metadata:
      m_Items: []
  - m_Id: 38465117124288512
    m_Localized: Oppmerksomhet!
    m_Metadata:
      m_Items: []
  - m_Id: 38465306467753984
    m_Localized: 'Denne handlingen vil slette alle opplysningene dine permanent fra
      plattformen.


      Er du sikker?'
    m_Metadata:
      m_Items: []
