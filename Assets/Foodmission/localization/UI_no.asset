  - m_Id: 48825971850076160
    m_Localized: Slette oppskrift?
    m_Metadata:
      m_Items: []
  - m_Id: 48826426596515840
    m_Localized: "Er du sikker p\xE5 at du vil slette denne oppskriften?"
    m_Metadata:
      m_Items: []
  - m_Id: 48876441641672704
    m_Localized: "I g\xE5r"
    m_Metadata:
      m_Items: []
  - m_Id: 48876441641672705
    m_Localized: "Er du sikker p\xE5 at du vil slette denne m\xE5ltidsloggen?"
    m_Metadata:
      m_Items: []
  - m_Id: 48876441641672706
    m_Localized: "M\xE5ltidslogg ble slettet"
    m_Metadata:
      m_Items: []
  - m_Id: 48876441641672707
    m_Localized: "Redigerer m\xE5ltid: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 48876441641672708
    m_Localized: "Redigerer m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 48876441641672709
    m_Localized: Lagre endringer
    m_Metadata:
      m_Items: []
  - m_Id: 48876441641672711
    m_Localized: "M\xE5ltid ble oppdatert"
    m_Metadata:
      m_Items: []
  - m_Id: 49247263887712256
    m_Localized: "Forenklet m\xE5ltidslogg"
    m_Metadata:
      m_Items: []
  - m_Id: 49247263887712257
    m_Localized: Hva var de viktigste kjennetegnene ved retten din?
    m_Metadata:
      m_Items: []
  - m_Id: 49247263887712258
    m_Localized: Navn eller beskrivelse (valgfritt)
    m_Metadata:
      m_Items: []
  - m_Id: 49247263887712259
    m_Localized: "F.eks.: Lins- og gr\xF8nnsakssalat"
    m_Metadata:
      m_Items: []
  - m_Id: 49260137687277568
    m_Localized: "Oppdrag fullf\xF8rt!"
    m_Metadata:
      m_Items: []
  - m_Id: 49260137691471872
    m_Localized: "Utfordring fullf\xF8rt!"
    m_Metadata:
      m_Items: []
  - m_Id: 49265187998392320
    m_Localized: "Vaner og b\xE6rekraftig mat"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380160
    m_Localized: "Kj\xF8ttfri / vegetarisk mat"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380161
    m_Localized: Erstatninger for matvarer (Swaps)
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380162
    m_Localized: "Ern\xE6ring og helse"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380163
    m_Localized: Andel av inntatte belgfrukter
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380164
    m_Localized: "100 % plantebasert / vegansk m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380165
    m_Localized: "Et balansert m\xE5ltid (\xBD gr\xF8nnsaker, \xBC proteiner, \xBC
      karbohydrater)"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380166
    m_Localized: Tradisjonelle korn eller fullkorn
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380167
    m_Localized: "Knoll eller alternativt hovedn\xE6ringsmiddel"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380168
    m_Localized: "Antall kj\xF8ttstykker som er telt"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380169
    m_Localized: "En porsjon ferske gr\xF8nnsaker eller salat"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380170
    m_Localized: "100 % fullkornsbr\xF8d eller fullkornsprodukter"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380171
    m_Localized: "Et m\xE5ltid med h\xF8yt innhold av kostfiber"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380172
    m_Localized: Ingen tilsatt salt ved bordet
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380173
    m_Localized: "Sunn fett (olivenolje, n\xF8tter)"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589228380174
    m_Localized: "Ingen tilsatt sukker eller industrielt fremstilt s\xF8tsaker"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574464
    m_Localized: "100 % plantebasert eller kj\xF8ttfritt m\xE5ltid?"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574465
    m_Localized: "Inneholdt den ferske gr\xF8nnsaker eller belgfrukter?"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574466
    m_Localized: "B\xE6rekraftig tallerken eller alternativt korn?"
    m_Metadata:
      m_Items: []
  - m_Id: 49269589232574467
    m_Localized: 'Velg hvilken erstatning som er gjort:'
    m_Metadata:
      m_Items: []
  - m_Id: 49495302372057088
    m_Localized: "M\xE5ltid og fremgang er registrert!"
    m_Metadata:
      m_Items: []
  - m_Id: 49525565470793728
    m_Localized: "Vennligst velg minst ett m\xE5ltidsalternativ."
    m_Metadata:
      m_Items: []
