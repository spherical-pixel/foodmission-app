    m_Metadata:
      m_Items: []
  - m_Id: 39910434310971392
    m_Localized: Det globale samfunnet
    m_Metadata:
      m_Items: []
  - m_Id: 39910459409686528
    m_Localized: Kart
    m_Metadata:
      m_Items: []
  - m_Id: 39910482159591424
    m_Localized: Merk alle som lest
    m_Metadata:
      m_Items: []
  - m_Id: 39910503894335488
    m_Localized: Ingen varsler
    m_Metadata:
      m_Items: []
  - m_Id: 39915502649204736
    m_Localized: "Din ern\xE6ringsmessige intelligensstatus"
    m_Metadata:
      m_Items: []
  - m_Id: 39915588338835456
    m_Localized: Helse
    m_Metadata:
      m_Items: []
  - m_Id: 39915847026728960
    m_Localized: "B\xE6rekraft"
    m_Metadata:
      m_Items: []
  - m_Id: 39915896439824384
    m_Localized: Kunnskap
    m_Metadata:
      m_Items: []
  - m_Id: 39916671006138368
    m_Localized: I dag
    m_Metadata:
      m_Items: []
  - m_Id: 39916733786480640
    m_Localized: Uke
    m_Metadata:
      m_Items: []
  - m_Id: 39916761389195264
    m_Localized: "M\xE5ned"
    m_Metadata:
      m_Items: []
  - m_Id: 39916799158902784
    m_Localized: Meg
    m_Metadata:
      m_Items: []
  - m_Id: 39916808910659584
    m_Localized: Gruppe
    m_Metadata:
      m_Items: []
  - m_Id: 40182439656546304
    m_Localized: Opprett din konto
    m_Metadata:
      m_Items: []
  - m_Id: 40270284408741888
    m_Localized: "Kj\xF8nn"
    m_Metadata:
      m_Items: []
  - m_Id: 40270509588340736
    m_Localized: "Fullf\xF8r profilen din"
    m_Metadata:
      m_Items: []
  - m_Id: 40270634402439168
    m_Localized: "Denne informasjonen hjelper oss med \xE5 tilpasse opplevelsen din"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000001
    m_Localized: E-posten er sendt. Sjekk innboksen din.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000002
    m_Localized: "Det gikk ikke an \xE5 sende e-posten for tilbakestilling. Pr\xF8v
      p\xE5 nytt."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000003
    m_Localized: Suksess
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000004
    m_Localized: "Logg m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000005
    m_Localized: "M\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000006
    m_Localized: "S\xF8k etter retter..."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000007
    m_Localized: "Lag et m\xE5ltid"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000008
    m_Localized: "M\xE5ltidstype"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000009
    m_Localized: Fra spiskammeret
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000010
    m_Localized: Spist ute
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000011
    m_Localized: Velg varer som skal trekkes fra spiskammeret
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000013
    m_Localized: "Avfall fra t\xF8mming av logger"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000014
    m_Localized: Matvare
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000015
    m_Localized: "Mengde som g\xE5r til spille"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000016
    m_Localized: Grunn til avfall
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000017
    m_Localized: "P\xE5visningsmetode"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000018
    m_Localized: "Ansl\xE5tt kostnad (\u20AC)"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000019
    m_Localized: Merknader
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000020
    m_Localized: Lagre
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000021
    m_Localized: Filtrer elementer...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000022
    m_Localized: Flytt til avfall
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "Spiskammeret ditt er tomt. Trykk p\xE5 + for \xE5 legge til varer."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000024
    m_Localized: Matsvinn
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000025
    m_Localized: "Det er ikke registrert noe avfall enn\xE5. Trykk p\xE5 + for \xE5
      registrere avfall."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000026
    m_Localized: "M\xE5ltidslogg"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000027
    m_Localized: "Det er ikke registrert noen m\xE5ltider enn\xE5. Trykk p\xE5 +
      for \xE5 registrere ditt f\xF8rste m\xE5ltid."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000028
    m_Localized: Handlelister
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000029
    m_Localized: "Det er ingen handlelister enn\xE5. Trykk p\xE5 \xABNy liste\xBB
      for \xE5 opprette en."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000030
    m_Localized: Ny liste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000031
    m_Localized: Handleliste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000032
    m_Localized: Ferdig
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000033
    m_Localized: "Ingen varer enn\xE5. Legg til noen produkter."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000034
    m_Localized: Vare
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000035
    m_Localized: Antall
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000036
    m_Localized: Enhet
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000038
    m_Localized: "Utl\xF8psdato"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000040
    m_Localized: Slett
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000042
    m_Localized: Velg...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000047
    m_Localized: Hopp over
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000048
    m_Localized: Lagre og fortsett
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000049
    m_Localized: "Avslutt uten \xE5 lagre"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000050
    m_Localized: Bekreft
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000051
    m_Localized: Kalorier, karbonavtrykk, utgifter, proteiner
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000052
    m_Localized: Forbrukte kalorier
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000053
    m_Localized: Venstre
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000054
    m_Localized: "Skal \xAB{0}\xBB slettes?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000055
    m_Localized: Slett logg
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000056
    m_Localized: Slett liste
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000057
    m_Localized: "Slett avfallsoppf\xF8ring"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000058
    m_Localized: Ny handleliste
    m_Metadata:
