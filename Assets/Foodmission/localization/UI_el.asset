    m_Localized: "\u03A0\u03CC\u03C3\u03BF \u03C3\u03C5\u03C7\u03BD\u03AC \u03BA\u03B1\u03C4\u03B1\u03BD\u03B1\u03BB\u03CE\u03BD\u03B5\u03C4\u03B5
