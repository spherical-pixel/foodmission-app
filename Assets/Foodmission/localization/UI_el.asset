  - m_Id: 35547983100502016
    m_Localized: "\u039C\u03B1\u03B6\u03AF, \u03B8\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03C4\u03B7\u03BD \u03BA\u03BF\u03C5\u03B6\u03AF\u03BD\u03B1 \u03C3\u03B1\u03C2
      \u03BC\u03B5 \u03C4\u03B7 \u03C6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B4\u03B1
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03C0\u03BB\u03B1\u03BD\u03AE\u03C4\u03B7.\n\n\u039C\u03B1\u03B3\u03B5\u03B9\u03C1\u03AD\u03C8\u03C4\u03B5,
      \u03BC\u03AC\u03B8\u03B5\u03C4\u03B5, \u03BC\u03BF\u03B9\u03C1\u03B1\u03C3\u03C4\u03B5\u03AF\u03C4\u03B5
      \u03BA\u03B1\u03B9 \u03B5\u03BE\u03B5\u03BB\u03B9\u03C7\u03B8\u03B5\u03AF\u03C4\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03BC\u03AD\u03C1\u03B1.\n\n\u0395\u03AF\u03C3\u03C4\u03B5
