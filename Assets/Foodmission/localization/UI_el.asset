    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000019
    m_Localized: "\u03A3\u03B7\u03BC\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000020
    m_Localized: "\u0391\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C5\u03C3\u03B7"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000021
    m_Localized: "\u03A6\u03B9\u03BB\u03C4\u03C1\u03AC\u03C1\u03B9\u03C3\u03BC\u03B1
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03C9\u03BD..."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000022
    m_Localized: "\u039C\u03B5\u03C4\u03B1\u03C6\u03BF\u03C1\u03AC \u03C0\u03C1\u03BF\u03C2
      \u03C4\u03B1 \u03B1\u03C0\u03BF\u03C1\u03C1\u03AF\u03BC\u03BC\u03B1\u03C4\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "\u03A4\u03BF \u03BD\u03C4\u03BF\u03C5\u03BB\u03AC\u03C0\u03B9 \u03C3\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AC\u03B4\u03B5\u03B9\u03BF. \u03A0\u03AC\u03C4\u03B7\u03C3\u03B5
      \u03C4\u03BF + \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000024
    m_Localized: "\u03A3\u03C0\u03B1\u03C4\u03AC\u03BB\u03B7 \u03C4\u03C1\u03BF\u03C6\u03AF\u03BC\u03C9\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000025
    m_Localized: "\u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF
      \u03B1\u03BA\u03CC\u03BC\u03B7 \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1 \u03B1\u03C0\u03CC\u03B2\u03BB\u03B7\u03C4\u03BF.
      \u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF + \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5
      \u03B1\u03C0\u03CC\u03B2\u03BB\u03B7\u03C4\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000026
    m_Localized: "\u0397\u03BC\u03B5\u03C1\u03BF\u03BB\u03CC\u03B3\u03B9\u03BF \u03B3\u03B5\u03C5\u03BC\u03AC\u03C4\u03C9\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000027
    m_Localized: "\u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF
      \u03B1\u03BA\u03CC\u03BC\u03B1 \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1 \u03B3\u03B5\u03CD\u03BC\u03B1.
      \u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF \xAB+\xBB \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5
      \u03C4\u03BF \u03C0\u03C1\u03CE\u03C4\u03BF \u03C3\u03B1\u03C2 \u03B3\u03B5\u03CD\u03BC\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000028
    m_Localized: "\u039B\u03AF\u03C3\u03C4\u03B5\u03C2 \u03B1\u03B3\u03BF\u03C1\u03CE\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000029
    m_Localized: "\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD
      \u03B1\u03BA\u03CC\u03BC\u03B1 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03B1\u03B3\u03BF\u03C1\u03CE\u03BD.
      \u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 \xAB\u039D\u03AD\u03B1 \u03BB\u03AF\u03C3\u03C4\u03B1\xBB
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03BC\u03AF\u03B1."
    m_Metadata:
      m_Items: []
