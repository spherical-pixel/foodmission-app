    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000075
    m_Localized: "\u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000076
    m_Localized: "\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE
      \u03B7 \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03B3\u03B5\u03C5\u03BC\u03AC\u03C4\u03C9\u03BD.
      \u0395\u03BB\u03AD\u03B3\u03BE\u03C4\u03B5 \u03C4\u03B7 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03AE
      \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000077
    m_Localized: "\u03A0\u03BB\u03B7\u03BA\u03C4\u03C1\u03BF\u03BB\u03BF\u03B3\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03B5\u03BD\u03CC\u03C2 \u03B3\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000078
    m_Localized: "\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE
      \u03B7 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B3\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000079
    m_Localized: "\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C0\u03C1\u03CE\u03C4\u03B1
      \u03AD\u03BD\u03B1 \u03B3\u03B5\u03CD\u03BC\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000080
    m_Localized: "\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03BF\u03BD
      \u03C4\u03CD\u03C0\u03BF \u03B3\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000081
    m_Localized: "\u0394\u03B5\u03BD \u03BA\u03B1\u03C4\u03AD\u03C3\u03C4\u03B7 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC
      \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF \u03C4\u03BF
      \u03B3\u03B5\u03CD\u03BC\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000082
    m_Localized: "\u03A4\u03BF \u03B3\u03B5\u03CD\u03BC\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5,
      \u03B1\u03BB\u03BB\u03AC \u03B4\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE
      \u03B7 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03BD\u03C4\u03BF\u03C5\u03BB\u03B1\u03C0\u03B9\u03BF\u03CD. \u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE,
      \u03B5\u03BB\u03AD\u03B3\u03BE\u03C4\u03B5 \u03C4\u03B1 \u03B5\u03AF\u03B4\u03B7
      \u03C4\u03BF\u03C5 \u03BD\u03C4\u03BF\u03C5\u03BB\u03B1\u03C0\u03B9\u03BF\u03CD
      \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000083
    m_Localized: "\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7
      \u03C6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B7\u03BC\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03BF\u03C5
      \u03B3\u03B5\u03C5\u03BC\u03AC\u03C4\u03C9\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000084
    m_Localized: "\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C0\u03C1\u03CE\u03C4\u03B1
      \u03AD\u03BD\u03B1 \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03BD\u03C4\u03BF\u03C5\u03BB\u03AC\u03C0\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000085
    m_Localized: "\u0397 \u03C0\u03BF\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7
      \u03B1\u03C0\u03CC 0"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000086
    m_Localized: "\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE
      \u03B7 \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C5\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03B1\u03C0\u03BF\u03B2\u03BB\u03AE\u03C4\u03C9\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000087
    m_Localized: "\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE
      \u03B7 \u03B1\u03BD\u03B1\u03BD\u03AD\u03C9\u03C3\u03B7. \u0395\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B4\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C1\u03B9\u03BD\u03AE \u03BC\u03BD\u03AE\u03BC\u03B7."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000088
    m_Localized: "\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7
      \u03C6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03B1\u03C0\u03BF\u03C1\u03C1\u03B9\u03BC\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03C4\u03C1\u03BF\u03C6\u03AF\u03BC\u03C9\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000089
    m_Localized: "\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE
      \u03B7 \u03C6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF\u03C5"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000090
    m_Localized: "\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE
      \u03B7 \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C5\u03C3\u03B7 \u03C4\u03BF\u03C5
