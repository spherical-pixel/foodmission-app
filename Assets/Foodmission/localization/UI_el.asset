    m_Metadata:
      m_Items: []
  - m_Id: 22819860558897152
    m_Localized: "\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03B7 \u03C7\u03CE\u03C1\u03B1
      \u03C3\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 22820314747494400
    m_Localized: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE"
    m_Metadata:
      m_Items: []
  - m_Id: 22820425670057984
    m_Localized: "\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03C3\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 22820717341958144
    m_Localized: "\u03A4\u03B1\u03C7\u03C5\u03B4\u03C1\u03BF\u03BC\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03CE\u03B4\u03B9\u03BA\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 25345767223844864
    m_Localized: "\u03A3\u03C5\u03BC\u03C6\u03C9\u03BD\u03CE \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      <b>\u038C\u03C1\u03BF\u03C5\u03C2 \u03A0\u03B1\u03C1\u03BF\u03C7\u03AE\u03C2
      \u03A5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03CE\u03BD</b> \u03BA\u03B1\u03B9
      \u03C4\u03B7\u03BD <b>\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u0391\u03C0\u03BF\u03C1\u03C1\u03AE\u03C4\u03BF\u03C5</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 25351728189661184
    m_Localized: "\u038C\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03A0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 25351921299611648
    m_Localized: "<b>\u038C\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03A0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      FOODMISSION</b>\n\n\u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03B1\u03C5\u03C4\u03AE\u03BD \u03C4\u03B7\u03BD \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE,
      \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B5\u03AF\u03C4\u03B5 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03B1\u03BA\u03CC\u03BB\u03BF\u03C5\u03B8\u03BF\u03C5\u03C2 \u03CC\u03C1\u03BF\u03C5\u03C2:\n\n<b>1.
      \u0395\u0393\u0393\u03A1\u0391\u03A6\u0397 \u039B\u039F\u0393\u0391\u03A1\u0399\u0391\u03A3\u039C\u039F\u03A5</b>\n\u03A0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03C4\u03B5 \u03B1\u03BA\u03C1\u03B9\u03B2\u03B5\u03AF\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BB\u03AE\u03C1\u03B5\u03B9\u03C2 \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE.
      \u0395\u03AF\u03C3\u03C4\u03B5 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B5\u03BC\u03C0\u03B9\u03C3\u03C4\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03C4\u03C9\u03BD \u03B4\u03B9\u03B1\u03C0\u03B9\u03C3\u03C4\u03B5\u03C5\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD
      \u03C4\u03BF\u03C5 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD
      \u03C3\u03B1\u03C2.\n\n<b>2. \u0391\u03A0\u039F\u03A1\u03A1\u0397\u03A4\u039F</b>\n\u03A3\u03C5\u03BB\u03BB\u03AD\u03B3\u03BF\u03C5\u03BC\u03B5
      \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B5\u03BE\u03B5\u03C1\u03B3\u03B1\u03B6\u03CC\u03BC\u03B1\u03C3\u03C4\u03B5
      \u03C4\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AC \u03C3\u03B1\u03C2
      \u03B4\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03B1 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u0391\u03C0\u03BF\u03C1\u03C1\u03AE\u03C4\u03BF\u03C5 \u03BC\u03B1\u03C2.
      \u0391\u03C5\u03C4\u03CC \u03C0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03B4\u03B9\u03B1\u03C4\u03C1\u03BF\u03C6\u03B9\u03BA\u03AC \u03B4\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03B1,
      \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2 \u03C4\u03BF\u03C0\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B1\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1 \u03C7\u03C1\u03AE\u03C3\u03B7\u03C2.\n\n\u0393\u03B9\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2 \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2,
      \u03B5\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AE\u03C3\u03C4\u03B5
      \u03BC\u03B1\u03B6\u03AF \u03BC\u03B1\u03C2 \u03C3\u03C4\u03B7 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7
      support@foodmission.eu<b>\u038C\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03A0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      FOODMISSION</b>\n\n\u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03B1\u03C5\u03C4\u03AE\u03BD \u03C4\u03B7\u03BD \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE,
      \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B5\u03AF\u03C4\u03B5 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03B1\u03BA\u03CC\u03BB\u03BF\u03C5\u03B8\u03BF\u03C5\u03C2 \u03CC\u03C1\u03BF\u03C5\u03C2:\n\n\u0393\u03B9\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2 \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2,
      \u03B5\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AE\u03C3\u03C4\u03B5
      \u03BC\u03B1\u03B6\u03AF \u03BC\u03B1\u03C2 \u03C3\u03C4\u03B7 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7
      support@foodmission.eu"
    m_Metadata:
      m_Items: []
  - m_Id: 25353163560181760
    m_Localized: "\u0391\u03C0\u03BF\u03B4\u03AD\u03C7\u03BF\u03BC\u03B1\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 25353325686808576
    m_Localized: "\u039C\u03B1\u03C4\u03B1\u03AF\u03C9\u03C3\u03B7"
    m_Metadata:
      m_Items: []
  - m_Id: 25353803774550016
    m_Localized: "\u0395\u03BD\u03C4\u03AC\u03BE\u03B5\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 25354482861727744
    m_Localized: "\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: "\u0397 \u03B5\u03C0\u03B9\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 \u03C0\u03B5\u03B4\u03AF\u03C9\u03BD
      \u03B1\u03C0\u03AD\u03C4\u03C5\u03C7\u03B5"
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: "\u0391\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03B5\u03B4\u03AF\u03BF
      \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B5\u03BD\u03CC."
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: "\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B5
      \u03BC\u03B9\u03B1 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B7 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7
      \u03B7\u03BB\u03B5\u03BA\u03C4\u03C1\u03BF\u03BD\u03B9\u03BA\u03BF\u03CD \u03C4\u03B1\u03C7\u03C5\u03B4\u03C1\u03BF\u03BC\u03B5\u03AF\u03BF\u03C5."
    m_Metadata:
      m_Items: []
  - m_Id: 25358751560097792
    m_Localized: "\u039F \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03AD\u03C7\u03B5\u03B9
      \u03BC\u03AE\u03BA\u03BF\u03C2 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD
      6 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B5\u03C2."
