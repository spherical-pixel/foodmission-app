  - m_Id: 41000000000000074
    m_Localized: "\u039D\u03B1 \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03C9 {0}
      \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03B1 \u03C0\u03BF\u03C5 \u03AD\u03C7\u03BF\u03C5\u03BD
