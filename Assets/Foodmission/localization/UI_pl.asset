    m_Metadata:
      m_Items: []
  - m_Id: 40182439656546304
    m_Localized: "Za\u0142\xF3\u017C konto"
    m_Metadata:
      m_Items: []
  - m_Id: 40270284408741888
    m_Localized: "P\u0142e\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 40270509588340736
    m_Localized: "Uzupe\u0142nij sw\xF3j profil"
    m_Metadata:
      m_Items: []
  - m_Id: 40270634402439168
    m_Localized: "Te informacje pomagaj\u0105 nam dostosowa\u0107 serwis do Twoich
      potrzeb"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000001
    m_Localized: "Wiadomo\u015B\u0107 e-mail zosta\u0142a wys\u0142ana. Sprawd\u017A
      swoj\u0105 skrzynk\u0119 odbiorcz\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000002
    m_Localized: "Nie uda\u0142o si\u0119 wys\u0142a\u0107 wiadomo\u015Bci e-mail
      z linkiem do resetowania has\u0142a. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
