    m_Localized: Powiadomienia
    m_Metadata:
      m_Items: []
  - m_Id: 35547983100502016
    m_Localized: "Razem po\u0142\u0105czymy Twoj\u0105 kuchni\u0119 z trosk\u0105     
      o planet\u0119.\\n\\nGotuj, ucz si\u0119, dziel si\u0119 i rozwijaj ka\u017Cdego     
      dnia.\\n\\nGotowy do startu?"
    m_Metadata:
      m_Items: []
