    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000039
    m_Localized: RRRR-MM-DD
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000040
    m_Localized: "Usu\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000041
    m_Localized: "Poziom aktywno\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000042
    m_Localized: Wybierz...
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000043
    m_Localized: "Preferencje \u017Cywieniowe"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000044
    m_Localized: Odpowiedzialne zakupy
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000045
    m_Localized: "Poziom wykszta\u0142cenia"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000046
    m_Localized: "Roczny doch\xF3d"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000047
    m_Localized: "Pomi\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000048
    m_Localized: Zapisz i kontynuuj
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000049
    m_Localized: Zamknij bez zapisywania
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000050
    m_Localized: "Potwierd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000051
    m_Localized: "Kalorie, \u015Blad w\u0119glowy, wydane kwoty, bia\u0142ka"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000052
    m_Localized: Spalone kalorie
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000053
    m_Localized: W lewo
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000054
    m_Localized: "Czy chcesz usun\u0105\u0107 \u201E{0}\u201D?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000055
    m_Localized: "Usu\u0144 dziennik"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000056
    m_Localized: "Usu\u0144 list\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000057
    m_Localized: "Usu\u0144 wpis dotycz\u0105cy odpad\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000058
    m_Localized: "Nowa lista zakup\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000059
    m_Localized: Lista zmian nazw
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000060
    m_Localized: "Dodaj pozycj\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000061
    m_Localized: 'Edytuj: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000062
    m_Localized: "1 pozycja straci\u0142a wa\u017Cno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000063
    m_Localized: "{0} pozycji straci\u0142o wa\u017Cno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000064
    m_Localized: "{0} pozycja przeniesiona do odpad\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000065
    m_Localized: "{0} pozycji przeniesiono do odpad\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000066
    m_Localized: Nazwa listy
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000067
    m_Localized: "Ilo\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000068
    m_Localized: "Wy\u015Bwietl"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000069
    m_Localized: Najpierw wybierz produkt.
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000070
    m_Localized: "Nie uda\u0142o si\u0119 doda\u0107 wybranego elementu."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000071
    m_Localized: 'Max: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000072
    m_Localized: "Utw\xF3rz"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000073
    m_Localized: "Czy mo\u017Cna wyrzuci\u0107 1 przeterminowany produkt do pojemnika
      na odpady spo\u017Cywcze?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000074
    m_Localized: "Przenie\u015B\u0107 {0} przeterminowanych produkt\xF3w do pojemnika
      na odpady spo\u017Cywcze?"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000075
    m_Localized: ten produkt
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000076
    m_Localized: "Nie uda\u0142o si\u0119 wyszuka\u0107 posi\u0142k\xF3w. Sprawd\u017A
      po\u0142\u0105czenie."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000077
    m_Localized: "Wpisz nazw\u0119 posi\u0142ku"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000078
    m_Localized: "Nie uda\u0142o si\u0119 utworzy\u0107 posi\u0142ku"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000079
    m_Localized: "Najpierw wybierz posi\u0142ek"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000080
    m_Localized: "Wybierz rodzaj posi\u0142ku"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000081
    m_Localized: "Nie uda\u0142o si\u0119 zarejestrowa\u0107 posi\u0142ku"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000082
    m_Localized: "Posi\u0142ek zosta\u0142 zarejestrowany, ale nie uda\u0142o si\u0119
      zaktualizowa\u0107 zawarto\u015Bci spi\u017Carni. Sprawd\u017A prosz\u0119
      zawarto\u015B\u0107 swojej spi\u017Carni."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000083
    m_Localized: "Wyst\u0105pi\u0142 b\u0142\u0105d podczas wczytywania dziennika
      posi\u0142k\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000084
    m_Localized: "Najpierw wybierz produkt spo\u017Cywczy"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000085
    m_Localized: "Ilo\u015B\u0107 musi by\u0107 wi\u0119ksza od 0"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000086
    m_Localized: "Nie uda\u0142o si\u0119 zapisa\u0107 wpisu dotycz\u0105cego odpad\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000087
    m_Localized: "Nie uda\u0142o si\u0119 od\u015Bwie\u017Cy\u0107 strony. Wy\u015Bwietlane
      s\u0105 dane z pami\u0119ci podr\u0119cznej."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000088
    m_Localized: "Wyst\u0105pi\u0142 b\u0142\u0105d podczas wczytywania dziennika
      odpad\xF3w spo\u017Cywczych"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000089
    m_Localized: "Nie uda\u0142o si\u0119 za\u0142adowa\u0107 elementu"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000090
    m_Localized: "Nie uda\u0142o si\u0119 zapisa\u0107 elementu"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000091
    m_Localized: "Wyst\u0105pi\u0142 b\u0142\u0105d podczas wczytywania zawarto\u015Bci
      spi\u017Carni"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000092
    m_Localized: "Nie uda\u0142o si\u0119 zaimportowa\u0107 jedzenia: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000093
    m_Localized: "Nie uda\u0142o si\u0119 doda\u0107 pozycji: w produkcie mog\u0105
      brakowa\u0107 wymaganych danych"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000094
    m_Localized: "Nie uda\u0142o si\u0119 doda\u0107 pozycji do kategorii"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000095
    m_Localized: "Automatycznie wykryty element, kt\xF3rego termin wa\u017Cno\u015Bci
      up\u0142yn\u0105\u0142"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000096
    m_Localized: "Nieprawid\u0142owa lista zakup\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000097
    m_Localized: "Nie uda\u0142o si\u0119 za\u0142adowa\u0107 element\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000098
    m_Localized: "Nie uda\u0142o si\u0119 wyszuka\u0107 produkt\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000099
    m_Localized: "Nie uda\u0142o si\u0119 doda\u0107 pozycji"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000100
    m_Localized: "Nie uda\u0142o si\u0119 zaimportowa\u0107 wybranego produktu"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000101
    m_Localized: "Nie uda\u0142o si\u0119 doda\u0107 pozycji do listy"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000102
    m_Localized: "Nie uda\u0142o si\u0119 zaktualizowa\u0107 pozycji"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000103
    m_Localized: "Nie uda\u0142o si\u0119 usun\u0105\u0107 elementu"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000104
    m_Localized: "Nie uda\u0142o si\u0119 usun\u0105\u0107 zako\u0144czonych pozycji"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000105
    m_Localized: "Wyst\u0105pi\u0142 b\u0142\u0105d podczas wczytywania list"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000106
    m_Localized: Nazwa listy jest wymagana
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000107
    m_Localized: "Nie uda\u0142o si\u0119 utworzy\u0107 listy"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000108
    m_Localized: "Nie uda\u0142o si\u0119 usun\u0105\u0107 listy"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000109
    m_Localized: Wymagany jest kod zaproszeniowy
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000110
    m_Localized: "Nieprawid\u0142owy kod zaproszenia lub jeste\u015B ju\u017C cz\u0142onkiem"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000111
    m_Localized: "Pole \u201EImi\u0119\u201D jest obowi\u0105zkowe"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000112
    m_Localized: "B\u0142\u0105d podczas tworzenia grupy"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000113
    m_Localized: "Wyst\u0105pi\u0142 b\u0142\u0105d podczas wczytywania grup"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000114
    m_Localized: "Logowanie nie powiod\u0142o si\u0119. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000115
    m_Localized: "Akceptuj\u0119 Warunki korzystania z serwisu"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000116
    m_Localized: "\u0141adowanie danych..."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000117
    m_Localized: "Nie uda\u0142o si\u0119 za\u0142adowa\u0107 danych. Spr\xF3buj
      ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000118
    m_Localized: "Wyst\u0105pi\u0142 b\u0142\u0105d podczas \u0142adowania danych."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000119
    m_Localized: "Nie uda\u0142o si\u0119 zapisa\u0107 profilu. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000120
    m_Localized: "Wyst\u0105pi\u0142 nieoczekiwany b\u0142\u0105d. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000121
    m_Localized: "Wyst\u0105pi\u0142 nieoczekiwany b\u0142\u0105d"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000122
    m_Localized: "Nie uda\u0142o si\u0119 doda\u0107: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000123
    m_Localized: Nieznane
    m_Metadata:
      m_Items: []
  - m_Id: 7590946791424
    m_Localized: "\u015Aniadanie"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985728
    m_Localized: Obiad
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985729
