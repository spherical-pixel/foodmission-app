  - m_Id: 20629525997019136
    m_Localized: Rozumiem!
    m_Metadata:
      m_Items: []
  - m_Id: 25687180457271296
    m_Localized: '{0} razy w tygodniu'
    m_Metadata:
      m_Items:
      - rid: 4008881209995690411
  - m_Id: 25682128132890624
    m_Localized: "{0} posi\u0142k\xF3w tygodniowo"
    m_Metadata:
      m_Items:
      - rid: 4008881209995690411
  - m_Id: 25699605365645312
    m_Localized: "{0} dzia\u0142a\u0144 tygodniowo"
    m_Metadata:
      m_Items:
      - rid: 4008881209995690411
  - m_Id: 25708140598124544
    m_Localized: Krok {0} z {1}
    m_Metadata:
      m_Items:
      - rid: 4008881209995690411
  - m_Id: 25683680096673792
    m_Localized: Nigdy
    m_Metadata:
      m_Items: []
  - m_Id: 25683693593944064
    m_Localized: "Rzadziej ni\u017C raz w tygodniu"
    m_Metadata:
      m_Items: []
  - m_Id: 25707081205014528
    m_Localized: "Wy\u015Blij"
    m_Metadata:
      m_Items: []
  - m_Id: 25709632411394048
    m_Localized: "Witamy w Foodmission!\nTa kr\xF3tka ankieta pomo\u017Ce nam pozna\u0107
      Twoje nawyki \u017Cywieniowe, \u015Bwiadomo\u015B\u0107 w zakresie marnotrawstwa
      \u017Cywno\u015Bci oraz wybory zgodne z zasadami zr\xF3wnowa\u017Conego rozwoju,
      dzi\u0119ki czemu Nutri b\u0119dzie mog\u0142o dostosowa\u0107 rekomendacje
      specjalnie dla Ciebie."
    m_Metadata:
      m_Items: []
  - m_Id: 25709899143962624
    m_Localized: "Ile posi\u0142k\xF3w zawieraj\u0105cych mi\u0119so zazwyczaj spo\u017Cywasz
      w ci\u0105gu tygodnia?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710060687581184
    m_Localized: "Jak cz\u0119sto jesz wo\u0142owin\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710112776642560
    m_Localized: "Jak cz\u0119sto wyrzucasz jedzenie, kt\xF3re nadaje si\u0119 jeszcze
      do spo\u017Cycia?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710126802395136
    m_Localized: "Jak cz\u0119sto spo\u017Cywasz \u017Cywno\u015B\u0107 wysoko przetworzon\u0105,
      tak\u0105 jak pakowane przek\u0105ski, s\u0142odkie napoje, dania gotowe czy
      przetworzone produkty mi\u0119sne?"
    m_Metadata:
      m_Items: []
  - m_Id: 25710140115116032
    m_Localized: "Jak cz\u0119sto korzystasz z pojemnik\xF3w wielokrotnego u\u017Cytku
      lub kupujesz produkty do ponownego nape\u0142niania?"
    m_Metadata:
      m_Items: []
  - m_Id: 25970700069101568
    m_Localized: KATEGORIE
    m_Metadata:
      m_Items: []
  - m_Id: 25971230925381632
    m_Localized: OSTATNIO DODANE
    m_Metadata:
      m_Items: []
  - m_Id: 25972618610860032
    m_Localized: Poprzedni
    m_Metadata:
      m_Items: []
  - m_Id: 25973559573602304
    m_Localized: Strona {0} z {1}
    m_Metadata:
      m_Items: []
  - m_Id: 26077910317129728
    m_Localized: "Wyszukiwanie posi\u0142k\xF3w i przepis\xF3w..."
    m_Metadata:
      m_Items: []
  - m_Id: 26079908550664192
    m_Localized: "Co jad\u0142e\u015B na {0}?"
    m_Metadata:
      m_Items: []
  - m_Id: 26082273878073344
    m_Localized: "Nie zarejestrowano \u017Cadnych ostatnich posi\u0142k\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 26082769774829568
    m_Localized: "Za\u0142aduj poprzedni posi\u0142ek lub przepis"
    m_Metadata:
      m_Items: []
  - m_Id: 26082930148237312
    m_Localized: Anuluj wyszukiwanie
    m_Metadata:
      m_Items: []
  - m_Id: 26083312333217792
    m_Localized: "Sk\u0142adniki \u201E{0}\u201D uleg\u0142y zmianie. Czy chcesz
      zaktualizowa\u0107 istniej\u0105cy profil, czy zapisa\u0107 go jako nowy?"
    m_Metadata:
      m_Items: []
  - m_Id: 26083867323523072
    m_Localized: "Zmodyfikowano ustawienie wst\u0119pne."
    m_Metadata:
      m_Items: []
  - m_Id: 26084472809054208
    m_Localized: Zapisz jako nowy
    m_Metadata:
      m_Items: []
  - m_Id: 26084697950904320
    m_Localized: "Nazwa ustawienia wst\u0119pnego"
    m_Metadata:
      m_Items: []
  - m_Id: 26085108048977920
    m_Localized: "Zapisz jako nowe ustawienie wst\u0119pne"
    m_Metadata:
      m_Items: []
  - m_Id: 26085312869425152
    m_Localized: "Wprowad\u017A nazw\u0119 nowego ustawienia wst\u0119pnego"
    m_Metadata:
      m_Items: []
  - m_Id: 26085540183924736
    m_Localized: Przepis
    m_Metadata:
      m_Items: []
  - m_Id: 26299707348213760
    m_Localized: "Wybierz rodzaj posi\u0142ku"
    m_Metadata:
      m_Items: []
  - m_Id: 26305215656353792
    m_Localized: "Jaki rodzaj posi\u0142ku chcesz zarejestrowa\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 26305695111438336
    m_Localized: "Sk\u0105d pochodzi\u0142o twoje danie?"
    m_Metadata:
      m_Items: []
  - m_Id: 26308100574142464
    m_Localized: Wyszukaj dania i przepisy...
    m_Metadata:
      m_Items: []
  - m_Id: 26308484147437568
    m_Localized: "Wyszukaj produkty lub wybierz kategori\u0119..."
    m_Metadata:
      m_Items: []
  - m_Id: 26309328330809344
    m_Localized: "Dzisiejsze posi\u0142ki"
    m_Metadata:
      m_Items: []
  - m_Id: 26318181705441280
    m_Localized: "Prosz\u0119 doda\u0107 co najmniej jeden produkt spo\u017Cywczy"
