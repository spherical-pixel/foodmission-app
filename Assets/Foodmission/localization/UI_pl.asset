      m_Items: []
  - m_Id: 18113535941795840
    m_Localized: "\u0141adowanie zasob\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 18114763199340544
    m_Localized: Sprawdzanie uwierzytelniania
    m_Metadata:
      m_Items: []
  - m_Id: 18417184911908864
    m_Localized: "Baw si\u0119, ucz i jedz lepiej: razem nap\u0119dzamy zmian\u0119."
