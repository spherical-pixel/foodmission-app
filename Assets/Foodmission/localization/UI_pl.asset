    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000025
    m_Localized: "Nie zarejestrowano jeszcze \u017Cadnych odpad\xF3w. Naci\u015Bnij
      +, aby zarejestrowa\u0107 odpady."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000026
    m_Localized: "Dziennik posi\u0142k\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000027
    m_Localized: "Nie zarejestrowano jeszcze \u017Cadnych posi\u0142k\xF3w. Naci\u015Bnij
