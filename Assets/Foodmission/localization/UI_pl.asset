    m_Metadata:
      m_Items: []
  - m_Id: 7590950985730
    m_Localized: "Przek\u0105ska"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985731
    m_Localized: Napoje
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985732
    m_Localized: Inne
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985733
    m_Localized: "Wygas\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985734
    m_Localized: Rozpieszczony
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985735
    m_Localized: Przegotowane
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985736
    m_Localized: Niechciane
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985737
    m_Localized: "Porcja jest za du\u017Ca"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985738
    m_Localized: Inne
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985739
    m_Localized: Automatyczny
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985740
    m_Localized: "Instrukcja obs\u0142ugi"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985747
    m_Localized: "Lod\xF3wka"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985748
    m_Localized: "Zamra\u017Carka"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985749
    m_Localized: "P\xF3\u0142ka w spi\u017Carni"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985750
    m_Localized: Blat
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985751
    m_Localized: Szafka
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985752
    m_Localized: "\u0141adowanie lokalizacji..."
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985753
    m_Localized: "\u0141adowanie interfejsu u\u017Cytkownika..."
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985754
    m_Localized: Wyszukaj...
    m_Metadata:
      m_Items: []
  - m_Id: 7590950985755
    m_Localized: "Dodaj pozycj\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986000
    m_Localized: Grupy
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986001
    m_Localized: "Nie ma jeszcze \u017Cadnych grup."
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986002
    m_Localized: "Utw\xF3rz grup\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986003
    m_Localized: "Do\u0142\u0105cz do grupy"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986004
    m_Localized: Nazwa grupy
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986005
    m_Localized: Opis (opcjonalnie)
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986006
    m_Localized: "Utw\xF3rz grup\u0119 lub do\u0142\u0105cz do niej"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986007
    m_Localized: Kod zaproszeniowy
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986008
    m_Localized: "\u0141\u0105czenie si\u0119..."
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986009
    m_Localized: "Cz\u0142onkowie"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986010
    m_Localized: Kod zaproszeniowy
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986011
    m_Localized: Skopiuj kod
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986012
    m_Localized: "Odtw\xF3rz"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986013
    m_Localized: "Opu\u015B\u0107 grup\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986014
    m_Localized: "Usu\u0144 grup\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986015
    m_Localized: "Dodaj cz\u0142onka"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986016
    m_Localized: "Zosta\u0144 administratorem"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986017
    m_Localized: "Czy na pewno chcesz opu\u015Bci\u0107 t\u0119 grup\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986018
    m_Localized: "Czy na pewno chcesz usun\u0105\u0107 t\u0119 grup\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986019
    m_Localized: Admin
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986020
    m_Localized: Wirtualny
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986021
    m_Localized: "Imi\u0119 i nazwisko"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986022
    m_Localized: Rok urodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986023
    m_Localized: "Dodaj wirtualnego cz\u0142onka"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986024
    m_Localized: Grupy
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986025
    m_Localized: "Za\u0142\xF3\u017C grup\u0119 lub do\u0142\u0105cz do niej, aby
      dzieli\u0107 si\u0119 listami zakup\xF3w i post\u0119pami z rodzin\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986026
    m_Localized: "Utw\xF3rz now\u0105 grup\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986027
    m_Localized: "Do\u0142\u0105cz do istniej\u0105cej grupy"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986028
    m_Localized: "Na razie pomi\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986029
    m_Localized: Grupa utworzona!
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986030
    m_Localized: "Do\u0142\u0105czy\u0142em do grupy!"
    m_Metadata:
      m_Items: []
