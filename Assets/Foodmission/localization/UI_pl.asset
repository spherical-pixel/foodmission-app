    m_Localized: Wersja aplikacji
    m_Metadata:
      m_Items: []
  - m_Id: 6798978623463424
    m_Localized: "Zmie\u0144 \u015Brodowisko"
    m_Metadata:
      m_Items: []
  - m_Id: 6800027757305856
    m_Localized: "Zmiana \u015Brodowiska spowoduje wylogowanie. Czy na pewno chcesz
      to zrobi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 14120235996012544
    m_Localized: "Z spi\u017Carni"
    m_Metadata:
      m_Items: []
  - m_Id: 14120384667312128
    m_Localized: "Jedli\u015Bmy na mie\u015Bcie"
    m_Metadata:
      m_Items: []
  - m_Id: 20518970774773760
    m_Localized: Co nowego w wersji v{0}
