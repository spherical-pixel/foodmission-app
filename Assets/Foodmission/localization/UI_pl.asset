    m_Metadata:
      m_Items: []
  - m_Id: 18113535941795840
    m_Localized: "\u0141adowanie zasob\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 18114763199340544
    m_Localized: Sprawdzanie uwierzytelnienia
    m_Metadata:
      m_Items: []
  - m_Id: 18417184911908864
    m_Localized: "Baw si\u0119, ucz si\u0119 i jedz zdrowiej: razem nap\u0119dzamy
      zmian\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 18417602513592320
    m_Localized: "Nazwa u\u017Cytkownika"
    m_Metadata:
      m_Items: []
  - m_Id: 18417848396275712
    m_Localized: "Twoja nazwa u\u017Cytkownika"
    m_Metadata:
      m_Items: []
  - m_Id: 18418052671463424
    m_Localized: "Has\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 18418114709413888
    m_Localized: "Twoje has\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 22812687661522944
    m_Localized: E-mail
    m_Metadata:
      m_Items: []
  - m_Id: 22812856394178560
    m_Localized: "Tw\xF3j adres e-mail"
    m_Metadata:
      m_Items: []
  - m_Id: 22819676332482560
    m_Localized: Kraj zamieszkania
    m_Metadata:
      m_Items: []
  - m_Id: 22819860558897152
    m_Localized: Wybierz kraj zamieszkania
    m_Metadata:
      m_Items: []
  - m_Id: 22820314747494400
    m_Localized: Region
    m_Metadata:
      m_Items: []
  - m_Id: 22820425670057984
    m_Localized: "Wybierz sw\xF3j region"
    m_Metadata:
      m_Items: []
  - m_Id: 22820717341958144
    m_Localized: Kod pocztowy
    m_Metadata:
      m_Items: []
  - m_Id: 25345767223844864
    m_Localized: "Wyra\u017Cam zgod\u0119 na <b>Warunki korzystania z serwisu</b>
      oraz <b>Polityk\u0119 prywatno\u015Bci</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 25351728189661184
    m_Localized: Warunki korzystania z serwisu
    m_Metadata:
      m_Items: []
  - m_Id: 25353163560181760
    m_Localized: Zaakceptuj
    m_Metadata:
      m_Items: []
  - m_Id: 25353325686808576
    m_Localized: Anuluj
    m_Metadata:
      m_Items: []
  - m_Id: 25353803774550016
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 25354482861727744
    m_Localized: "B\u0142\u0105d"
    m_Metadata:
      m_Items: []
  - m_Id: 25354925167861760
    m_Localized: "Weryfikacja p\xF3l nie powiod\u0142a si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 25355658118291456
    m_Localized: "To pole nie mo\u017Ce by\u0107 puste."
    m_Metadata:
      m_Items: []
  - m_Id: 25358434474909696
    m_Localized: "Wprowad\u017A poprawny adres e-mail."
    m_Metadata:
      m_Items: []
  - m_Id: 25358751560097792
    m_Localized: "Has\u0142o musi sk\u0142ada\u0107 si\u0119 z co najmniej 6 znak\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284416
    m_Localized: "Nieprawid\u0142owy rok urodzenia."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284417
    m_Localized: "Aby korzysta\u0107 z platformy, musisz mie\u0107 uko\u0144czone
      18 lat."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284418
    m_Localized: "Nale\u017Cy wybra\u0107 kraj."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284419
    m_Localized: "Nale\u017Cy wybra\u0107 region."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284420
    m_Localized: "Nieprawid\u0142owy format kodu pocztowego."
    m_Metadata:
      m_Items: []
  - m_Id: 25360689668284421
    m_Localized: "Aby kontynuowa\u0107, musisz zaakceptowa\u0107 Warunki korzystania
      z serwisu."
    m_Metadata:
      m_Items: []
  - m_Id: 25367919163596800
    m_Localized: "Zaloguj si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 25368981371084800
    m_Localized: "Nie pami\u0119tasz has\u0142a?"
    m_Metadata:
      m_Items: []
  - m_Id: 25369431499595776
    m_Localized: "Nie masz konta? Zarejestruj si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 25394900353671168
    m_Localized: "Zresetuj has\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 25395075277119488
    m_Localized: "Wpisz sw\xF3j adres e-mail, a wy\u015Blemy Ci link umo\u017Cliwiaj\u0105cy
      zresetowanie has\u0142a."
    m_Metadata:
      m_Items: []
  - m_Id: 25395779614007296
    m_Localized: Kontynuuj
    m_Metadata:
      m_Items: []
  - m_Id: 25395959562231808
    m_Localized: "Powr\xF3t"
    m_Metadata:
      m_Items: []
  - m_Id: 27512489452232704
    m_Localized: "\u0141adowanie {global.PET_NAME}"
    m_Metadata:
      m_Items:
      - rid: 4008881209995690411
  - m_Id: 27515040654417920
    m_Localized: Foody
    m_Metadata:
      m_Items: []
  - m_Id: 28204088708554752
    m_Localized: Powiadomienia
    m_Metadata:
      m_Items: []
  - m_Id: 35547983100502016
    m_Localized: "Razem po\u0142\u0105czymy Twoj\u0105 kuchni\u0119 z trosk\u0105
      o nasz\u0105 planet\u0119.\n\nGotuj, ucz si\u0119, dziel si\u0119 i rozwijaj
      si\u0119 ka\u017Cdego dnia.\n\nGotowy, by zacz\u0105\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 35549851969118208
    m_Localized: "Stw\xF3rz swoj\u0105 posta\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 35549934412357632
    m_Localized: "Uzupe\u0142nij sw\xF3j profil"
    m_Metadata:
      m_Items: []
  - m_Id: 35550076637011968
    m_Localized: "Wejd\u017A do aplikacji"
    m_Metadata:
      m_Items: []
  - m_Id: 38372841320603648
    m_Localized: "Nieprawid\u0142owa nazwa u\u017Cytkownika lub has\u0142o"
    m_Metadata:
      m_Items: []
  - m_Id: 38373129888718848
    m_Localized: "Nie znaleziono us\u0142ugi"
    m_Metadata:
      m_Items: []
  - m_Id: 38373203972710400
    m_Localized: "Nieprawid\u0142owe \u017C\u0105danie"
    m_Metadata:
      m_Items: []
  - m_Id: 38373263087230976
    m_Localized: "B\u0142\u0105d serwera"
    m_Metadata:
      m_Items: []
  - m_Id: 38373338052026368
    m_Localized: "B\u0142\u0105d po\u0142\u0105czenia: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 38380494998462464
    m_Localized: "Nieprawid\u0142owa odpowied\u017A serwera"
    m_Metadata:
      m_Items: []
  - m_Id: 38381013338939392
    m_Localized: "Nieoczekiwany b\u0142\u0105d: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 38381665582571520
    m_Localized: "Nieprawid\u0142owe dane rejestracyjne"
    m_Metadata:
      m_Items: []
  - m_Id: 38382047729803264
    m_Localized: "U\u017Cytkownik ju\u017C istnieje"
    m_Metadata:
      m_Items: []
  - m_Id: 38465117124288512
    m_Localized: Uwaga!
    m_Metadata:
      m_Items: []
  - m_Id: 38465306467753984
    m_Localized: "Ta czynno\u015B\u0107 spowoduje trwa\u0142e usuni\u0119cie wszystkich
      Twoich danych z platformy.\n\nCzy na pewno chcesz to zrobi\u0107?"
    m_Metadata:
      m_Items: []
