    m_Metadata:
      m_Items: []
  - m_Id: 7835105786585088
    m_Localized: "Produkty spo\u017Cywcze bez nazwy handlowej niedost\u0119pne"
    m_Metadata:
      m_Items: []
  - m_Id: 7835562022002688
    m_Localized: "Ten produkt spo\u017Cywczy nie jest dost\u0119pny w bazie danych
      zaplecza dla tego \u015Brodowiska."
