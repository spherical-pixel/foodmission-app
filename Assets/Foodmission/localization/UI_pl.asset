      m_Items: []
  - m_Id: 41000000000000029
    m_Localized: "Nie ma jeszcze \u017Cadnych list zakup\xF3w. Kliknij \u201ENowa
      lista\u201D, aby j\u0105 utworzy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000030
    m_Localized: Nowa lista
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000031
    m_Localized: "Lista zakup\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000032
    m_Localized: Gotowe
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000033
    m_Localized: "Jeszcze nie ma \u017Cadnych produkt\xF3w. Dodaj kilka produkt\xF3w."
