    m_Localized: "Z spi\u017Carni"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000010
    m_Localized: "Zjedzone na mie\u015Bcie"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000011
    m_Localized: "Wybierz produkty, kt\xF3re chcesz odj\u0105\u0107 z zapas\xF3w"
