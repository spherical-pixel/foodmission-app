    m_Localized: "Przenie\u015B do odpad\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 41000000000000023
    m_Localized: "Twoja spi\u017Carnia jest pusta. Naci\u015Bnij +, aby doda\u0107
