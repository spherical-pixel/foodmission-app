    m_Localized: "Utw\xF3rz grup\u0119 lub do\u0142\u0105cz do niej, aby dzieli\u0107
      si\u0119 listami zakup\xF3w i post\u0119pami z rodzin\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986026
    m_Localized: "Utw\xF3rz now\u0105 grup\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986027
    m_Localized: "Do\u0142\u0105cz do istniej\u0105cej grupy"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986028
    m_Localized: "Pomi\u0144 na razie"
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986029
    m_Localized: Grupa utworzona!
    m_Metadata:
      m_Items: []
  - m_Id: 7590950986030
    m_Localized: "Do\u0142\u0105czy\u0142em do grupy!"
    m_Metadata:
      m_Items: []
  - m_Id: 319685458386944
    m_Localized: "\u0141adowanie awatara"
    m_Metadata:
      m_Items: []
  - m_Id: 346294877937664
    m_Localized: "B\u0141\u0104D"
    m_Metadata:
      m_Items: []
  - m_Id: 1352600405401600
    m_Localized: Sprawdzanie aktualizacji...
    m_Metadata:
      m_Items: []
  - m_Id: 1674160731316224
    m_Localized: "Aktualizacja dost\u0119pna"
    m_Metadata:
      m_Items: []
  - m_Id: 1674295611744256
    m_Localized: "Dost\u0119pna jest nowa wersja."
    m_Metadata:
      m_Items: []
  - m_Id: 1674465741103104
    m_Localized: 'Informacje o wydaniu:'
    m_Metadata:
      m_Items: []
  - m_Id: 1675915250622464
    m_Localized: Aktualizacja
    m_Metadata:
      m_Items: []
  - m_Id: 1675915254816768
    m_Localized: "P\xF3\u017Aniej"
    m_Metadata:
      m_Items: []
  - m_Id: 3882568704319488
    m_Localized: "\U0001F4DD Lista zakup\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 6145026047336448
    m_Localized: Napoje alkoholowe
    m_Metadata:
      m_Items: []
  - m_Id: 6145026051530752
    m_Localized: Chleb
    m_Metadata:
      m_Items: []
  - m_Id: 6145026051530753
    m_Localized: "Produkty zbo\u017Cowe i rodzaje m\u0105ki"
    m_Metadata:
      m_Items: []
  - m_Id: 6145026051530754
    m_Localized: Ser
    m_Metadata:
      m_Items: []
  - m_Id: 6145026051530755
